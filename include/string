 * tail OVL1 0x331ED0-0x333117). Each takes its text and size in ONE short-first test, as compare does;
 * a basic_string's text and size likewise, handed on as a tail call. The (s, pos) forms take strlen(s) */
template <class charT, class traits, class Allocator>
typename basic_string<charT, traits, Allocator>::size_type
basic_string<charT, traits, Allocator>::find_first_of(const basic_string &str, size_type pos) const
{
    const charT *p;
    size_type n;

    if (!str.is_long()) {
        p = str.s_.data_;
        n = (unsigned char)str.s_.size_;
    } else {
        p = (const charT *)str.w_[2];
        n = str.w_[1];
    }
    return find_first_of(p, pos, n);
}

template <class charT, class traits, class Allocator>
typename basic_string<charT, traits, Allocator>::size_type
basic_string<charT, traits, Allocator>::find_first_of(const charT *s, size_type pos, size_type n) const
{
    const charT *data;
    size_type sz;

    if (!is_long()) {
        data = s_.data_;
        sz = (unsigned char)s_.size_;
    } else {
        data = (const charT *)w_[2];
        sz = w_[1];
    }
    if (pos < sz && n != 0) {
        const charT *e = data + sz;

        for (const charT *p = data + pos; p < e; ++p) {
            const charT *q = s;

            for (size_type i = 0; i < n; ++i, ++q)
                if (*p == *q)
                    return p - data;
