/* <stack>: MSL's std::stack, the container adapter -- just its forwarding members over a deque (the
 * rdr lane's CRdrEditor holds one: its destructor, 0x333A20, tears the deque's blocks down as
 * __deque_buf's out-of-class destructor called with 0). A reconstruction, not MSL. */

#ifndef _MSL_STACK
#define _MSL_STACK

#include <deque>

namespace std {

template <class T, class Container = deque<T> >
class stack {
public:
    typedef T value_type;

    /* MSL's: the container copied from a default one (the rdr editor's CRdrEditor(), 0x333AE0: a
     * temporary deque built, copied in and torn down) */
    explicit stack(const Container &x = Container()) : c(x)
    {
        /* a modelling device (no code; the MSL headers round 39): see deque's __chain -- this constructor is parsed before the
         * end-of-unit walk, and only a unit that copies a deque builds one */
        typedef void (*F)(void *);
        F f = &Container::__chain;

        if (0)
            f(0);
    }
    bool empty() const { return c.empty(); }
    unsigned int size() const { return c.size(); }
    value_type &top() { return c.back(); }
    void push(const value_type &x) { c.push_back(x); }
    void pop() { c.pop_back(); }

protected:
    Container c;
};

}

#endif
