/* <vector>: just enough of Metrowerks' MSL C++ std::vector (CodeWarrior PS2 3.0) to give the
 * matched functions their code. A reconstruction, not MSL: the class shapes are SOCOM 1's DWARF
 * (vector : __vector_imp : __vector_deleter, the allocator folded into capacity_'s
 * compressed_pair at 0, size_ at 4, data_ at 8), the member bodies are whatever compiles to the
 * shipped bytes.
 *
 * A vector of pointers is __vector_imp<T *, allocator<T *>, 1> (the flag in the name of SOCOM 1's
 * zdb::CNodeVector base destructor), and every one of them runs on the one implementation,
 * __vector_pod<unsigned int>: SOCOM 1's push_back, reserve and insert of it are the only ones a
 * pointer vector calls, and SOCOM II's CZAnimExVector::Add calls the same two out of line
 * (reserve 0x1EEBA0, insert 0x1FE340 -- the demo's calls, fprintf/abort/new/delete, alike).
 *
 * The iterators are classes, != being !(==): a walk whose whole test is the compare
 * materialises it (LoadZAR, CZAnimSet::Reset), one inside && branches on it
 * (GetDatabaseNode).
 *
 * A vector of pointers makes its iterators out of its base's: begin() and end() are a member
 * that takes __vector_pod's raw pointer by reference and returns the iterator (SOCOM II's
 * 0x1EA8B0: a hidden return, `this`, the pointer's address -- the name __iter is ours), applied
 * to __vector_pod's own begin() and end() (0x1EA8C0 and 0x1EA890, SOCOM 1's begin__/end__ of
 * __vector_pod<Ui> word for word); the base's begin() reads through data(), the reference, and
 * the pointer vector's begin() takes it into a const local before handing it on (where
 * SetDynamicLight inlines begin() one level, it calls the base's begin() and then __iter).
 * CNode::SetNodeEx inlines itself twice and func_00319C90 itself once, and where MW stops
 * inlining their copies call every piece of it out of line -- begin, end, ==, !=, *, both ++,
 * and the iterator's implicit copy constructor (0x313450), which the postfix ++ (the copy, the
 * prefix ++, the copy out: 0x313460) uses. What the depth does to the matched walks:
 *   - a walk's first test (begin against begin + size) stays a compare: MW folded it into a
 *     test of the size when begin() was one level, and every walk held a const_iterator to
 *     stop it (GetLandmarkFarPlane, LoadZAR, CZAnimSet's, FindClones: plain iterators now);
 *   - an iterator initialised from begin() inlines all of it, one assigned from begin() leaves
 *     data() a call (the assignment is a level more): CNode::FindChild's second walks declare
 *     an iterator of their own, and the by-name one keeps &data_ in a register for it;
 *   - back() is the base's, cast (through end() it would be a level taller than
 *     CZAR::GetOpenKey's inlining allows).
 *
 * The inline LEVELS are load-bearing (-inline level=5: a call whose callee's inline tree is at
 * most five high inlines all of it, a taller one only the callee's own body -- and so does a
 * callee whose expanded body passes MW's inline_max_size, 256 units). Counted from the vector
 * down, as refitted at level 5 (the inline-level lane, 2026-10-25; level 4 had them one shallower
 * in the swaps and the pod's destructor):
 *   vector of pointers  constructor 3 (vector, __vector_imp, __vector_pod)
 *                       destructor  4 (three this tests, then the pod's deallocate)
 *                       clear()     3
 *                       swap()      5 (vector, __vector_imp, the pod's member swap, the free swap,
 *                                   std::swap): FreeVector and TrimVector are six
 *   vector of a class   constructor 4 (the capacity member's own constructor)
 *                       destructor  2 inline (~vector, ~__vector_imp), then __vector_deleter's
 *                                   destructor -- out of class, see there: a call where the unit
 *                                   had not instantiated it yet, four levels where it had
 *                       clear()     5 (2 in a unit's own code: the deleter's is out of class)
 *                       swap()      5 (the deleter's member swap, the free swap, the capacity
 *                                   pair's free swap and member swap, std::swap)
 * So `new CZAnimExVector` and its delete inline whole (CZAnimSet::AddAnimEx and Unload), and so
 * does CCompassAnchor's constructor in CCompass::CreateAnchor (five high with its vector<CPnt3D>),
 * and CCharacterType::Create's GetByNameMod with its loop's end(); the out-of-line ~vector<CPnt3D>
 * calls the deleter's destructor, and CZAnimSetSave::Free inlines the pointer vectors' clear() but
 * calls __vector_imp<CPnt3D>::clear().
 * Measured at level 5 over every unit, drafts included, master merged (build/scratch/lvl/): the
 * level-4 fit's matches all hold but SaveNodeStates -- `new CZAnimSetSave`, five high, must be
 * inlined only one level, which no height can do while CreateAnchor and AddAnimEx inline theirs
 * whole: it is the size limit, CZAnimSetSave() expanding to 179 units here against 256 needed
 * (zanim_set.cpp's OPEN) -- and CPnt3D's copy (0x387F90, a level-4 artefact of grid_main.cpp);
 * gained CreateAnchor, CCharacterType::Create, __sinit_compass.cpp, __sinit_game_state.cpp,
 * CCell::GetMidPoint, ~C2D and CVisual's constructor. */

#ifndef _MSL_VECTOR
#define _MSL_VECTOR

#include <algorithm>
#include <iterator>
#include <memory>
#include <msl_utility>
#include <new>
#include <stdio.h>
#include <stdlib.h>

/* MSL's error report with exceptions off: the message to stderr, then abort */
#define __msl_error(str) \
    {                    \
        fprintf(stderr, str); \
        abort();         \
    }

namespace std {

/* the capacity, its own member as SOCOM 1's DWARF has it (a compressed_pair with the allocator):
 * the extra constructor level a vector of a class has and a vector of pointers has not */
template <class Allocator>
class __vector_capacity {
public:
    __vector_capacity() { n_ = 0; }
    operator unsigned int() const { return n_; }
    /* the pair's swap (SOCOM 1's compressed_pair_imp::swap, msl_utility lines 859-860) */
    void swap(__vector_capacity &x) { std::swap(n_, x.n_); }

    unsigned int n_;
};

/* the pair swapped through its member (MSL's free swap of a compressed_pair) */
template <class Allocator>
inline void swap(__vector_capacity<Allocator> &x, __vector_capacity<Allocator> &y)
{
    x.swap(y);
}

template <class T, class Allocator>
class __vector_deleter {
public:
    __vector_deleter() { size_ = 0; data_ = 0; }
    /* clear declared ahead of the destructor: both are defined after the class (see there), and
     * MW emits a unit's out-of-class template members in their declaration order -- clear first
     * wherever both are generated in the same round */
    void clear();
    ~__vector_deleter();
    /* the data pointer by reference (SOCOM 1's DWARF: data() at <vector> line 923, in the class) */
    T *&data() { return data_; }
    static T *allocate(unsigned int n)
    {
        T *p = (T *)operator new(n * sizeof(T));
        if (!p)
            __msl_error("Memory allocation failure");
        return p;
    }
    /* through the free swap below (SOCOM 1's member swap, line 973, calls the free one at 960) */
    void swap(__vector_deleter &x) { std::swap(*this, x); }
    /* an element copied into raw storage: every class-vector construction (insert, reserve, the
     * range init) goes through it, as MSL 3.0's allocator construct does. An element whose copy
     * expands past inline_max_size cuts it to one level, so the placement new and the copy
     * constructor are both called out of line, the new's null test between them -- the image's
     * 0x2FECA0 (OVL1) and 0x51D210 (OVL2), `jr ra; move v0,a1`, called six times by each such
     * insert (LOD, CDesignDlgObj, the turret's) and once by vector<C2DPoly>::reserve (0x361790,
     * byte-exact so); a smaller element inlines both, as the loops always did. The name ours */
    static void construct(T *p, const T &x) { new (p) T(x); }

    __vector_capacity<Allocator> capacity_;
    unsigned int size_;
    T *data_;
};

/* the storage traded (SOCOM 1's free swap, lines 960-967: the this test, the capacity pair through
 * its own swap -- SOCOM 1's copy calls swap<Ui> there out of line -- then data and size): the
 * deleter's swap is five high (member, this, the pair's free swap, its member, std::swap), so a
 * class vector's FreeVector, six, is inlined one level at -inline level=5 and calls its pieces
 * (CGameStateChangeCmd::DestroyPool, ~MapCompass, CVehicleRdr::Close) */
template <class T, class Allocator>
inline void swap(__vector_deleter<T, Allocator> &x, __vector_deleter<T, Allocator> &y)
{
    if (&x != &y) {
        swap(x.capacity_, y.capacity_);
        std::swap(x.data_, y.data_);
        std::swap(x.size_, y.size_);
    }
}

/* The deleter's clear and destructor, out of class and not inline, as MSL 3.0.1 has them after the
 * class body (SOCOM 1's DWARF: the constructor at <vector> line 916 and data() at 923 inside the
 * class, the destructor at 939, clear at 949 and swap at 973 after it). SOCOM 1's line table gives
 * their shapes: the destructor is `clear();` (line 940 holds the whole destroy loop and the count's
 * store, one inlined call) and then the storage freed (941-942); clear walks the elements down
 * itself (950 the end, 951 the test, 952 the destroy) and zeroes the count.
 *
 * Such a template member is emitted in each unit's template tail and is never inlined into the
 * unit's own functions. In the tail, MW generates the members in rounds -- first those the unit's
 * own functions (and their inline copies) use, then those the first round's code uses, and so on --
 * each round in declaration order, the class templates last declared first (probes build/msl/probe/
 * o1-o4 of the MSL lane); and a tail function inlines another only if that one was generated
 * before it. So (measured over every hand-written unit, 2026-10-25):
 *   - where the unit's own code clears the vector (vector::clear inlines down to a call of this
 *     clear: CZAnimSetSave::Free 0x26D2F0, ~C2DTriFan 0x3619A0, DestroyPool's copy 0x2CF5B0), clear
 *     is generated in the first round ahead of the destructor, which inlines it (zanim_set.cpp's
 *     0x26D2F0/0x26D300, game_state.cpp's 0x2CF8F0/0x2CF900, the nav_package and CTarget pairs);
 *   - where only the destructor uses it, clear comes a round later and the destructor calls it
 *     (seal_dyn.cpp's 0x59D640 -> 0x59D6B0, CSndSequenceEntry's 0x34A5A0 -> 0x34A610, ai_map.cpp's);
 *   - an insert or reserve whose temporary's destructor was generated before it inlines that
 *     destructor -- and calls clear inside it when clear was not (CSndSequenceEntry's insert
 *     0x34A0D0 calls 0x34A610), while one generated before the destructor calls it with -1
 *     (seal_dyn.cpp's insert and reserve);
 *   - an implicit destructor chain over a class vector in the unit's own code inlines ~vector and
 *     ~__vector_imp and calls the destructor (~CSndSequence 0x34A020, ~CEntity, CCompass::
 *     DeleteAnchor -- SOCOM 1's ~CEntity too).
 * clear's loop is written in its own body: through a static destroy() helper, the destructor
 * inlined clear's body and called the helper out of line (0x80 bytes against the target's 0x68).
 * MW 3.0 deletes the loop for a trivially destructible T (SOCOM 1 kept an empty one); for C2DPoly
 * (a virtual destructor) it calls each through the table, the data pointer held in a saved
 * register (0x3619A0). */
template <class T, class Allocator>
void __vector_deleter<T, Allocator>::clear()
{
    T *first = data_;
    T *last = data_ + size_;

    while (first < last)
        (--last)->~T();
    size_ = 0;
}

template <class T, class Allocator>
__vector_deleter<T, Allocator>::~__vector_deleter()
{
    clear();
    if (data_)
        operator delete(data_);
}

template <class T, class Allocator>
class __vector_pod {
public:
    /* the three words cleared, the zero held in a local first: the same three stores, but more
     * inline units than three plain ones (the MSL headers' round 4) -- SOCOM II's pointer vector
     * constructor is fatter than its level shows (SOCOM 1's pod builds its capacity as a compressed
     * pair), enough to push CScriptArchive's constructor (four pointer vectors, the callback
     * list's, a ZAR) past inline_max_size, so bone_init.cpp's initialiser inlines it one level and
     * calls the members' constructors out of line (0x3FFCE0), while CHUD's, CCell's and CVisual's
     * constructors and __sinit_compass.cpp still inline theirs whole. A level more instead (the
     * stores in a helper) cuts those four too */
    __vector_pod()
    {
        unsigned int z = 0;

        capacity_ = z;
        size_ = z;
        data_ = 0;
    }
    /* n copies of value: the words zeroed, then init (CVisual's m_lodMesh(0): init called out of line) */
    __vector_pod(unsigned int n, const T &value) { capacity_ = 0; size_ = 0; data_ = 0; init(n, value); }
    __vector_pod(const __vector_pod &x);
    /* the storage given back through the allocator (CW 2.5's MSL: the pod's destructor calls
     * alloc() and deallocate): a pointer vector's destructor is four high, one more than its
     * constructor, so CVisual's destructor (vis_main.cpp) inlines CDynTexList's implicit one only
     * one level and calls ~CTexList and ~CTexPalList, where its constructor builds them whole */
    ~__vector_pod()
    {
        if (data_)
            deallocate(data_);
    }
    static void deallocate(T *p) { operator delete(p); }
    void clear() { size_ = 0; }
    /* the storage traded with another's through the free swap below, as SOCOM 1's deleter swaps
     * (its member swap at <vector> line 973 calls the free one at 960): a pointer vector's swap is
     * five high, so FreeVector (zsys.h) and TrimVector (node_world.cpp), six, are inlined one level
     * at -inline level=5 and call their pieces, as the target does. Measured at level 5 over every
     * hand-written unit: the 32 FreeVector/TrimVector functions level 5 lost come back (CFlashFXVector::
     * Reset, CCompass::Close, CWorld's three, CSndJukebox::Cleanup, Headset::Flush and their copies),
     * nothing else moves */
    void swap(__vector_pod &x) { std::swap(*this, x); }
    /* references to the fields (SOCOM 1 keeps out-of-line copies: data() is this + 8, cap() this) */
    T *&data() { return data_; }
    unsigned int &cap() { return capacity_; }
    /* the raw iterators a vector of pointers makes its own from, both through data()'s reference:
     * end() so keeps a local vector's &data_ in its register across a call (CGrid::Destroy,
     * CWorld::GenerateLandmarkList and DeleteChildren, CAssetLib::AddPalette -- the zdb world's
     * round 6 measurement), the extra level paid back by the pointer vector's end() taking it into
     * a const local as begin() does (the MSL headers' round 4) */
    T *begin() { return data(); }
    T *end() { return data() + size_; }
    T &back() { return *(end() - 1); }
    unsigned int size() const { return size_; }
    static unsigned int max_size() { return (unsigned int)-1 / sizeof(T); }
    static T *allocate(unsigned int n)
    {
        T *p = (T *)operator new(n * sizeof(T));
        if (!p)
            __msl_error("Memory allocation failure");
        return p;
    }
    void reserve(unsigned int n);
    void insert(T *position, unsigned int n, const T &x);
    T *erase(T *first, T *last);
    /* one element erased (out of class: SOCOM 1's erase__...FPUi, SOCOM II's OVL1 0x28F220) */
    T *erase(T *position);
    T &at(unsigned int n);
    template <class InputIterator>
    void init(InputIterator first, InputIterator last, forward_iterator_tag);
    /* n copies of value (SOCOM 1's init__...FUiRCUi, the same 0xE8 bytes as SOCOM II's 0x3C45B0) */
    void init(unsigned int n, const T &value);
    /* grown by copies of c through insert, or cut through erase (out of class: CVisual::Init calls
     * OVL1's copy, 0x28B0E0; MAIN's is 0x18B050) */
    void resize(unsigned int sz, const T &c);
    /* the end read through data()'s reference: across two pushes the target keeps &size_ in the
     * lower saved register and &data_ in the higher (CSndJukebox::LoadMusicLists 0x349490,
     * byte-exact so; nothing else moved over the hand-written units, 2026-10-25, but valve_list.cpp
     * now emits four list-iterator copies out of line from a function that does not match yet) */
    void push_back(const T &x) { insert(data() + size_, 1, x); }
public:
    unsigned int capacity_;
    unsigned int size_;
    T *data_;
};

/* the storage traded: capacity, data, size, each through std::swap (SOCOM 1's free swap of the
 * deleter, lines 960-967: the this test, then the three fields in that order) */
template <class T, class Allocator>
inline void swap(__vector_pod<T, Allocator> &x, __vector_pod<T, Allocator> &y)
{
    if (&x != &y) {
        std::swap(x.capacity_, y.capacity_);
        std::swap(x.data_, y.data_);
        std::swap(x.size_, y.size_);
    }
}

/* what every vector shows its users: the iterators and accessors over its storage (a macro, so
 * that neither kind of vector carries a class of its own for them) */
/* the iterator class alone (the scalar vectors take it without the rest of the access, whose
 * element reads go through data_ where theirs go through data()'s reference) */
#define __MSL_VECTOR_ITERATOR(ELEMENT)                                                            \
    typedef ELEMENT elem_t;                                                                     \
    class iterator {                                                                            \
    public:                                                                                     \
        iterator() {}                                                                           \
        iterator(elem_t *p) : m_p(p) {}                                                         \
        bool operator==(const iterator &o) const { return m_p == o.m_p; }                       \
        bool operator!=(const iterator &o) const { return !(*this == o); }                      \
        iterator &operator++() { ++m_p; return *this; }                                         \
        iterator operator++(int) { iterator t(*this); ++*this; return t; }                      \
        iterator operator-(int n) const { return iterator(m_p - n); }                           \
        elem_t &operator*() const { return *m_p; }                                              \
                                                                                                \
        elem_t *m_p;                                                                            \
    };

#define __MSL_VECTOR_ACCESS(ELEMENT)                                                              \
public:                                                                                         \
    __MSL_VECTOR_ITERATOR(ELEMENT)                                                              \
                                                                                                \
    class const_iterator {                                                                      \
    public:                                                                                     \
        const_iterator(const elem_t *p) : m_p(p) {}                                             \
        const_iterator(const iterator &i) : m_p(i.m_p) {}                                       \
        bool operator==(const const_iterator &o) const { return m_p == o.m_p; }                 \
        bool operator!=(const const_iterator &o) const { return !(*this == o); }                \
        const_iterator &operator++() { ++m_p; return *this; }                                   \
        const elem_t &operator*() const { return *m_p; }                                        \
                                                                                                \
        const elem_t *m_p;                                                                      \
    };                                                                                          \
                                                                                                \
    unsigned int size() const { return this->size_; }                                           \
    unsigned int capacity() const { return this->capacity_; }                                   \
    bool empty() const { return this->size_ == 0; }                                             \
    elem_t &operator[](unsigned int n) { return ((elem_t *)this->data_)[n]; }                   \
    /* the const read (the AI lane: CAiMap::GetCell's scanline and layer, OVL2 0x512100 and    \
     * 0x5120B0 -- the non-const scanline [] is 0x5176E0, another copy) */                      \
    const elem_t &operator[](unsigned int n) const { return ((const elem_t *)this->data_)[n]; } \
    void pop_back() { this->size_--; }

template <class T, class Allocator, bool IsPOD>
class __vector_imp : public __vector_deleter<T, Allocator> {
    __MSL_VECTOR_ACCESS(T)
    /* begin(), end() and push_back read the data pointer through the deleter's data() reference:
     * CAiMap::read_scanlines (0x51AEF0) keeps &data_ in a saved register across its read and its
     * first end() shares begin's load, CharacterDynamics::Load across its five push_backs; every
     * other hand-written unit compiles the same either way (measured 2026-10-25) */
    iterator begin() { T *const p = this->data(); return iterator(p); }
    iterator end() { return iterator(this->data() + this->size_); }
    T &back() { return *(end() - 1); }
    void clear() { __vector_deleter<T, Allocator>::clear(); }
    static unsigned int max_size() { return (unsigned int)-1 / sizeof(T); }
    T &at(unsigned int n);
    void reserve(unsigned int n);
    void insert(T *position, unsigned int n, const T &x);
    void push_back(const T &x) { insert(this->data() + this->size_, 1, x); }
    /* the range erased: out of line over raw pointers (SOCOM 1's erase__...FP7CTargetP7CTarget,
     * SOCOM II's 0x2A19C0), the iterators' copies handed to it by an inline wrapper (CTargetList::
     * RemoveTarget) */
    T *erase(T *first, T *last);
    iterator erase(iterator first, iterator last) { return iterator(erase(first.m_p, last.m_p)); }
    /* one element erased, the tail moved down by assignment: out of line over a raw pointer, the
     * iterator's copy handed to it by an inline wrapper, as the range's (the online lane's
     * CAcctDB::Delete: the iterator copied bitwise into the wrapper's parameter, its word passed
     * to the instance 0x2FE230, which hands the position back in v0; the AI lane's map links:
     * 0x532000 and its wrapper 0x530AA0, CAiMap::SetCellLink's) */
    T *erase(T *position);
    iterator erase(iterator position) { return iterator(erase(position.m_p)); }
    /* grown by default-built elements or cut (out of class; declared after insert and erase) */
    void resize(unsigned int n);

    __vector_imp() {}
    /* a copy: the deleter's words zeroed (the capacity's, the size's, the data's, in that order),
     * then the other's elements copied in through the range init (out of class, called: the UI
     * lane's vector<ActionItem> copy 0x37E190, the particle sequences' 0x328D90-0x328E40) */
    __vector_imp(const __vector_imp &x) { init((const T *)x.data_, (const T *)x.data_ + x.size_, forward_iterator_tag()); }
    template <class InputIterator>
    void init(InputIterator first, InputIterator last, forward_iterator_tag);
};

template <class T, class Allocator>
class __vector_imp<T *, Allocator, true> : public __vector_pod<unsigned int, allocator<unsigned int> > {
    typedef __vector_pod<unsigned int, allocator<unsigned int> > __base;
    __MSL_VECTOR_ACCESS(T *)
    __vector_imp() {}
    __vector_imp(unsigned int n, T *const &value) : __base(n, (const unsigned int &)value) {}
    iterator __iter(unsigned int *const &p) { return iterator((elem_t *)p); }
    /* the base's pointer held in a const local first: begin() is three high so (SetDynamic and
     * SetUseParentBBoxTree assign it to a declared iterator and inline it whole in their outer
     * copies), while data()'s reference survives for CNode::FindChild by name to keep &data_ in a
     * register. Passed straight to __iter, the call would sit a level deeper; a plain local
     * swaps two of SetDynamic's registers */
    iterator begin()
    {
        unsigned int *const p = __base::begin();

        return __iter(p);
    }
    /* the base's end held in a const local first, as begin() holds its pointer: with the base's
     * end() reading through data(), passed straight to __iter it would sit a level too deep for
     * CCharacterType::Create's inlined GetByNameMod, while find_node still calls the base's end()
     * out of line as its target does (measured over every hand-written unit, the MSL headers'
     * round 4) */
    iterator end()
    {
        unsigned int *const p = __base::end();

        return __iter(p);
    }
    /* the base's, cast: through end() it would be a level taller (CZAR::GetOpenKey inlines it) */
    T *&back() { return (T *&)__base::back(); }
    iterator erase(iterator first, iterator last)
    {
        return __iter(__base::erase((unsigned int *)first.m_p, (unsigned int *)last.m_p));
    }
    /* one element erased: the iterator taken by value, the pod's single erase called (the UI lane:
     * ~CRadioStripSpec's walk) */
    iterator erase(iterator position) { return __iter(__base::erase((unsigned int *)position.m_p)); }
    void clear() { __vector_pod<unsigned int, allocator<unsigned int> >::clear(); }
    void swap(__vector_imp &x) { __base::swap(x); }
    T *&at(unsigned int n)
    {
        return (T *&)__vector_pod<unsigned int, allocator<unsigned int> >::at(n);
    }
    void push_back(T *const &x)
    {
        __vector_pod<unsigned int, allocator<unsigned int> >::push_back((const unsigned int &)x);
    }
};

/* A vector of a 4-byte scalar (float, int, unsigned int) runs on __vector_pod<unsigned int> too,
 * as the pointer vectors do: SOCOM 1's CSndGroup reads its weights through that data() and SOCOM
 * II's LoadCSndGroup pushes them with its insert (0x1FE340), CSnd's reverb tables likewise; the
 * destructor is three this-tested levels (0x348270), no size cleared, and clear() is the store.
 * An element is read through data()'s reference. Their clear() and swap() are the pointer
 * vectors' two-level wrappers too: FreeVector of a vector<float> or vector<int> calls all four
 * pieces out of line, as of a pointer vector (CSndJukebox::Cleanup's weights, 0x349920-0x349940;
 * the headset's queue, 0x2C7290-0x2C7350) */
#define __MSL_VECTOR_SCALAR(T)                                                                    \
    template <class Allocator>                                                                  \
    class __vector_imp<T, Allocator, true> : public __vector_pod<unsigned int, allocator<unsigned int> > { \
        typedef __vector_pod<unsigned int, allocator<unsigned int> > __base;                    \
                                                                                                \
    public:                                                                                     \
        __MSL_VECTOR_ITERATOR(T)                                                                \
        /* the pointer vectors' begin(), end() and one-element erase (the MSL headers round 5: \
         * the weapons lane's CZItemStash over three vector<int>s -- Compact 0x3CFB20 byte-exact \
         * as a probe, its iterators assigned from erase so in memory, build/p/stash2.cpp in the \
         * MSL lane's worktree. OPEN: Count 0x3CFCF0 and Clear 0x3CFC40 compute the end once, \
         * in a preheader after the loop, sharing begin's load of the data; written `i !=       \
         * m_c.end()` here the data is re-read every pass (0x18 short) -- end() through the     \
         * pod's end(), a const local, data_ straight or data() all alike) */                   \
        iterator __iter(unsigned int *const &p) { return iterator((elem_t *)p); }               \
        iterator begin()                                                                        \
        {                                                                                       \
            unsigned int *const p = __base::begin();                                            \
                                                                                                \
            return __iter(p);                                                                   \
        }                                                                                       \
        iterator end()                                                                          \
        {                                                                                       \
            unsigned int *const p = __base::end();                                              \
                                                                                                \
            return __iter(p);                                                                   \
        }                                                                                       \
        iterator erase(iterator position) { return __iter(__base::erase((unsigned int *)position.m_p)); } \
        unsigned int size() const { return this->size_; }                                       \
        unsigned int capacity() const { return this->capacity_; }                               \
        T &operator[](unsigned int n) { return ((T *)__base::data())[n]; }                      \
        T &at(unsigned int n) { return (T &)__base::at(n); }                                    \
        void push_back(const T &x) { __base::push_back((const unsigned int &)x); }              \
        void clear() { __base::clear(); }                                                       \
        void swap(__vector_imp &x) { __base::swap(x); }                                         \
    };                                                                                          \
    template <class Allocator>                                                                  \
    class vector<T, Allocator> : public __vector_imp<T, Allocator, true> {                      \
    public:                                                                                     \
        void clear() { __vector_imp<T, Allocator, true>::clear(); }                             \
        void swap(vector &x) { __vector_imp<T, Allocator, true>::swap(x); }                     \
    };

/* the bounds-checked element reads, out of line (a template member defined outside its class is
 * never auto-inlined here): each unit that calls one emits its copy, with its own message */
template <class T, class Allocator>
T &__vector_pod<T, Allocator>::at(unsigned int n)
{
    if (n >= size_)
        __msl_error("vector::at index out of range");
    return data_[n];
}

/* the copy: the other's elements copied in, by the range init (SOCOM 1 links both, the copy at
 * the same 0x4C as SOCOM II's 0x259B40; init's error and allocation now inline in it) */
/* the tail moved down over the range (SOCOM 1's erase__ of __vector_pod<Ui>, line for line; MW
 * 3.0 unrolls the copy 8x, its walker a local). The source walker is declared first and the
 * destination initialised first: their registers and their moves' order each follow one */
template <class T, class Allocator>
T *__vector_pod<T, Allocator>::erase(T *first, T *last)
{
    if (first == last)
        return first;
    T *e = data_ + size_;

    if (e - last) {
        T *s, *d = first;

        for (s = last; s < e; ++s, ++d)
            *d = *s;
    }
    size_ -= last - first;
    return first;
}

/* one element erased: the words after it moved down one, the size counted down (SOCOM 1's
 * erase__ of __vector_pod<Ui> taking one position, 0x1DEF80; SOCOM II's 0x28F220, the copy unrolled
 * 8x as the range erase's) */
template <class T, class Allocator>
T *__vector_pod<T, Allocator>::erase(T *position)
{
    T *e = data_ + size_;

    if (e - position - 1) {
        T *s, *d = position;

        for (s = position + 1; s < e; ++s, ++d)
            *d = *s;
    }
    --size_;
    return position;
}

template <class T, class Allocator>
__vector_pod<T, Allocator>::__vector_pod(const __vector_pod &x)
{
    capacity_ = 0;
    size_ = 0;
    data_ = 0;
    init((const T *)x.data_, (const T *)x.data_ + x.size_, forward_iterator_tag());
}

template <class T, class Allocator>
template <class InputIterator>
void __vector_pod<T, Allocator>::init(InputIterator first, InputIterator last, forward_iterator_tag)
{
    size_ = cap() = last - first;
    if (size_ > max_size())
        __msl_error("vector length error\n");
    if (size_) {
        data() = allocate(size_);
        T *d = data_;

        /* a local walks the range: MW unrolls a loop 8x on a local, never on a parameter */
        for (InputIterator p = first; p < last; ++p, ++d)
            *d = *p;
    }
}

/* n copies of value: the length checked, the block allocated and stored through data()'s
 * reference, size and capacity set, value re-read for every element (0x3C45B0; written under
 * that placeholder in vis_main.cpp until now) */
template <class T, class Allocator>
void __vector_pod<T, Allocator>::init(unsigned int n, const T &value)
{
    if (n) {
        if (n > max_size())
            __msl_error("vector length error\n");
        data() = allocate(n);
        size_ = n;
        cap() = n;
        for (T *first = data_; n > 0; --n, ++first)
            *first = value;
    }
}

/* SOCOM 1's lines 337-342: copies of c inserted at the end, or the tail erased */
template <class T, class Allocator>
void __vector_pod<T, Allocator>::resize(unsigned int sz, const T &c)
{
    if (sz > size())
        insert(end(), sz - size(), c);
    else if (sz < size())
        erase(begin() + sz, end());
}

/* reserve: the old elements copied into a fresh block -- word by word for the POD storage, by
 * copy construction into a temporary deleter, swapped in, for a class */
template <class T, class Allocator>
void __vector_pod<T, Allocator>::reserve(unsigned int n)
{
    if (n > cap()) {
        if (n > max_size())
            __msl_error("vector::reserve length error\n");
        T *old = data_;

        data() = allocate(n);
        if (old) {
            T *last = old + size_;

            for (T *p = old, *d = data_; p < last; ++p, ++d)
                *d = *p;
            operator delete(old);
        }
        cap() = n;
    }
}

template <class T, class Allocator, bool IsPOD>
void __vector_imp<T, Allocator, IsPOD>::reserve(unsigned int n)
{
    if (n > this->capacity_) {
        if (n > max_size())
            __msl_error("vector::reserve length error\n");
        __vector_deleter<T, Allocator> temp;

        temp.data_ = temp.allocate(n);
        temp.capacity_.n_ = n;
        T *d = temp.data_;
        T *p = this->data_;
        T *last = p + this->size_;

        for (; p < last; ++p, ++d) {
            temp.construct(d, *p);
            temp.size_++;
        }
        temp.swap(*this);
    }
}

/* the tail moved down over the range through std::copy (out of line for a big element: the turret's
 * 0x3ABAE0, CDesignDlgObj's 0x3845B0), then the elements left past the new end destroyed: n, the
 * count after the range, is a signed int, and the destroy loop starts n past first (the UI lane's
 * measurement: erase<ActionItem> 0x383E00 byte-exact so, ~ActionItem called with -1). MW 3.0
 * deletes the destroy loop for a trivially destructible element, so the other class erases are
 * unchanged */
template <class T, class Allocator, bool IsPOD>
T *__vector_imp<T, Allocator, IsPOD>::erase(T *first, T *last)
{
    if (first == last)
        return first;
    T *e = this->data_ + this->size_;
    int n = e - last;

    if (n)
        std::copy(last, e, first);
    for (T *p = first + n; p < e; ++p)
        p->~T();
    this->size_ -= last - first;
    return first;
}

/* one element erased: the elements after it assigned down one place, the count cut, the position
 * handed back (the 4888-byte accounts' 0x2FE230: the count after it tested first, the source
 * pointer one past the position) */
template <class T, class Allocator, bool IsPOD>
T *__vector_imp<T, Allocator, IsPOD>::erase(T *position)
{
    T *e = this->data_ + this->size_;

    if (e - position - 1) {
        T *s, *d = position;

        for (s = position + 1; s < e; ++s, ++d)
            *d = *s;
    }
    --this->size_;
    return position;
}

/* n copies of x inserted before position, returning nothing (no path sets v0: 0x59CF10) -- SOCOM
 * 1's insert, lines 1428-1485 of its <vector>, statement for statement: the length check (1432);
 * in place when the room is there (1438), the copies that land past the end built there first and
 * the rest assigned (1443-1461, x's address moved along when it lies in the part shifted up, 1456);
 * otherwise a fresh block in a temporary deleter, the capacity doubled from 1 until it holds the new
 * size (1465-1471), the three runs built into it (1477-1482) and the storage swapped in (1483), the
 * temporary's destructor then freeing the old. `newsize > newcap` branches on the compare as the
 * target's loop does (`newcap < newsize` materialises it). SOCOM II's MSL (3.0) builds each element
 * through construct() and moves the old ones through std::copy_backward and std::fill_n (the MSL
 * headers' round 4): the turret's 412-byte definitions show all three cut to calls (placement new
 * and the copy constructor 0x3AC6D0, copy_backward 0x3AC460, fill_n 0x3AC200 -- a stand-in with the
 * definition's scalar members reproduces the whole tail's call structure and order, build/m4/p/
 * turret2.cpp), where SOCOM 1's insert of the same vector calls the copy constructor and the
 * assignment directly. Byte-exact as the copies of vector<CPnt3D> (0x26CC80, zanim_set.cpp),
 * vector<CTarget> (0x2A1AD0), CharacterDynamics' cameras (0x59CF10), Particle::SequenceEntry<CPnt4D>
 * (0x32B650), CSndSequenceEntry (0x34A0D0), TypeRemoteGuy (0x2BF980), TypePendingPlatform and
 * CGameStateChangeCmd.
 * The temporary's destructor (out of class, see the deleter) is a call, inlined, or inlined with
 * clear inlined in it, by the unit's tail generation rounds (measured, build/m4/p/g1.cpp): the
 * insert inlines it only if the destructor was generated before it -- requested in an earlier round
 * or in the same round, the deleter's members going before __vector_imp's -- and clear likewise.
 * So it is the unit's own code that decides: seal_dyn.cpp's (push_back only) calls it (0x59CF10),
 * zsnd_csndsequence.cpp's (whose own code also destroys a vector) inlines it and calls clear
 * (0x34A0D0), vehicle_rdr.cpp's (Close clears, the vector is destroyed) and ai_astar.cpp's (clear
 * and destructor both requested by its own functions) inline both. The image's tail ORDER does not
 * show the rounds (vehicle_rdr.cpp's clear and destructor follow its insert though generated
 * before it: the linker lays the tail out depth first). veh_vehicle.cpp's 0x3AF040, veh_turret.cpp's
 * 0x3ABD90 and zwep_weapon.cpp's 0x3D3D90 inline both with no caller of either left in the image --
 * consistent with an own function of each unit that clears and destroys the vector and was
 * dead-stripped with the copies only it called: appending such a function to veh_vehicle.cpp makes
 * 0x3AF040 the target's size, its tail byte-exact (SOCOM 1's DestroyMarkList deletes the mark list,
 * both blood-decal vectors with it; SOCOM II has no copy of it).
 * Still open, the in-place branch's registers (no change from the helpers above): the end pointer
 * e = data_ + size_ shares data_'s register in the target where MW gives it a fresh one here
 * (CVehicleDef 0x3AF040, CIOPManager::CRegistrant 0x39C7F0 -- which wants a user-declared constructor
 * first: 99 lines off without, 38 with), and takes a fresh one in the target where MW reuses data_'s
 * (SequenceEntry<float> 0x32BB90, SequenceEntry<CTexHandle *> 0x32B210, CAiMapLoc 0x5136B0); the
 * eight matches keep theirs. No change from: i, m or e declared first, `T *i, *e`, the end through
 * end(), data() or &data_[size_], m cast, a size_ local, xp declared late, i declared per branch or
 * initialised at the top, a separate cursor for the second loop; i and j both declared at the top
 * lose all eight matches */
template <class T, class Allocator, bool IsPOD>
void __vector_imp<T, Allocator, IsPOD>::insert(T *position, unsigned int n, const T &x)
{
    if (n == 0)
        return;
    if (n > max_size() || this->size_ > max_size() - n)
        __msl_error("vector::insert length error\n");
    const T *xp = &x;

    if (this->size_ + n <= this->capacity_) {
        T *e = this->data_ + this->size_;
        unsigned int m = e - position;
        T *i;

        if (m < n) {
            for (i = e; m < n; --n, ++i) {
                this->construct(i, *xp);
                ++this->size_;
            }
            for (T *j = position; j < e; ++j, ++i) {
                this->construct(i, *j);
                ++this->size_;
            }
        } else {
            T *j = e - n;

            for (i = e; j < e; ++j, ++i) {
                this->construct(i, *j);
                ++this->size_;
            }
            if (e - (m - n) <= xp && xp < e)
                xp += n;
            std::copy_backward(position, position + (m - n), e);
        }
        std::fill_n(position, n, *xp);
    } else {
        __vector_deleter<T, Allocator> tmp;
        unsigned int newsize = this->size_ + n;
        unsigned int newcap = this->capacity_ ? (unsigned int)this->capacity_ : 1;

        while (newsize > newcap) {
            if (newcap < max_size() / 2)
                newcap *= 2;
            else
                newcap = max_size();
        }
        tmp.data_ = tmp.allocate(newcap);
        tmp.capacity_.n_ = newcap;
        T *i = tmp.data_;
        T *j = this->data_;
        T *e = this->data_ + this->size_;

        for (; j < position; ++j, ++i) {
            this->construct(i, *j);
            ++tmp.size_;
        }
        for (; n > 0; --n, ++i) {
            this->construct(i, *xp);
            ++tmp.size_;
        }
        for (; j < e; ++j, ++i) {
            this->construct(i, *j);
            ++tmp.size_;
        }
        tmp.swap(*this);
    }
}

template <class T, class Allocator, bool IsPOD>
T &__vector_imp<T, Allocator, IsPOD>::at(unsigned int n)
{
    if (n >= this->size_)
        __msl_error("vector::at index out of range");
    return this->data_[n];
}

/* default-built elements inserted at the end, or the tail erased (SOCOM 1's resize(n) of each
 * class vector, the pod's lines 337-342 with T() for the value), insert and erase called out of
 * line. The inline end() and size() are expanded ahead of the call, so an out-of-line element
 * constructor runs after them (CVehicleRdrEntry's 0x5331D0 in 0x534320: the end kept in s3, the
 * test's size reused for the count) and an inline one too tall to inline before them (CTurretDef's
 * 0x3AB5F0 in 0x3AB8C0: size and data read after it). The shape is the targets' (0x534320 to its
 * last eight bytes). Byte-exact as vector<CAiMapLoc>'s (0x51C4A0, ai_mapio.cpp's template tail,
 * with its erase 0x51C510: the element's empty constructor builds nothing, the MSL lane's round 2).
 * The others wait on their element's constructor in another lane's header -- CTurretDef's
 * out-of-line one (zveh.h; CVehicleDef's alike), CVehicleRdrEntry's (zchar), the AI map tables'
 * (ai.h: with ai_mapio.cpp's resizes all switched to the member, readers, actions, regions,
 * spores, names, links, routes, lines and scanlines all miss on the element's construction),
 * CGameStateChangeCmd's pool (CreatePool unwritten); their call sites keep their placeholders */
template <class T, class Allocator, bool IsPOD>
void __vector_imp<T, Allocator, IsPOD>::resize(unsigned int n)
{
    if (n > size())
        insert(end().m_p, n - size(), T());
    else if (n < size())
        erase(begin().m_p + n, end().m_p);
}

/* a range copied into a new vector (MSL's init<const T *>(first, last, forward_iterator_tag), each
 * type's copy in its user's template tail: the particle sequences' 0x328FC0, 0x3290D0, 0x329220):
 * the distance first, then the length check -- on the size, as the image tests it -- the block
 * allocated through data()'s reference, the capacity set, and each element built in place and
 * counted as it is */
template <class T, class Allocator, bool IsPOD>
template <class InputIterator>
void __vector_imp<T, Allocator, IsPOD>::init(InputIterator first, InputIterator last, forward_iterator_tag)
{
    unsigned int n = last - first;

    if (this->size_ > max_size())
        __msl_error("vector length error\n");
    if (n) {
        this->data() = this->allocate(n);
        this->capacity_.n_ = n;
        for (T *p = this->data_; first != last; ++first, ++p) {
            this->construct(p, *first);
            ++this->size_;
        }
    }
}

template <class T, class Allocator = allocator<T> >
class vector : public __vector_imp<T, Allocator, false> {
public:
    void clear() { __vector_imp<T, Allocator, false>::clear(); }
};

__MSL_VECTOR_SCALAR(float)
__MSL_VECTOR_SCALAR(int)
__MSL_VECTOR_SCALAR(unsigned int)

template <class T, class Allocator>
class vector<T *, Allocator> : public __vector_imp<T *, Allocator, true> {
public:
    vector() {}
    /* n copies of value (CVisual's m_lodMesh(0) calls the pod's init(0, a zero) out of line) */
    explicit vector(unsigned int n, T *const &value = 0) : __vector_imp<T *, Allocator, true>(n, value) {}
    void clear() { __vector_imp<T *, Allocator, true>::clear(); }
    void swap(vector &x) { __vector_imp<T *, Allocator, true>::swap(x); }
};

