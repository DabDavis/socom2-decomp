/* <algorithm>: the part of MSL the matched functions inline. A reconstruction: for_each takes
 * its iterators and function object by value, so with class iterators they live in stack
 * slots, copied with lwc1/swc1 as MW copies 4-byte objects (CZAnimExVector::Reset). */

#ifndef _MSL_ALGORITHM
#define _MSL_ALGORITHM

namespace std {

template <class InputIterator, class Function>
inline Function for_each(InputIterator first, InputIterator last, Function f)
{
    for (; first != last; ++first)
        f(*first);
    return f;
}

template <class InputIterator, class T>
inline InputIterator find(InputIterator first, InputIterator last, const T &value)
{
    while (!(first == last) && !(*first == value))
        ++first;
    return first;
}

/* out of line wherever it is used (CNodeVector::Remove calls 0x312480): the iterators by value,
 * homed on the stack */
template <class InputIterator, class OutputIterator, class T>
OutputIterator remove_copy(InputIterator first, InputIterator last, OutputIterator result, const T &value)
{
    for (; first != last; ++first)
        if (!(*first == value)) {
            *result = *first;
            ++result;
        }
    return result;
}

template <class ForwardIterator, class T>
inline ForwardIterator remove(ForwardIterator first, ForwardIterator last, const T &value)
{
    first = find(first, last, value);
    if (first == last)
        return first;
    ForwardIterator i = first;
    return remove_copy(++i, last, first, value);
}

/* the iterators and the operation by value, as for_each's (CWorld::ClearShadowList and
 * ClearLightMapList copy all three through the stack) */
template <class InputIterator, class OutputIterator, class UnaryOperation>
inline OutputIterator transform(InputIterator first, InputIterator last, OutputIterator result,
                                UnaryOperation op)
{
    for (; first != last; ++first, ++result)
        *result = op(*first);
    return result;
}

template <class InputIterator, class Predicate>
inline InputIterator find_if(InputIterator first, InputIterator last, Predicate pred)
{
    while (first != last && !pred(*first))
        ++first;
    return first;
}

/* out of line, as remove_copy (CEntity::PurgeEntities calls 0x29FE70, which calls 0x29FFD0) */
template <class InputIterator, class OutputIterator, class Predicate>
OutputIterator remove_copy_if(InputIterator first, InputIterator last, OutputIterator result, Predicate pred)
{
    for (; first != last; ++first)
        if (!pred(*first)) {
            *result = *first;
            ++result;
        }
    return result;
}

/* the two returns through one copy into the result, as a ternary does it (with an early return
 * MW builds remove_copy_if's straight into it).
 * OPEN (0x29FE70, 6 instructions): the inlined find_if's two iterators take s5/s4 the other way
 * round -- `!(last == first)` in find_if gets five, a for/break ten; find_if is node_vector.cpp's
 * and zanim_anim.cpp's too, so it stays. Measured again (the MSL lane, round 2): SOCOM 1's own
 * remove_if over list<CSched_Task *> (0x2F41F0 in the demo) gives first s4 and last s5 as ours
 * does, SOCOM II's the other way -- find_if's two copies are made in parameter order there and in
 * argument order (right to left) here. Tried: an early return, a new local for the result, `last ==
 * first`, the result declared first, explicit template arguments, the loop written in remove_if
 * (no copies: 0xCC), copies of first and last made in either order before the call, find_if as a
 * for/break, a body return, a local walker; the base iterator copied trivially (its conversion to
 * const_iterator a template: +9, PurgeEntities far off) and the wrapper's copy left implicit
 * (no change). Every form keeps the swap or adds to it */
template <class ForwardIterator, class Predicate>
ForwardIterator remove_if(ForwardIterator first, ForwardIterator last, Predicate pred)
{
    first = find_if(first, last, pred);
    ForwardIterator i = first;
    return first == last ? first : remove_copy_if(++i, last, first, pred);
}

}

#endif
