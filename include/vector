 * 3.0 unrolls the copy 8x, its walker a local). The source walker is declared first and the
 * destination initialised first: their registers and their moves' order each follow one */
template <class T>
T *__vector_pod<T, allocator<unsigned int> >::erase(T *first, T *last)
{
    if (first == last)
        return first;
    T *e = data_ + size_;

    if (e - last) {
        T *s, *d = first;

        for (s = last; s < e; ++s, ++d)
            *d = *s;
    }
    size_ -= last - first;
    return first;
}

/* one element erased: the words after it moved down one, the size counted down (SOCOM 1's
 * erase__ of __vector_pod<Ui> taking one position, 0x1DEF80; SOCOM II's 0x28F220, the copy unrolled
 * 8x as the range erase's) */
template <class T>
T *__vector_pod<T, allocator<unsigned int> >::erase(T *position)
{
    T *e = data_ + size_;

    if (e - position - 1) {
        T *s, *d = position;

        for (s = position + 1; s < e; ++s, ++d)
            *d = *s;
    }
    --size_;
    return position;
}

template <class T>
__vector_pod<T, allocator<unsigned int> >::__vector_pod(const __vector_pod &x)
{
    capacity_ = 0;
    size_ = 0;
    data_ = 0;
    init((const T *)x.data_, (const T *)x.data_ + x.size_, forward_iterator_tag());
}

template <class T>
template <class InputIterator>
void __vector_pod<T, allocator<unsigned int> >::init(InputIterator first, InputIterator last, forward_iterator_tag)
{
    size_ = cap() = last - first;
    if (size_ > max_size())
        __msl_error("vector length error\n");
    if (size_) {
        data() = allocate(size_);
        T *d = data_;

        /* a local walks the range: MW unrolls a loop 8x on a local, never on a parameter */
        for (InputIterator p = first; p < last; ++p, ++d)
            *d = *p;
    }
}

/* the assignment (0x259AF0): assign over the other's words unless it is this one -- the empty tag a
 * byte read off the stack, as the char pod's (0x393D30) */
template <class T>
__vector_pod<T, allocator<unsigned int> > &__vector_pod<T, allocator<unsigned int> >::operator=(const __vector_pod &x)
{
    if (this != &x)
        do_assign((const T *)x.data_, (const T *)x.data_ + x.size_, forward_iterator_tag());
    return *this;
}

/* a range copied over the contents (0x259D20): a fresh block when it does not fit (the count
 * cleared, the old block freed and forgotten), then the words copied by a local walker (MW unrolls
 * it 8x, as init's) and the count set */
template <class T>
template <class InputIterator>
void __vector_pod<T, allocator<unsigned int> >::do_assign(InputIterator first, InputIterator last, forward_iterator_tag)
{
    unsigned int n = last - first;

    if (n > capacity_) {
        if (n > max_size())
            __msl_error("vector::assign length error\n");
        size_ = 0;
        if (data_) {
            deallocate(data_);
            data_ = 0;
            capacity_ = 0;
        }
        data() = allocate(n);
        capacity_ = n;
    }
    T *d = data_;

    for (InputIterator p = first; p < last; ++p, ++d)
        *d = *p;
    size_ = n;
}

/* n copies of value: the length checked, the block allocated and stored through data()'s
 * reference, size and capacity set, value re-read for every element (0x3C45B0; written under
 * that placeholder in vis_main.cpp until now) */
template <class T>
void __vector_pod<T, allocator<unsigned int> >::init(unsigned int n, const T &value)
{
    if (n) {
        if (n > max_size())
            __msl_error("vector length error\n");
        data() = allocate(n);
        size_ = n;
        cap() = n;
        for (T *first = data_; n > 0; --n, ++first)
            *first = value;
    }
}

/* n copies of x inserted before position (OVL1 0x1FE340, hud_main.cpp's tail the first to emit it;
 * OVL2 0x5192E0): the char pod's insert (0x3923E0) statement for statement, its moves word loops --
 * the in-place tail shifted up from the end, the fill re-reading x through xp each pass, the two
 * old runs copied forward by local walkers (MW unrolls them 8x) -- and MAIN's exceptions-on copy
 * (0x18B810, src/main/msl/msl.h) with __msl_error's fprintf and abort for the throw */
template <class T>
void __vector_pod<T, allocator<unsigned int> >::insert(T *position, unsigned int n, const T &x)
{
    if (n == 0)
        return;
    if (n > max_size() || size_ > max_size() - n)
        __msl_error("vector::insert length error\n");
    const T *xp = &x;
    unsigned int newsize = size_ + n;

    if (newsize <= capacity()) {
        T *e = data_ + size_;
        unsigned int m = e - position;

        if (e - (m - n) <= xp && xp < e)
            xp += n;
        if (m)
            for (T *i = e, *j = e + n; position < i;)
                *--j = *--i;
        for (unsigned int c = n; c != 0; --c, ++position)
            *position = *xp;
        size_ += n;
    } else {
        unsigned int k = position - data_;
        T *old = data_;
        unsigned int newcap = capacity_ ? capacity_ : 1;

        while (newsize > newcap) {
            if (newcap < max_size() / 2)
                newcap *= 2;
            else
                newcap = max_size();
        }
        data() = allocate(newcap);
        T *p = data_ + k;

        for (unsigned int c = n; c != 0; --c, ++p)
            *p = *xp;
        if (old) {
            T *s, *d = data_;

            for (s = old; s < old + k; ++s, ++d)
                *d = *s;
            T *oldend = old + size_;
            T *s2, *d2 = data_ + k + n;

            for (s2 = old + k; s2 < oldend; ++s2, ++d2)
                *d2 = *s2;
            deallocate(old);
        }
        size_ = newsize;
        capacity_ = newcap;
    }
}

/* SOCOM 1's lines 337-342: copies of c inserted at the end, or the tail erased. THE SIZE READ THROUGH A
 * CONST REFERENCE, THE ERASE'S FIRST THROUGH data() (the MSL headers round 35): resize then calls no
 * in-class inline but end() and data(), both parsed wherever a pointer vector's begin() and end() are,
 * so the walk generates it on the spot (above). The const read is size()'s own: MW keeps a load through
 * a const lvalue apart from end()'s plain `size_`, so the compares and the count share one load and
 * end() reloads -- the target's, as through size(); through `size_` itself the loads merge (14 off),
 * and the pointer vectors' size() cannot parse the pod's: it is their own and one high (each element
 * type's out-of-line copy is its own -- CTCMNode's 0x231E20, CKey's 0x25B2E0 -- and HideAll 0x231BA0
 * cuts a two-high size() a level early). Through the pod's begin() the erase's first is the same code */
template <class T>
void __vector_pod<T, allocator<unsigned int> >::resize(unsigned int sz, const T &c)
{
    const unsigned int &n = size_;

    if (sz > n)
        insert(end(), sz - n, c);
    else if (sz < n)
        erase(data() + sz, end());
}

/* reserve: the old elements copied into a fresh block -- word by word for the POD storage, by
 * copy construction into a temporary deleter, swapped in, for a class */
template <class T>
void __vector_pod<T, allocator<unsigned int> >::reserve(unsigned int n)
{
    if (n > cap()) {
        if (n > max_size())
            __msl_error("vector::reserve length error\n");
        T *old = data_;

        data() = allocate(n);
        if (old) {
            T *last = old + size_;

            for (T *p = old, *d = data_; p < last; ++p, ++d)
                *d = *p;
            operator delete(old);
        }
        cap() = n;
    }
}

template <class T, class Allocator, bool IsPOD>
void __vector_imp<T, Allocator, IsPOD>::reserve(unsigned int n)
{
    if (n > this->capacity_) {
        if (n > max_size())
            __msl_error("vector::reserve length error\n");
        __vector_deleter<T, Allocator> temp;

        temp.data_ = temp.allocate(n);
        temp.capacity_.n_ = n;
        T *d = temp.data_;
        T *p = this->data_;
        T *last = p + this->size_;

        for (; p < last; ++p, ++d) {
            temp.construct(d, *p);
            temp.size_++;
        }
        temp.swap(*this);
    }
}

