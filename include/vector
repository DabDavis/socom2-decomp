    template <class Allocator>                                                                  \
    class __vector_imp<T, Allocator, true> : public __vector_pod<unsigned int, allocator<unsigned int> > { \
        typedef __vector_pod<unsigned int, allocator<unsigned int> > __base;                    \
                                                                                                \
    public:                                                                                     \
