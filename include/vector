 *    -43; the else loop as a helper taking (last, first, result) -21; the end object or m declared
 *    first, m's cast: +0 / -0 */
template <class T, class Allocator, bool IsPOD>
void __vector_imp<T, Allocator, IsPOD>::insert(T *position, unsigned int n, const T &x)
{
    if (n == 0)
        return;
    if (n > max_size() || this->size_ > max_size() - n)
        __msl_error("vector::insert length error\n");
    const T *xp = &x;
    iterator e;

    if (this->size_ + n <= this->capacity_) {
        e = this->end();
        unsigned int m = e.m_p - position;
        T *i;

        if (m < n) {
            for (i = e.m_p; m < n; --n, ++i) {
                this->construct(i, *xp);
                ++this->size_;
            }
            for (T *j = position; j < e.m_p; ++j, ++i) {
                this->construct(i, *j);
                ++this->size_;
            }
        } else {
            T *j = e.m_p - n;

            for (T *k = e.m_p; j < e.m_p; ++j, ++k) {
                this->construct(k, *j);
                ++this->size_;
            }
            if (e.m_p - (m - n) <= xp && xp < e.m_p)
                xp += n;
            std::copy_backward(position, position + (m - n), e.m_p);
        }
        std::fill_n(position, n, *xp);
    } else {
        __vector_deleter<T, Allocator> tmp;
        unsigned int newsize = this->size_ + n;
        unsigned int newcap = this->capacity_ ? (unsigned int)this->capacity_ : 1;

        while (newsize > newcap) {
            if (newcap < max_size() / 2)
                newcap *= 2;
            else
                newcap = max_size();
        }
        tmp.data_ = tmp.allocate(newcap);
        tmp.capacity_.n_ = newcap;
        T *i = tmp.data_;
        T *j = this->data_;
        e = this->end();

        for (; j < position; ++j, ++i) {
            this->construct(i, *j);
            ++tmp.size_;
        }
        for (; n > 0; --n, ++i) {
            this->construct(i, *xp);
            ++tmp.size_;
        }
        for (; j < e.m_p; ++j, ++i) {

            this->construct(i, *j);
            ++tmp.size_;
        }
        tmp.swap(*this);
    }
}

template <class T, class Allocator, bool IsPOD>
T &__vector_imp<T, Allocator, IsPOD>::at(unsigned int n)
{
    if (n >= this->size_)
        __msl_error("vector::at index out of range");
    return this->data_[n];
}

/* default-built elements inserted at the end, or the tail erased (SOCOM 1's resize(n) of each
 * class vector, the pod's lines 337-342 with T() for the value), insert and erase called out of
 * line. The inline end() and size() are expanded ahead of the call, so an out-of-line element
 * constructor runs after them (CVehicleRdrEntry's 0x5331D0 in 0x534320: the end kept in s3, the
 * test's size reused for the count) and an inline one too tall to inline before them (CTurretDef's
 * 0x3AB5F0 in 0x3AB8C0: size and data read after it). The shape is the targets' (0x534320 to its
 * last eight bytes). Byte-exact as vector<CAiMapLoc>'s (0x51C4A0, ai_mapio.cpp's template tail,
 * with its erase 0x51C510: the element's empty constructor builds nothing, the MSL lane's round 2).
 * The others wait on their element's constructor in another lane's header -- CTurretDef's
 * out-of-line one (zveh.h; CVehicleDef's alike), CVehicleRdrEntry's (zchar), the AI map tables'
 * (ai.h: with ai_mapio.cpp's resizes all switched to the member, readers, actions, regions,
 * spores, names, links, routes, lines and scanlines all miss on the element's construction),
 * CGameStateChangeCmd's pool (CreatePool unwritten); their call sites keep their placeholders */
template <class T, class Allocator, bool IsPOD>
void __vector_imp<T, Allocator, IsPOD>::resize(unsigned int n)
{
    if (n > size())
        insert(end().m_p, n - size(), T());
    else if (n < size())
        erase(begin().m_p + n, end().m_p);
}

/* a range copied into a new vector (MSL's init<const T *>(first, last, forward_iterator_tag), each
 * type's copy in its user's template tail: the particle sequences' 0x328FC0, 0x3290D0, 0x329220):
 * the distance first, then the length check -- on the size, as the image tests it -- the block
 * allocated through data()'s reference, the capacity set, and each element built in place and
 * counted as it is */
template <class T, class Allocator, bool IsPOD>
template <class InputIterator>
void __vector_imp<T, Allocator, IsPOD>::init(InputIterator first, InputIterator last, forward_iterator_tag)
{
    unsigned int n = last - first;

    if (this->size_ > max_size())
        __msl_error("vector length error\n");
    if (n) {
        this->data() = this->allocate(n);
        this->capacity_.n_ = n;
        for (T *p = this->data_; first != last; ++first, ++p) {
            this->construct(p, *first);
            ++this->size_;
        }
    }
}

/* the smaller of two by reference (std::min's shape, include/string's: both read through their
 * references -- written in the expression, the count's first load was reused) */
/* a range copied over the contents (MSL's do_assign(first, last, forward_iterator_tag); SOCOM 1's
 * do_assign<PC14CCharacterWeap> 0x1D7700 and do_assign<PC3LOD> 0x24B2E0, SOCOM II's 0x53F370 and
 * 0x53F730, char_type.cpp's template tail -- the name the pods' here): the count kept in memory (min
 * takes its address); when it fits, the elements there assigned over, then the rest destroyed or
 * built in place and counted; else, past the length check, every element destroyed (clear), the
 * block freed and forgotten, a new one allocated through data()'s reference, and each built and
 * counted */
template <class T>
inline const T &__vector_min(const T &a, const T &b)
{
    return b < a ? b : a;
}

template <class T, class Allocator, bool IsPOD>
template <class InputIterator>
void __vector_imp<T, Allocator, IsPOD>::do_assign(InputIterator first, InputIterator last, forward_iterator_tag)
{
    unsigned int n = last - first;

    if (n <= this->capacity_) {
        const unsigned int &m = __vector_min(n, this->size_);
        T *p = this->data_;
        T *e = p + m;

        for (; p < e; ++p, ++first)
            *p = *first;
        if (n < this->size_) {
            for (T *q = p, *l = this->data_ + this->size_; q < l; ++q)
                q->~T();
            this->size_ = n;
        } else if (this->size_ < n) {
            for (; first != last; ++first, ++p) {
                this->construct(p, *first);
                ++this->size_;
            }
        }
    } else {
        if (n > max_size())
            __msl_error("vector::assign length error\n");
        this->clear();
        if (this->data_) {
            operator delete(this->data_);
            this->data_ = 0;
            this->capacity_.n_ = 0;
        }
        this->data() = this->allocate(n);
        this->capacity_.n_ = n;
        for (T *p = this->data_; first != last; ++first, ++p) {
            this->construct(p, *first);
            ++this->size_;
        }
    }
}

/* whether a vector's element is a one-byte scalar, which runs on the byte pod over its own type (a
 * char type, an enum of one byte under -enum min; bool is MSL's bit vector, its own specialisation:
 * hud_objectives.cpp) -- MW 3.0's SFINAE class test first, so no class element's size is asked */
template <class T, bool IsClass>
struct __vector_byte_test {
    enum { value = sizeof(T) == 1 };
};

template <class T>
struct __vector_byte_test<T, true> {
    enum { value = 0 };
};

template <class T>
struct __vector_is_byte {
    enum { value = __vector_byte_test<T, Metrowerks::is_class<T>::value>::value };
};

template <>
struct __vector_is_byte<bool> {
    enum { value = 0 };
};

template <class T, class Allocator = allocator<T> >
class vector : public __vector_imp<T, Allocator, __vector_is_byte<T>::value> {
    typedef __vector_imp<T, Allocator, __vector_is_byte<T>::value> __imp;

public:
    typedef typename __imp::const_iterator const_iterator;

    /* the base's ends (the class iterators), and a const walk's pair of its own, straight off the
     * members, hiding the base's raw const ends: SOCOM II's const walks return a class (the AI lane,
     * round 16: CAiMapLocVec::ComputeLength, inlined one level into CAiMap::CreateGraph, calls them
     * out of line -- OVL2 0x52F3E0 and 0x52F310, ai_maptable.cpp's own copies apart from the
     * non-const 0x529E90/0x529EB0), while the base's copy constructor reads through raw ones (above) */
    using __imp::begin;
    using __imp::end;
    const_iterator begin() const { return const_iterator(this->data_); }
    const_iterator end() const { return const_iterator(this->data_ + this->size_); }
    /* the reverse walk, as the scalar vectors' (std::reverse_iterator, include/iterator; the HUD's
     * round 46: hud_scorepopup.cpp's pop-up loader stores each new name through `*names.rbegin()`,
     * end() 0x22DD20 and the reverse * 0x22DD10 out of line there) */
    typedef std::reverse_iterator<typename __imp::iterator> reverse_iterator;
    reverse_iterator rbegin() { return reverse_iterator(this->end()); }
    reverse_iterator rend() { return reverse_iterator(this->begin()); }
    void clear() { __imp::clear(); }
    /* the states lane's round 17: a forwarder, as clear() is -- st_core.cpp's SetMovie calls its
     * out-of-line copy (0x1EDF10, `j` to the cue vector's reserve 0x1EF190) */
    void reserve(unsigned int n) { __imp::reserve(n); }
};

__MSL_VECTOR_SCALAR(float)
__MSL_VECTOR_SCALAR(int)
__MSL_VECTOR_SCALAR(unsigned int)

/* a vector of a one-byte scalar (vector<char>, an enum's: __vector_is_byte above): the byte pod over
 * the element type, its iterators the scalar vectors' (the const one for the primary vector's const
 * walk, which nothing here calls) */
template <class T, class Allocator>
class __vector_imp<T, Allocator, true> : public __vector_pod<T, Allocator> {
    typedef __vector_pod<T, Allocator> __base;

public:
    __MSL_VECTOR_ITERATOR(T)
    class const_iterator {
    public:
        const_iterator(const elem_t *p) : m_p(p) {}
        const_iterator(const iterator &i) : m_p(i.m_p) {}
        bool operator==(const const_iterator &o) const { return m_p == o.m_p; }
        bool operator!=(const const_iterator &o) const { return !(*this == o); }
        const_iterator &operator++() { ++m_p; return *this; }
        const elem_t &operator*() const { return *m_p; }

        const elem_t *m_p;
    };
    iterator begin() { return iterator(__base::begin()); }
    iterator end() { return iterator(__base::end()); }
    unsigned int size() const { return this->size_; }
    T &operator[](unsigned int n) { return __base::data()[n]; }
    void clear() { this->size_ = 0; }
    /* the last character dropped (the UI lane's round 10: zui_hangul.cpp's SkbHangulBack) */
    void pop_back() { this->size_--; }
};

template <class T, class Allocator>
class vector<T *, Allocator> : public __vector_imp<T *, Allocator, true> {
public:
    vector() {}
    /* n copies of value (CVisual's m_lodMesh(0) calls the pod's init(0, a zero) out of line) */
    explicit vector(unsigned int n, T *const &value = 0) : __vector_imp<T *, Allocator, true>(n, value) {}
    void clear() { __vector_imp<T *, Allocator, true>::clear(); }
    void swap(vector &x) { __vector_imp<T *, Allocator, true>::swap(x); }
    /* a forwarder to the pod's reserve, as the class vector's (see __vector_imp<T *>'s comment) */
    void reserve(unsigned int n) { __vector_imp<T *, Allocator, true>::reserve(n); }
};

