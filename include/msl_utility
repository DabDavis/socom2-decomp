/* <msl_utility>: the piece of Metrowerks' MSL utility header the decomp needs -- std::swap (SOCOM 1's
 * DWARF keeps an out-of-line swap<Ui> under MSL_Common\Include\msl_utility). A reconstruction. */

#ifndef _MSL_UTILITY
#define _MSL_UTILITY

namespace std {

template <class T>
inline void swap(T &a, T &b)
{
    T t(a);

    a = b;
    b = t;
}

/* the smaller of two (MSL's: the second only when it is less, both by reference -- the string's
 * compare and the deque's destroy take the addresses of their counts and temporaries) */
template <class T>
inline const T &min(const T &a, const T &b)
{
    return b < a ? b : a;
}

}

namespace Metrowerks {

/* whether T is a class (a pointer to a member of it can be formed: MW 3.0 takes the SFINAE test)
 * and so whether its destructor may do anything: the deque destroys only class elements (the chat
 * lines' clear 0x2F5A30 calls its range destroy 0x2F5B10; the lobby's states' clear 0x2E1B20, an
 * enum's, has none) -- MSL's has_trivial_dtor as far as SOCOM II's elements tell it apart */
template <class T>
struct is_class {
    template <class U>
    static char test(int U::*);
    template <class U>
    static long test(...);
    enum { value = sizeof(test<T>(0)) == 1 };
};

template <class T>
struct has_trivial_dtor {
    enum { value = !is_class<T>::value };
};

}

namespace Metrowerks {

/* a pointer an allocator made, given back to it unless released: MSL's guard for a node while its
 * value is built (SOCOM 1's DWARF: alloc_ptr<node, allocator<node> &>, 8 bytes, a compressed pair
 * of the allocator reference and the pointer; its destructor at msl_utility line 1092). The list's
 * insert holds its new node in one (SOCOM II's 0x1FEAE0: {&end_, node} on the stack, released
 * before the links are made, the destructor's `if (p) deallocate` after) */
/* a constant as a type (SOCOM 1's number<Ui,1>, one byte: the count an alloc_ptr gives back) */
template <class T, T N>
struct number {
    operator T() const { return N; }
};

template <class T, class Allocator, class Size = number<unsigned int, 1> >
class alloc_ptr {
public:
    /* the count passed by value, an empty class: value-initialised, a zero byte on the stack
     * that nothing reads (SOCOM II's sb zero,124(sp) in the list's insert) */
    alloc_ptr(T *p, Allocator a, Size = Size()) : a_(a), p_(p) {}
    ~alloc_ptr()
    {
        if (ptr())
            a_.deallocate(ptr());
    }
    /* the pointer through a reference, as the compressed pair's second() gives it: every access
     * then goes through its address in one register (the target's v1) */
    T *&ptr() { return p_; }
    T *get() { return ptr(); }
    T *release()
    {
        T *p = ptr();

        ptr() = 0;
        return p;
    }

private:
    Allocator a_;
    T *p_;
};

/* the guard with its count kept (the MSL headers round 14): a count given as a value, not a
 * number<>, is stored between the allocator and the pointer and handed to deallocate -- the
 * deque's push_back holds its new block so, {allocator, 128, block} on the stack (0x2CF970) */
template <class T, class Allocator>
class alloc_ptr<T, Allocator, unsigned int> {
public:
    alloc_ptr(T *p, Allocator a, unsigned int n) : a_(a), n_(n), p_(p) {}
    ~alloc_ptr()
    {
        if (ptr())
            a_.deallocate(ptr(), n_);
    }
    T *&ptr() { return p_; }
    T *get() { return ptr(); }
    T *release()
    {
        T *p = ptr();

        ptr() = 0;
        return p;
    }

private:
    Allocator a_;
    unsigned int n_;
    T *p_;
};

}

#endif
