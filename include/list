/* <list>: just enough of Metrowerks' MSL C++ std::list (CodeWarrior PS2 3.0) to give the
 * matched functions their code and their mangled names. A reconstruction, not MSL: the class
 * shapes are SOCOM 1's DWARF (list : __list_imp : __list_deleter, size_ at 0, the end node at
 * 4 with prev_/next_, a node's value after its links), the member bodies are whatever compiles
 * to the shipped bytes. A pointer list shares one implementation over const void * -- hence
 * __list_deleter<PCv,...> in the names of every list<T *>'s calls -- and wraps its iterators
 * (SOCOM 1's list<T *>::generic_iterator<0> is built from the base's).
 *
 * The constructor, insert and erase are defined outside the class, so none is ever inlined into
 * a unit's own functions: CSaveManager's and CZAnimArgList's constructors call the deleter's
 * (0x1EABB0), clear() is a call to the range erase (0x1EAAF0 for the pointer lists), push_back a
 * call to insert. The destructor chain is three this-tested levels above clear() (CZAnimArgList's
 * destructor shows all three). In tail code they count, and at -inline level=5 their depths are
 * load-bearing (measured over every unit, 2026-10-25): the range erase frees through the node
 * allocator (three high), so an implicit list destructor where the erase was instantiated inlines
 * ~list one level (~CEntityList, ~CAssetList, ~CAiEventList); insert, written with MSL's alloc_ptr
 * (its copies byte-exact in 21 units), expands past inline_max_size in an out-of-line push_back
 * (253 units -- 3 under -- without the allocator's construct) and makes ai_events.cpp's remove_if
 * cut find_if. */

#ifndef _MSL_LIST
#define _MSL_LIST

#include <functional>
#include <memory>
#include <msl_utility>
#include <new>
#include <stdio.h>
#include <stdlib.h>

#ifndef __msl_error
#define __msl_error(str) \
    {                    \
        fprintf(stderr, str); \
        abort();         \
    }
#endif

namespace std {

template <class T, class Allocator>
class __list_deleter {
public:
    struct node_base {
        node_base *prev_;
        node_base *next_;
    };
    struct node : public node_base {
        T data_;
    };

    template <bool IsConst>
    class generic_iterator {
    public:
        generic_iterator() {}
        generic_iterator(node_base *n) : node_(n) {}
        generic_iterator(const node_base *n) : node_((node_base *)n) {}
        /* iterator's copy constructor, so iterators are passed by address (erase's are); the
         * copy assignment stays implicit, a bitwise copy (lwc1/swc1). For const_iterator it is a
         * conversion, and its copy constructor implicit: passed by value, bitwise */
        generic_iterator(const generic_iterator<false> &x) : node_(x.node_) {}
        T &operator*() const { return ((node *)node_)->data_; }
        generic_iterator &operator++()
        {
            node_ = node_->next_;
            return *this;
        }
        bool operator==(const generic_iterator &x) const { return node_ == x.node_; }
        bool operator!=(const generic_iterator &x) const { return node_ != x.node_; }

        node_base *node_;
    };
    typedef generic_iterator<false> iterator;
    typedef generic_iterator<true> const_iterator;

    __list_deleter();
    /* built from an allocator, out of line as the default one (the copy constructor's first
     * step: CNode::SetParentHasVisuals calls it, 0x3177A0) */
    __list_deleter(const Allocator &a);
    /* the first node read through a reference to the sentinel, as begin() reads it, the end built
     * from the member (one level of inlines below it, so the four this-tested levels of a member
     * list's implicit destructor still inline it whole: CValve's). See begin() */
    ~__list_deleter()
    {
        node_base &t = end_;

        erase(iterator(t.next_), iterator(&end_));
    }
    /* the elements of a range appended one by one, out of line (0x317720 for the pointer lists'
     * const iterators: the iterators by value, homed, end() and insert called) */
    template <class InputIterator>
    void init(InputIterator first, InputIterator last);
    /* the first node read through a reference to the sentinel (the list<T *> wrapper's begin() and
     * the destructor read it so too): MW then computes &end_.next_ once, as a compiler temporary,
     * and keeps it in a saved register for every later begin() of the function -- a walk's, a
     * clear()'s, the implicit destructor's (`lw v0,0(s0)`). Read straight off `this`, each begin()
     * after a call reloads 16(this) or 4(&end_) instead. Measured over every hand-written unit
     * (2026-10-25): with the destructor and the wrapper's begin() alike, CValve's destructor,
     * CValve::DeleteCallbacks, CNode::SetParentHasVisuals, CWorld::GenerateLightList,
     * CClutterAnimManager::ClearEffectors, CLensFlareManager::Clear and CCell's constructor and
     * destructor byte-exact, and ~CZAmmoList/~CZWeaponList (their drafts' matches) from hand
     * source, nothing lost. A reference to the next_ link itself (`node_base *const &n =
     * end_.next_`) does it only in part: CValve's destructor stays two instructions off and
     * CAckList::Clear is lost */
    iterator begin()
    {
        node_base &t = end_;

        return iterator(t.next_);
    }
    iterator end() { return iterator(&end_); }
    const_iterator begin() const { return const_iterator(end_.next_); }
    const_iterator end() const { return const_iterator(&end_); }
    void clear() { erase(begin(), end()); }
    iterator erase(iterator first, iterator last);
    iterator erase(iterator position);
    iterator insert(iterator position, const T &x);
    void push_back(const T &x) { insert(end(), x); }

    unsigned int size() const { return size_; }
    /* the node allocator: MSL keeps it as the empty base of the end node's pair (SOCOM 1's DWARF:
     * end_ is a compressed_pair whose compressed_pair_imp derives from the allocator), reached
     * through the pair's first() -- the names are ours. Only the out-of-line members free nodes
     * through it, so it counts only in tail code: the range erase is three high there, and an
     * implicit list destructor in a unit that instantiated the erase (~CEntityList, ~CAssetList,
     * ~CAiEventList) inlines ~list one level and calls ~__list_imp at -inline level=5 */
    struct node_allocator {
        node *allocate()
        {
            node *p = (node *)operator new(sizeof(node));

            if (!p)
                __msl_error("Memory allocation failure");
            return p;
        }
        void deallocate(node_base *p) { operator delete(p); }
        /* the value built in place (MSL's allocator construct: placement new, so a null test) */
        void construct(T *p, const T &x) { new (p) T(x); }
    };
    node_allocator &node_alloc() { return end_first(); }
    node_allocator &end_first() { return *(node_allocator *)&end_; }
    /* the sentinel by reference (CZHudMissionCams::Init keeps the end node in a register outside
     * its loop only so; the name is ours) */
    node_base &end_node() { return end_; }
    /* the sentinel's address (SOCOM 1's tail(), this + 4: 0x173510 in the demo) */
    node_base *tail() { return &end_; }
    const node_base *tail() const { return &end_; }

protected:
    unsigned int size_;
    node_base end_;
};

/* The constructors are template members defined outside the class, so MW treats them as it treats
 * the vector deleter's destructor: never inlined into the unit's own functions (CAssetList's,
 * CSaveManager's and CZAnimArgList's constructors call 0x1EABB0), but inlined into code compiled
 * in the unit's template tail -- an initialiser counts -- once one of the unit's own functions has
 * instantiated it: __sinit_node_assetlib.cpp inlines it (CAssetList's constructor instantiated it),
 * __sinit_ent_main.cpp and __sinit_ent_target.cpp call it (no function of theirs builds a list).
 * The body takes the sentinel's address into a local first and stores through it, next_ then
 * prev_ -- SOCOM 1's line table has the three statements (219-221) -- so the inlined copy keeps
 * &end_ in v0 (sw v0,4(v0); sw v0,0(v0)); `end_.prev_ = end_.next_ = &end_` stores through
 * absolute addresses there, and the sentinel through tail() or a reference accessor makes the
 * constructor too tall to inline (the out-of-line copies are alike either way) */
template <class T, class Allocator>
__list_deleter<T, Allocator>::__list_deleter()
    : size_(0)
{
    node_base *t = &end_;

    t->next_ = t;
    t->prev_ = t;
}

template <class T, class Allocator>
__list_deleter<T, Allocator>::__list_deleter(const Allocator &)
    : size_(0)
{
    node_base *t = &end_;

    t->next_ = t;
    t->prev_ = t;
}

template <class T, class Allocator>
template <class InputIterator>
void __list_deleter<T, Allocator>::init(InputIterator first, InputIterator last)
{
    for (; first != last; ++first)
        insert(end(), *first);
}

/* the nodes [first, last) unlinked around the last one's links, then freed one by one
 * (0x1EAAF0, and every type's 0xBC copy). first's node is taken into a local before the test,
 * which compares it with last's: the node then keeps the register it was loaded into (a2), where
 * `first == last` first and the local after gave the last node that register and first's a1 */
template <class T, class Allocator>
typename __list_deleter<T, Allocator>::iterator
__list_deleter<T, Allocator>::erase(iterator first, iterator last)
{
    node_base *f = first.node_;

    if (f == last.node_)
        return last;
    node_base *l = last.node_->prev_;

    f->prev_->next_ = l->next_;
    l->next_->prev_ = f->prev_;
    while (first != last) {
        node_base *n = first.node_;

        first.node_ = n->next_;
        node_alloc().deallocate(n);
        --size_;
    }
    return last;
}

/* a node made for the value and linked in before position (SOCOM II's for the pointer lists is
 * 0x1FEAE0, OVL2's 0x50FAD0): allocated by the node allocator and held in MSL's alloc_ptr while
 * the value is built in it, released, then linked and counted */
template <class T, class Allocator>
typename __list_deleter<T, Allocator>::iterator
__list_deleter<T, Allocator>::insert(iterator position, const T &x)
{
    node_allocator &a = node_alloc();
    Metrowerks::alloc_ptr<node, node_allocator &> ap(a.allocate(), a);

    a.construct(&ap.get()->data_, x);
    node *n = ap.release();
    node_base *p = position.node_;

    p->prev_->next_ = n;
    n->prev_ = p->prev_;
    p->prev_ = n;
    n->next_ = p;
    ++size_;
    return iterator(n);
}

/* one node unlinked and freed, the iterator after it given back (SOCOM II's for the pointer lists
 * is 0x20CC50) */
template <class T, class Allocator>
typename __list_deleter<T, Allocator>::iterator
__list_deleter<T, Allocator>::erase(iterator position)
{
    node_base *n = position.node_;

    ++position;
    n->prev_->next_ = n->next_;
    n->next_->prev_ = n->prev_;
    operator delete(n);
    --size_;
    return position;
}

template <class T, class Allocator>
class __list_imp : public __list_deleter<T, Allocator> {
public:
    __list_imp() {}
    /* a copy: a fresh deleter on the source's allocator, then the source's elements appended
     * (CNode::SetParentHasVisuals copies a model's instance list so) */
    __list_imp(const __list_imp &x) : __list_deleter<T, Allocator>(*(const Allocator *)&x)
    {
        typedef typename __list_deleter<T, Allocator>::const_iterator const_iterator;

        this->init(const_iterator(x.end_.next_), const_iterator(&x.end_));
    }
    /* defined outside the class, so called (SOCOM II's for the pointer lists is 0x20CB50) */
    template <class Predicate>
    void remove_if(Predicate pred);
    /* the binder made here, not through bind2nd: a level shorter, which CModel::RemoveInstance's
     * inlining in CNode::Delete needs */
    void remove(const T &value) { remove_if(binder2nd<equal_to<T>, T>(equal_to<T>(), value)); }
};

/* the runs that satisfy the predicate erased, one after another (SOCOM 1's shape; SOCOM II's
 * inlines the erase, not reproduced yet) */
template <class T, class Allocator>
template <class Predicate>
void __list_imp<T, Allocator>::remove_if(Predicate pred)
{
    typename __list_deleter<T, Allocator>::iterator e = this->end();
    typename __list_deleter<T, Allocator>::iterator i = this->begin();

    while (i != e) {
        if (pred(*i)) {
            typename __list_deleter<T, Allocator>::iterator j = i;

            for (++j; j != e && pred(*j); ++j)
                ;
            i = this->erase(i, j);
            if (i == e)
                break;
        }
        ++i;
    }
}

template <class T, class Allocator = allocator<T> >
class list : public __list_imp<T, Allocator> {
};

template <class T, class Allocator>
class list<T *, Allocator> : public __list_imp<const void *, allocator<const void *> > {
    typedef __list_imp<const void *, allocator<const void *> > base;

public:
    /* the reference passed on as the base's, no temporary (the pointer stays where it is), to
     * the base's insert, the end iterator made here from the sentinel: shorter than through the
     * base's push_back and end(), which CNode::CreateInstance's auto-inlining needs (an
     * auto-inline callee taller than the level is not inlined at all -- no one-level fallback).
     *
     * OPEN, the shape SOCOM II's own MSL has here (the entity lane, round 7; scratch in
     * build/scratch/list/, lv.py scoring every hand-written unit per variant). ai_events.cpp's
     * template tail is SOCOM 1's chain, list<T *>::push_back -> the base's push_back -> insert(end(),
     * x): 0x50F810 is the BASE push_back's copy (end() inlined) and 0x50FE80 the event list's
     * (end() called, 0x50FED0) -- the map has the two names the wrong way round. Written so
     * (variant vc: this push_back calls base::push_back, which is insert(end(), x), and insert
     * DEFINED after the class), MW reproduces the whole tail: an out-of-class member that the
     * unit's own code instantiated counts in tail code's heights (never in own code), and insert
     * is taller than the limit, so _tick::operator()'s copy inlines this push_back one level and
     * calls the base's, remove_copy_if inlines _tick one level (Tick called) and calls this one,
     * whose copy inlines the base's one level (end() called). With the names swapped and _tick
     * written `bool r = e->Tick(m_dT); if (r) m_pool->push_back(e); return r;`, _tick, remove_copy_if,
     * both push_backs, end(), Release and Create match (and ent_target's SetIncludeInTargetList);
     * but this push_back is then four high in own code, and CreateInstance(model) (AddInstance ->
     * push_back, auto-inlined into CreateInstance(name)), CreateEntity (into CreateRecycler) and
     * the stack slots of Add2D, CZHudMissionCams::Init and GetLoadedLibRefs are lost: at
     * -inline level=4 no list shape satisfies both.
     * At level 5 (the inline-level lane, 2026-10-25) this shape stays: vc keeps CreateInstance(model)
     * auto-inlined only at level 6 (measured there with ~__list_deleter as erase(begin(), end()),
     * which OVL2's ~__list_imp copy 0x510080 shows and ~C2D allows only at 6: ~C2D, CreateInstance
     * x2, Release, SetIncludeInTargetList and end()'s copy match, the three stack-slot losses stay,
     * and every chain refitted for 5 wants a level more -- README "Open, and next"). With insert
     * now written (its alloc_ptr), level 5 reproduces ai_events.cpp's remove_if (the wrapper
     * iterator's copies) and this push_back's out-of-line copy (insert past inline_max_size: 0x50F810
     * under its present map name); _tick::operator() and remove_copy_if stay open on vc. */
    void push_back(T *const &x)
    {
        base::insert(typename base::iterator(&this->end_node()), (const void *const &)x);
    }
    void remove(T *const &x) { base::remove((const void *const &)x); }
    /* the last element, and taking it off (CNode::DeleteDeferredVisuals empties its list so; on
     * the pointer list only, where the node is always complete -- ai_events.cpp instantiates a
     * deleter over an incomplete type) */
    T *&back() { return (T *&)((typename base::node *)this->end_.prev_)->data_; }
    /* the first (CEntity::PreTickAll hands the recycler the first entity queued) */
    T *&front() { return (T *&)((typename base::node *)this->end_.next_)->data_; }
    void pop_back() { this->erase(typename base::iterator(this->end_.prev_)); }
    /* MSL's erase(begin()): the rdr lane's measurement puts its temporaries above the push_backs'
     * as the target's are */
    void pop_front() { this->erase(base::begin()); }

    /* the pointer list's own iterator: SOCOM 1's DWARF gives list<T *>::generic_iterator the
     * base's as its one member (i_), built from it by value (0x210C90 in the demo) and turned
     * back into it (0x200B90). Its assignment stays implicit -- a bitwise copy (lwc1/swc1),
     * after which MW keeps the iterator in memory: an iterator assigned from begin() is
     * re-read and re-stored at every step, as CZNewHudMap's finders do (one initialised from it
     * lives in a register). The const one is not here yet (CEntityItr::Advance compares with the
     * const end(), SOCOM 1's list<T *>::generic_iterator<1>) */
    template <bool IsConst, class A, class B>
    struct select {
        typedef A type;
    };
    template <class A, class B>
    struct select<false, A, B> {
        typedef B type;
    };

    template <bool IsConst>
    class generic_iterator {
        typedef typename select<IsConst, typename base::const_iterator,
                                typename base::iterator>::type base_iterator;

    public:
        generic_iterator() {}
        generic_iterator(base_iterator i) : i_(i) {}
        /* user-declared (SOCOM II's 0x510BD0: `lw v1,0(a1); move v0,a0; sw v1,0(a0)`, the copy
         * ai::PathPlanExecute hands the list's insert) */
        generic_iterator(const generic_iterator &x) : i_(x.i_) {}
        operator base_iterator() const { return i_; }
        /* the element by reference, but a const_iterator's by value: GetEntity reloads it after
         * strcasecmp, where a reference kept the element's address in a saved register.
         * Measured (round 7): by value for the plain iterator too, CZWeaponList::GetWeapon and
         * CZAmmoList::GetAmmo match (the element re-read after strcmp), but CGNode::FindEdge and
         * CGraph::FindEdge are lost and four units stop building (they assign through it:
         * ai_events.cpp, ent_main.cpp, node_assetlib.cpp, valve_list.cpp).
         * Measured again (2026-10-25, the MSL lane, round 2): no one form serves both families.
         * FindEdge needs the reference -- its second `*i` (the return) reuses the value the first
         * loaded, which a by-value read never does, not even with no call between -- while GetWeapon
         * wants the element re-read off the iterator after its calls; the two read their elements
         * through the same iterator, so one family's source differs from the other's in the
         * original. The reference stays, and a walk that re-reads after a call casts the element
         * out by value through the base iterator, `(T *)*it.i_` (GetWeapon, GetAmmo, CAckList::
         * FindPacket). Tried and dropped: a functional cast, a cast of the address, the node read
         * directly, a copy of the base iterator (by a local or a temporary: SerializeValves 39 ->
         * 26 lines off, still an address kept for its third read), a user-declared copy constructor
         * (no change) or copy assignment (the iterator leaves memory: every walk shrinks).
         * SerializeValves and CSched_Manager::RemoveTask(name) stay open: the target re-reads the
         * iterator itself after each call, as if it were visible to the callee (an escape probe --
         * the iterator's address passed out -- does give that), and no form tried makes MW think so */
        typedef typename select<IsConst, T *, T *&>::type reference;
        reference operator*() const { return (reference)*i_; }
        generic_iterator &operator++()
        {
            ++i_;
            return *this;
        }
        /* the copy, the step, the copy given back (SOCOM II's 0x510BE0 for list<CAiPath *>) */
        generic_iterator operator++(int)
        {
            generic_iterator tmp(*this);

            ++*this;
            return tmp;
        }
        bool operator==(const generic_iterator &x) const { return i_ == x.i_; }
        bool operator!=(const generic_iterator &x) const { return i_ != x.i_; }

        base_iterator i_;
    };
    typedef generic_iterator<false> iterator;
    typedef generic_iterator<true> const_iterator;

    /* the first node read through a reference to the sentinel, as the base's begin() reads it:
     * &end_.next_ is computed once and shared with the clear()s and the destructor after a walk
     * (CValve's destructor keeps it in s0 from its walk on). The sentinel held in a local keeps its
     * address computed first and shared with end()'s (CZNewHudMap::FindMPBombItem loads the first
     * node into the register `this` leaves -- straight from end_.next_ it took another), and a walk
     * that assigns begin() to its iterator, a level deeper, still inlines all of it (through the
     * base's begin(), or with tail() as an argument, the innermost constructor is a call). Through
     * tail() into a pointer local (the form before 2026-10-25) the walk's address was not shared */
    iterator begin()
    {
        typename base::node_base &t = this->end_;

        return iterator(typename base::iterator(t.next_));
    }
    iterator end() { return iterator(typename base::iterator(&this->end_)); }
    /* the const walks' begin(), written as begin(): the sentinel through tail() in a local, the
     * base's const_iterator built here (through the base's begin() const, a level deeper, the
     * innermost constructor is a call where a walk assigns it -- CEntity::TickAll) */
    const_iterator begin() const
    {
        const typename base::node_base *t = this->tail();

        return const_iterator(typename base::const_iterator(t->next_));
    }
    const_iterator end() const { return const_iterator(typename base::const_iterator(this->tail())); }
    /* the value linked in before position through the base's insert, the base's iterator it gives
     * back wrapped (SOCOM II's 0x510B90 for list<CAiPath *>: position converted to a base iterator
     * on the stack, the reference passed on as it is). After the wrapper's iterator: declared
     * before it, `iterator` would still name the base's */
    iterator insert(iterator position, T *const &x)
    {
        return iterator(base::insert(position, (const void *const &)x));
    }
};

}

#endif
