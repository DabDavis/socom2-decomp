/* <iterator>: the iterator tags MSL's containers dispatch on (empty classes, passed by value). */
#ifndef _MSL_ITERATOR
#define _MSL_ITERATOR

namespace std {

struct input_iterator_tag {};
struct output_iterator_tag {};
struct forward_iterator_tag : public input_iterator_tag {};
struct bidirectional_iterator_tag : public forward_iterator_tag {};
struct random_access_iterator_tag : public bidirectional_iterator_tag {};

/* what an iterator walks and how far apart two are (MSL's; the heap functions read them: the class
 * vectors' iterators carry the two typedefs, a pointer has its own), and its category (remove_if's
 * search dispatches on it: include/algorithm -- the list iterators bidirectional, the vector
 * iterators and pointers random access) */
template <class Iterator>
struct iterator_traits {
    typedef typename Iterator::difference_type difference_type;
    typedef typename Iterator::value_type value_type;
    typedef typename Iterator::iterator_category iterator_category;
};

template <class T>
struct iterator_traits<T *> {
    typedef int difference_type;
    typedef T value_type;
    typedef random_access_iterator_tag iterator_category;
};

/* a walk backwards over a bidirectional iterator, MSL's: the base iterator `current` one past the
 * element, stepped back by ++ and read through a copy stepped back by * (the list's rbegin()/rend()) */
template <class Iterator>
class reverse_iterator {
public:
    typedef Iterator iterator_type;
    typedef typename iterator_traits<Iterator>::difference_type difference_type;
    typedef typename iterator_traits<Iterator>::value_type value_type;
    typedef typename iterator_traits<Iterator>::iterator_category iterator_category;

    reverse_iterator() {}
    explicit reverse_iterator(Iterator x) : current(x) {}
    Iterator base() const { return current; }
    value_type &operator*() const
    {
        Iterator tmp = current;

        return *--tmp;
    }
    reverse_iterator &operator++()
    {
        --current;
        return *this;
    }
    reverse_iterator &operator--()
    {
        ++current;
        return *this;
    }

protected:
    Iterator current;
};

template <class Iterator>
inline bool operator==(const reverse_iterator<Iterator> &x, const reverse_iterator<Iterator> &y)
{
    return x.base() == y.base();
}

template <class Iterator>
inline bool operator!=(const reverse_iterator<Iterator> &x, const reverse_iterator<Iterator> &y)
{
    return x.base() != y.base();
}

/* a pointer range's length, MSL's way: through the random-access helper and its tag */
template <class T>
inline int __distance(const T *first, const T *last, random_access_iterator_tag)
{
    return last - first;
}

template <class T>
inline int distance(const T *first, const T *last)
{
    return __distance(first, last, random_access_iterator_tag());
}

}

#endif
