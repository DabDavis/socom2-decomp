/* <vector>: just enough of Metrowerks' MSL C++ std::vector (CodeWarrior PS2 3.0) to give the
 * matched functions their code. A reconstruction, not MSL: the class shapes are SOCOM 1's DWARF
 * (vector : __vector_imp : __vector_deleter, the allocator folded into capacity_'s
 * compressed_pair at 0, size_ at 4, data_ at 8), the member bodies are whatever compiles to the
 * shipped bytes.
 *
 * A vector of pointers is __vector_imp<T *, allocator<T *>, 1> (the flag in the name of SOCOM 1's
 * zdb::CNodeVector base destructor), and every one of them runs on the one implementation,
 * __vector_pod<unsigned int>: SOCOM 1's push_back, reserve and insert of it are the only ones a
 * pointer vector calls, and SOCOM II's CZAnimExVector::Add calls the same two out of line
 * (reserve 0x1EEBA0, insert 0x1FE340 -- the demo's calls, fprintf/abort/new/delete, alike).
 *
 * The iterators are classes, != being !(==): a walk whose whole test is the compare
 * materialises it (LoadZAR, CZAnimSet::Reset), one inside && branches on it
 * (GetDatabaseNode).
 *
 * A vector of pointers makes its iterators out of its base's: begin() and end() are a member
 * that takes __vector_pod's raw pointer by reference and returns the iterator (SOCOM II's
 * 0x1EA8B0: a hidden return, `this`, the pointer's address -- the name __iter is ours), applied
 * to __vector_pod's own begin() and end() (0x1EA8C0 and 0x1EA890, SOCOM 1's begin__/end__ of
 * __vector_pod<Ui> word for word); the base's begin() reads through data(), the reference, and
 * the pointer vector's begin() takes it into a const local before handing it on (where
 * SetDynamicLight inlines begin() one level, it calls the base's begin() and then __iter).
 * CNode::SetNodeEx inlines itself twice and func_00319C90 itself once, and where MW stops
 * inlining their copies call every piece of it out of line -- begin, end, ==, !=, *, both ++,
 * and the iterator's implicit copy constructor (0x313450), which the postfix ++ (the copy, the
 * prefix ++, the copy out: 0x313460) uses. What the depth does to the matched walks:
 *   - a walk's first test (begin against begin + size) stays a compare: MW folded it into a
 *     test of the size when begin() was one level, and every walk held a const_iterator to
 *     stop it (GetLandmarkFarPlane, LoadZAR, CZAnimSet's, FindClones: plain iterators now);
 *   - an iterator initialised from begin() inlines all of it, one assigned from begin() leaves
 *     data() a call (the assignment is a level more): CNode::FindChild's second walks declare
 *     an iterator of their own, and the by-name one keeps &data_ in a register for it;
 *   - back() is the base's, cast (through end() it would be a level taller than
 *     CZAR::GetOpenKey's inlining allows).
 *
 * The inline LEVELS are load-bearing (-inline level=4: a call whose callee's inline tree is at
 * most four high inlines all of it, a taller one only the callee's own body). Counted from the
 * vector down:
 *   vector of pointers  constructor 3 (vector, __vector_imp, __vector_pod)
 *                       destructor  3 (each with its this test), clear() 3
 *   vector of a class   constructor 4 (the capacity member's own constructor)
 *                       destructor  6 (__vector_deleter's clear, and its two destroy levels)
 *                       clear()     5
 * So `new CZAnimExVector` and its delete inline whole (CZAnimSet::AddAnimEx and Unload), while
 * CZAnimSetSave's implicit constructor and destructor, four high or more under its vector of
 * CPnt3D, inline only themselves and call all four vectors' (SaveNodeStates, Unload); the
 * out-of-line ~vector<CPnt3D> calls the deleter's destructor, and CZAnimSetSave::Free inlines the
 * pointer vectors' clear() but calls __vector_imp<CPnt3D>::clear(). */

#ifndef _MSL_VECTOR
#define _MSL_VECTOR

#include <iterator>
#include <memory>
#include <msl_utility>
#include <new>
#include <stdio.h>
#include <stdlib.h>

/* MSL's error report with exceptions off: the message to stderr, then abort */
#define __msl_error(str) \
    {                    \
        fprintf(stderr, str); \
        abort();         \
    }

namespace std {

/* the capacity, its own member as SOCOM 1's DWARF has it (a compressed_pair with the allocator):
 * the extra constructor level a vector of a class has and a vector of pointers has not */
template <class Allocator>
class __vector_capacity {
public:
    __vector_capacity() { n_ = 0; }
    operator unsigned int() const { return n_; }

    unsigned int n_;
};

template <class T, class Allocator>
class __vector_deleter {
public:
    __vector_deleter() { size_ = 0; data_ = 0; }
    /* the elements destroyed and the count cleared in place, not through clear(): a level
     * shorter, which the class reserves' temporary needs (zanim_set.cpp's CPnt3D one) */
    ~__vector_deleter()
    {
        destroy(data_, data_ + size_);
        size_ = 0;
        if (data_)
            operator delete(data_);
    }
    void clear()
    {
        destroy(data_, data_ + size_);
        size_ = 0;
    }
    /* the elements' destructors: nothing for a trivially destructible class -- SOCOM II's MSL
     * keeps no loop for CPnt3D, where SOCOM 1's kept an empty one -- but three inline levels all
     * the same (an empty inline function still counts as one): vector<nav_package>::clear's copy
     * (0x2125C0) calls the deleter's clear (0x213590) out of line, so __vector_imp's clear is five
     * high and the deleter's four */
    static void destroy(T *first, T *last) { __destroy(first, last); }
    static void __destroy(T *first, T *last) { __destroy_trivial(first, last); }
    static void __destroy_trivial(T *, T *) {}
    static T *allocate(unsigned int n)
    {
        T *p = (T *)operator new(n * sizeof(T));
        if (!p)
            __msl_error("Memory allocation failure");
        return p;
    }
    void swap(__vector_deleter &x)
    {
        if (this != &x) {
            unsigned int c = capacity_.n_;
            capacity_.n_ = x.capacity_.n_;
            x.capacity_.n_ = c;
            T *d = data_;
            data_ = x.data_;
            x.data_ = d;
            unsigned int z = size_;
            size_ = x.size_;
            x.size_ = z;
        }
    }

    __vector_capacity<Allocator> capacity_;
    unsigned int size_;
    T *data_;
};

template <class T, class Allocator>
class __vector_pod {
public:
    __vector_pod() { capacity_ = 0; size_ = 0; data_ = 0; }
    __vector_pod(const __vector_pod &x);
    ~__vector_pod()
    {
        if (data_)
            operator delete(data_);
    }
    void clear() { size_ = 0; }
    /* the storage traded with another's: capacity, data, size, each through std::swap -- the
     * fourth level of a pointer vector's swap, which CFlashFXVector::Reset's free idiom needs
     * (its four pieces all called out of line, SOCOM II's 0x228780 among them) */
    void swap(__vector_pod &x)
    {
        if (this != &x) {
            std::swap(capacity_, x.capacity_);
            std::swap(data_, x.data_);
            std::swap(size_, x.size_);
        }
    }
    /* references to the fields (SOCOM 1 keeps out-of-line copies: data() is this + 8, cap() this) */
    T *&data() { return data_; }
    unsigned int &cap() { return capacity_; }
    /* the raw iterators a vector of pointers makes its own from */
    T *begin() { return data(); }
    T *end() { return data_ + size_; }
    T &back() { return *(end() - 1); }
    static unsigned int max_size() { return (unsigned int)-1 / sizeof(T); }
    static T *allocate(unsigned int n)
    {
        T *p = (T *)operator new(n * sizeof(T));
        if (!p)
            __msl_error("Memory allocation failure");
        return p;
    }
    void reserve(unsigned int n);
    void insert(T *position, unsigned int n, const T &x);
    T *erase(T *first, T *last);
    T &at(unsigned int n);
    template <class InputIterator>
    void init(InputIterator first, InputIterator last, forward_iterator_tag);
    void push_back(const T &x) { insert(data_ + size_, 1, x); }
protected:
    unsigned int capacity_;
    unsigned int size_;
    T *data_;
};

/* what every vector shows its users: the iterators and accessors over its storage (a macro, so
 * that neither kind of vector carries a class of its own for them) */
#define __MSL_VECTOR_ACCESS(ELEMENT)                                                              \
public:                                                                                         \
    typedef ELEMENT elem_t;                                                                     \
    class iterator {                                                                            \
    public:                                                                                     \
        iterator() {}                                                                           \
        iterator(elem_t *p) : m_p(p) {}                                                         \
        bool operator==(const iterator &o) const { return m_p == o.m_p; }                       \
        bool operator!=(const iterator &o) const { return !(*this == o); }                      \
        iterator &operator++() { ++m_p; return *this; }                                         \
        iterator operator++(int) { iterator t(*this); ++*this; return t; }                      \
        iterator operator-(int n) const { return iterator(m_p - n); }                           \
        elem_t &operator*() const { return *m_p; }                                              \
                                                                                                \
        elem_t *m_p;                                                                            \
    };                                                                                          \
                                                                                                \
    class const_iterator {                                                                      \
    public:                                                                                     \
        const_iterator(const elem_t *p) : m_p(p) {}                                             \
        const_iterator(const iterator &i) : m_p(i.m_p) {}                                       \
        bool operator==(const const_iterator &o) const { return m_p == o.m_p; }                 \
        bool operator!=(const const_iterator &o) const { return !(*this == o); }                \
        const_iterator &operator++() { ++m_p; return *this; }                                   \
        const elem_t &operator*() const { return *m_p; }                                        \
                                                                                                \
        const elem_t *m_p;                                                                      \
    };                                                                                          \
                                                                                                \
    unsigned int size() const { return this->size_; }                                           \
    unsigned int capacity() const { return this->capacity_; }                                   \
    bool empty() const { return this->size_ == 0; }                                             \
    elem_t &operator[](unsigned int n) { return ((elem_t *)this->data_)[n]; }                   \
    void pop_back() { this->size_--; }

template <class T, class Allocator, bool IsPOD>
class __vector_imp : public __vector_deleter<T, Allocator> {
    __MSL_VECTOR_ACCESS(T)
    iterator begin() { return iterator(this->data_); }
    iterator end() { return iterator(this->data_ + this->size_); }
    T &back() { return *(end() - 1); }
    void clear() { __vector_deleter<T, Allocator>::clear(); }
    static unsigned int max_size() { return (unsigned int)-1 / sizeof(T); }
    T &at(unsigned int n);
    void reserve(unsigned int n);
    T *insert(T *position, unsigned int n, const T &x);
    void push_back(const T &x) { insert(this->data_ + this->size_, 1, x); }
    /* the range erased: out of line over raw pointers (SOCOM 1's erase__...FP7CTargetP7CTarget,
     * SOCOM II's 0x2A19C0), the iterators' copies handed to it by an inline wrapper (CTargetList::
     * RemoveTarget) */
    T *erase(T *first, T *last);
    iterator erase(iterator first, iterator last) { return iterator(erase(first.m_p, last.m_p)); }
};

template <class T, class Allocator>
class __vector_imp<T *, Allocator, true> : public __vector_pod<unsigned int, allocator<unsigned int> > {
    typedef __vector_pod<unsigned int, allocator<unsigned int> > __base;
    __MSL_VECTOR_ACCESS(T *)
    iterator __iter(unsigned int *const &p) { return iterator((elem_t *)p); }
    /* the base's pointer held in a const local first: begin() is three high so (SetDynamic and
     * SetUseParentBBoxTree assign it to a declared iterator and inline it whole in their outer
     * copies), while data()'s reference survives for CNode::FindChild by name to keep &data_ in a
     * register. Passed straight to __iter, the call would sit a level deeper; a plain local
     * swaps two of SetDynamic's registers */
    iterator begin()
    {
        unsigned int *const p = __base::begin();

        return __iter(p);
    }
    iterator end() { return __iter(__base::end()); }
    /* the base's, cast: through end() it would be a level taller (CZAR::GetOpenKey inlines it) */
    T *&back() { return (T *&)__base::back(); }
    iterator erase(iterator first, iterator last)
    {
        return __iter(__base::erase((unsigned int *)first.m_p, (unsigned int *)last.m_p));
    }
    void clear() { __vector_pod<unsigned int, allocator<unsigned int> >::clear(); }
    void swap(__vector_imp &x) { __base::swap(x); }
    T *&at(unsigned int n)
    {
        return (T *&)__vector_pod<unsigned int, allocator<unsigned int> >::at(n);
    }
    void push_back(T *const &x)
    {
        __vector_pod<unsigned int, allocator<unsigned int> >::push_back((const unsigned int &)x);
    }
};

/* A vector of a 4-byte scalar (float, int, unsigned int) runs on __vector_pod<unsigned int> too,
 * as the pointer vectors do: SOCOM 1's CSndGroup reads its weights through that data() and SOCOM
 * II's LoadCSndGroup pushes them with its insert (0x1FE340), CSnd's reverb tables likewise; the
 * destructor is three this-tested levels (0x348270), no size cleared, and clear() is the store.
 * An element is read through data()'s reference. No other unit has such a vector */
#define __MSL_VECTOR_SCALAR(T)                                                                    \
    template <class Allocator>                                                                  \
    class __vector_imp<T, Allocator, true> : public __vector_pod<unsigned int, allocator<unsigned int> > { \
        typedef __vector_pod<unsigned int, allocator<unsigned int> > __base;                    \
                                                                                                \
    public:                                                                                     \
        unsigned int size() const { return this->size_; }                                       \
        unsigned int capacity() const { return this->capacity_; }                               \
        T &operator[](unsigned int n) { return ((T *)__base::data())[n]; }                      \
        void push_back(const T &x) { __base::push_back((const unsigned int &)x); }              \
    };                                                                                          \
    template <class Allocator>                                                                  \
    class vector<T, Allocator> : public __vector_imp<T, Allocator, true> {                      \
    };

/* the bounds-checked element reads, out of line (a template member defined outside its class is
 * never auto-inlined here): each unit that calls one emits its copy, with its own message */
template <class T, class Allocator>
T &__vector_pod<T, Allocator>::at(unsigned int n)
{
    if (n >= size_)
        __msl_error("vector::at index out of range");
    return data_[n];
}

/* the copy: the other's elements copied in, by the range init (SOCOM 1 links both, the copy at
 * the same 0x4C as SOCOM II's 0x259B40; init's error and allocation now inline in it) */
/* the tail moved down over the range (SOCOM 1's erase__ of __vector_pod<Ui>, line for line; MW
 * 3.0 unrolls the copy 8x, its walker a local). The source walker is declared first and the
 * destination initialised first: their registers and their moves' order each follow one */
template <class T, class Allocator>
T *__vector_pod<T, Allocator>::erase(T *first, T *last)
{
    if (first == last)
        return first;
    T *e = data_ + size_;

    if (e - last) {
        T *s, *d = first;

        for (s = last; s < e; ++s, ++d)
            *d = *s;
    }
    size_ -= last - first;
    return first;
}

template <class T, class Allocator>
__vector_pod<T, Allocator>::__vector_pod(const __vector_pod &x)
{
    capacity_ = 0;
    size_ = 0;
    data_ = 0;
    init((const T *)x.data_, (const T *)x.data_ + x.size_, forward_iterator_tag());
}

template <class T, class Allocator>
template <class InputIterator>
void __vector_pod<T, Allocator>::init(InputIterator first, InputIterator last, forward_iterator_tag)
{
    size_ = cap() = last - first;
    if (size_ > max_size())
        __msl_error("vector length error\n");
    if (size_) {
        data() = allocate(size_);
        T *d = data_;

        /* a local walks the range: MW unrolls a loop 8x on a local, never on a parameter */
        for (InputIterator p = first; p < last; ++p, ++d)
            *d = *p;
    }
}

/* reserve: the old elements copied into a fresh block -- word by word for the POD storage, by
 * copy construction into a temporary deleter, swapped in, for a class */
template <class T, class Allocator>
void __vector_pod<T, Allocator>::reserve(unsigned int n)
{
    if (n > cap()) {
        if (n > max_size())
            __msl_error("vector::reserve length error\n");
        T *old = data_;

        data() = allocate(n);
        if (old) {
            T *last = old + size_;

            for (T *p = old, *d = data_; p < last; ++p, ++d)
                *d = *p;
            operator delete(old);
        }
        cap() = n;
    }
}

template <class T, class Allocator, bool IsPOD>
void __vector_imp<T, Allocator, IsPOD>::reserve(unsigned int n)
{
    if (n > this->capacity_) {
        if (n > max_size())
            __msl_error("vector::reserve length error\n");
        __vector_deleter<T, Allocator> temp;

        temp.data_ = temp.allocate(n);
        temp.capacity_.n_ = n;
        T *d = temp.data_;
        T *p = this->data_;
        T *last = p + this->size_;

        for (; p < last; ++p, ++d) {
            new (d) T(*p);
            temp.size_++;
        }
        temp.swap(*this);
    }
}

/* the tail moved down over the range by assignment, as the POD storage's erase does it word by
 * word (the source walker declared first, the destination initialised first) */
template <class T, class Allocator, bool IsPOD>
T *__vector_imp<T, Allocator, IsPOD>::erase(T *first, T *last)
{
    if (first == last)
        return first;
    T *e = this->data_ + this->size_;

    if (e - last) {
        T *s, *d = first;

        for (s = last; s < e; ++s, ++d)
            *d = *s;
    }
    this->size_ -= last - first;
    return first;
}

template <class T, class Allocator, bool IsPOD>
T &__vector_imp<T, Allocator, IsPOD>::at(unsigned int n)
{
    if (n >= this->size_)
        __msl_error("vector::at index out of range");
    return this->data_[n];
}

template <class T, class Allocator = allocator<T> >
class vector : public __vector_imp<T, Allocator, false> {
public:
    void clear() { __vector_imp<T, Allocator, false>::clear(); }
};

__MSL_VECTOR_SCALAR(float)
__MSL_VECTOR_SCALAR(int)
__MSL_VECTOR_SCALAR(unsigned int)

template <class T, class Allocator>
class vector<T *, Allocator> : public __vector_imp<T *, Allocator, true> {
public:
    void clear() { __vector_imp<T *, Allocator, true>::clear(); }
    void swap(vector &x) { __vector_imp<T *, Allocator, true>::swap(x); }
};

}

#endif
