/* <vector>: just enough of Metrowerks' MSL C++ std::vector (CodeWarrior PS2 3.0) to give the
 * matched functions their code. A reconstruction, not MSL: the class shapes are SOCOM 1's DWARF
 * (vector : __vector_imp : __vector_deleter, the allocator folded into capacity_'s
 * compressed_pair at 0, size_ at 4, data_ at 8), the member bodies are whatever compiles to the
 * shipped bytes. A vector of pointers is __vector_imp<T *, allocator<T *>, 1> -- the flag in the
 * name of zdb::CNodeVector's base destructor.
 *
 * The iterators are classes, != being !(==): a walk whose whole test is the compare
 * materialises it (LoadZAR, CZAnimSet::Reset), one inside && branches on it
 * (GetDatabaseNode). The walks that hold a const_iterator made from begin() keep MW from
 * folding their first test (begin against begin + size) into a test of the size, which a copy
 * of begin() as an iterator does not.
 *
 * The constructor zeroes the three words one level above the deleter: MW's -inline auto stops at
 * depth 3, and CZAnimSet::AddAnimEx inlines all of `new CZAnimExVector` (CZAnimExVector, vector,
 * then the zeroing) where a zeroing deleter constructor, at depth 4, stays a call. SOCOM 1's
 * names put a vector of pointers on __vector_pod<unsigned int> -- the real chain, as deep. */

#ifndef _MSL_VECTOR
#define _MSL_VECTOR

#include <memory>

namespace std {

template <class T, class Allocator>
class __vector_deleter {
protected:
    unsigned int capacity_;
    unsigned int size_;
    T *data_;
};

template <class T, class Allocator, bool IsPOD>
class __vector_imp : public __vector_deleter<T, Allocator> {
public:
    __vector_imp() { this->capacity_ = 0; this->size_ = 0; this->data_ = 0; }
    class iterator {
    public:
        iterator(T *p) : m_p(p) {}
        bool operator==(const iterator &o) const { return m_p == o.m_p; }
        bool operator!=(const iterator &o) const { return !(*this == o); }
        iterator &operator++() { ++m_p; return *this; }
        iterator operator++(int) { iterator t = *this; ++m_p; return t; }
        iterator operator-(int n) const { return iterator(m_p - n); }
        T &operator*() const { return *m_p; }

        T *m_p;
    };

    class const_iterator {
    public:
        const_iterator(const T *p) : m_p(p) {}
        const_iterator(const iterator &i) : m_p(i.m_p) {}
        bool operator==(const const_iterator &o) const { return m_p == o.m_p; }
        bool operator!=(const const_iterator &o) const { return !(*this == o); }
        const_iterator &operator++() { ++m_p; return *this; }
        const T &operator*() const { return *m_p; }

        const T *m_p;
    };

    iterator begin() { return iterator(this->data_); }
    iterator end() { return iterator(this->data_ + this->size_); }
    unsigned int size() const { return this->size_; }
    bool empty() const { return this->size_ == 0; }
    T &back() { return *(end() - 1); }
    void pop_back() { this->size_--; }
};

template <class T, class Allocator = allocator<T> >
class vector : public __vector_imp<T, Allocator, false> {
};

template <class T, class Allocator>
class vector<T *, Allocator> : public __vector_imp<T *, Allocator, true> {
};

}

#endif
