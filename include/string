/* <string>: just enough of Metrowerks' MSL C++ std::basic_string<char> (CodeWarrior PS2 3.0, as
 * SOCOM II links it) to give the matched functions their code. A reconstruction, not MSL.
 *
 * SOCOM II's MSL is not SOCOM 1's. The May 2002 demo's DWARF (C:\apps\cw301) describes the old
 * reference-counted string -- one word, a pointer to a CharArray {size_, alloc_, refcount_, data_},
 * its members out of line: assign(const char *, size_type), replace(pos, n1, n2, c), init(begin,
 * end, allocator, random_access_iterator_tag), the destructor (lines 1936-1943). SOCOM II's is
 * 12 bytes with a short form, read off the image's instances:
 *   - the long form is three words, the capacity (bit 0 set: the long form's mark), the size and
 *     the text; the short form keeps its size in the first byte's upper seven bits (0x1EEB40 reads
 *     it with a 7-bit field extract after testing bit 0 of the first WORD) and its text in place
 *     from the second byte, eleven characters with the terminator (reserve's "the short form's
 *     11 characters");
 *   - the default constructor zeroes the three words, inline, through a register holding their
 *     address (`addiu v1,sp,N; sw zero,0(v1)` x3): a loop over a reference to the word array,
 *     unrolled -- libc++'s __zero(), Hinnant's design after his MSL string (stored straight, the
 *     words are addressed off sp);
 *   - c_str() is the text pointer for the long form, the second byte's address for the short;
 *   - the destructor (0x1E7EF0, the instance closing main.cpp) is never inlined: it deletes the
 *     long form's text, then the object when asked. A local passes -1, a base subobject 0 (the
 *     menu's CSaferStr locals, as SOCOM 1's);
 *   - assign(const char *) is out of line (0x1EEB40: replace(0, size(), s), a tail call), and so
 *     is append (0x1EEB70: replace(size(), 0, s)); replace(pos, n1, const char *) (0x1EF390)
 *     hands the range s..s+strlen(s) to the template replace taking two iterators and the
 *     iterator's category, an empty class passed by value -- loaded as a byte off the stack and
 *     never stored (0x1EE780; 0x1EF400 is assign(first, last) through it). The three are this
 *     header's out-of-class members since the MSL headers round 5 (body.cpp's, fts_patch.cpp's and
 *     five more units' tails emit them byte-exact; OVL2's copies 0x53FAA0 and 0x540B50), the
 *     placeholders kept for the units that still call them by address;
 *   - reserve, the template replace and assign(first, last) are MSL 3.0's own statements (the MSL
 *     headers round 21, from MAIN's runtime round 7: src/main/msl/msl.h builds the prebuilt library's
 *     copies, exceptions on, from the same source): out of class, each user's tail emits them --
 *     OVL1 0x1E7C90 / 0x1EE780 / 0x1EF400 and OVL2 0x541290 / 0x540D00 / 0x541240 byte-exact from 25
 *     units' tails (+5 over every hand-written unit, nothing lost by address; build/p21/s1.cpp, a
 *     probe of one string built and destroyed, gives all six). They need the class's MSL shape: the
 *     allocator a private (empty) base -- allocate/deallocate through `this` --, size_type
 *     `typename Allocator::size_type`, and the long form a struct of size_type bit-fields in the
 *     union (a dependent bit-field keeps word access: the mark's stores are lw/and/or/sw, where an
 *     `unsigned int` field narrows them to bytes). The replace inlines its temporary's destructor only
 *     where the unit generated the destructor first: hud_scorepopup.cpp's and util_stable.cpp's
 *     copies, requested before anything there destroys a string, call it (`elsewhere`: OVL1's linked
 *     copy is another unit's), and hud_scorepopup.cpp's ~CSaferStr, generated after, inlines it
 *     (`elsewhere` too: 0x1E7A50 is main.cpp's, which still matches);
 *   - fts_state.h keeps its own basic_string (the MSL headers round 5): its default constructor is
 *     four inline levels high (init, clear_words, zero), as the states fitted it, and include/string's
 *     at four (zero() a member looping over a reference local) cost nothing over every hand-written
 *     unit until the UI lane's round 6 -- then zui_spec.cpp's GetControlSpec 0x382890 (0x2CC against
 *     0x304) -- so this header stays two high and fts_state.h apart; st_core.cpp's stand-ins under
 *     the placeholders scored the members' rows by address (its func_001EF400 has no row since round
 *     21 named 0x1EF400: the other units' copies match it);
 *   - erase() is that template replace over (0, npos) with an empty range of const char *, inline
 *     (SetString__16C2DMessageStringFPCc, the menu's string handlers);
 *   - the copies, out of class (the MSL lane, 2026-10-25; each byte-exact): the copy constructor
 *     (0x22E560) copies a short form's three words whole (lwc1/swc1, a struct of a word array) and
 *     builds a long one through reserve and the template replace; the copy assignment (0x22E4D0)
 *     copies when both are short -- its first test `is_long() == false`, which keeps the bool's
 *     sltu for size() to reuse -- else replace(0, size(), str) (0x22E690: one is_long test picks
 *     the text and the size, short form first); push_back(char) (0x284B40) replaces the empty range
 *     at the end with the character itself, its address taken. zrdr_parse.cpp's CRdrIO::Open
 *     assigns through the operator, and its tail emits 0x22E4D0 and 0x22E690.
 *   - compare, out of class (the MSL headers round 5; both byte-exact as probes, OVL1 0x2DEE30 and
 *     0x2DF030, OVL2's copies 0x58D250 and 0x58D740): compare(str) takes the other's text and size in
 *     ONE short-first test (two inline accessors keep two tests: MW does not merge them), this size()
 *     after, and tail-jumps to compare(pos1, n1, s, n2) -- SOCOM 1's CFUiUiPCcUi over the old string,
 *     the same code: "string compare: pos > len", min(size - pos1, n1) through MSL's by-reference
 *     min (`b < a ? b : a`, so the count's and the temporary's addresses are taken), memcmp, then
 *     `if (len < n2) return -1; if (len != n2) return 1; return 0;` inside `if (result == 0)` (the
 *     only shape of fourteen with the target's branch to the exit and its pad). operator< is inline,
 *     `lhs.compare(rhs) < 0`: every string-keyed tree's comparator calls 0x2DEE30 and tests the sign
 *     (less<string> over the map's value_compare, as SOCOM 1's map<CSaferStr,...> inlines it). The
 *     trees' tail code inlines the destructor (find_or_insert's temporary pair) where the unit's own
 *     code generated it first. Not pinned (the UI lane's round 6 request: resize<CDesignDlgObj> 0x383960
 *     inlines it for its temporary's two strings): an out-of-class member is never inlined into the
 *     units' own functions anyway, and removing `#pragma auto_inline off` moved nothing over every
 *     hand-written unit (the MSL headers round 5).
 * Every member calls the map's names now; func_001EE780 stays declared for the units that call the
 * template replace by its placeholder (zrdr_parse.cpp: a call resolves by address whatever the row is
 * later named). */

#ifndef _MSL_STRING
#define _MSL_STRING

#include <iterator>
#include <memory>
#include <msl_utility>
#include <string.h>

namespace std {

template <class charT> struct char_traits {};

/* the character compare the string's compare runs (memcmp, called out of line), and the copies,
 * moves and stores reserve and the template replace make (memcpy, memmove, a plain store) */
template <>
struct char_traits<char> {
    typedef char char_type;

    static int compare(const char *s1, const char *s2, unsigned int n) { return memcmp(s1, s2, n); }
    static void assign(char_type &c1, const char_type &c2) { c1 = c2; }
    static char_type *copy(char_type *s1, const char_type *s2, unsigned int n)
    {
        memcpy(s1, s2, n);
        return s1;
    }
    static char_type *move(char_type *s1, const char_type *s2, unsigned int n)
    {
        memmove(s1, s2, n);
        return s1;
    }
};

/* the template replace's placeholder, for the units that still call it by address (zrdr_parse.cpp's
 * string_erase, found through the tag's namespace): the header's own members call the member
 * template, replace<const char *> (OVL1 0x1EE780) */
extern "C" {
void *func_001EEB40(void *str, const char *s);   /* assign(const char *) */
void *func_001EEB70(void *str, const char *s);   /* append(const char *) */
void *func_001EE780(void *str, unsigned int pos, unsigned int n1, const char *first, const char *last,
                    forward_iterator_tag);   /* replace(pos, n1, first, last, category) */
}

template <class charT, class traits = char_traits<charT>, class Allocator = allocator<charT> >
class basic_string : private Allocator {
public:
    /* dependent, as MSL's: the long form's bit-fields are declared size_type, and MW narrows a
     * bit-field's access to a byte only when its declared type is not template-dependent -- the
     * mark's tests and stores in reserve and the template replace are words (lw/sw), the short
     * form's `unsigned char` size a byte (MAIN's runtime round 7, build/scratch/rt-r7/bf4.cpp) */
    typedef typename Allocator::size_type size_type;
    enum { npos = -1 };

    basic_string() { init(); }
    basic_string(const charT *s);
    basic_string(const charT *s, size_type n);
    basic_string(const basic_string &str);
    /* a substring's copy, with and without an allocator (out of class, below) */
    basic_string(const basic_string &str, size_type pos, size_type n = npos);
    basic_string(const basic_string &str, size_type pos, size_type n, const Allocator &a);
    ~basic_string();

    basic_string &operator=(const charT *s) { return assign(s); }
    /* inline over assign(str), as SOCOM 1's MSL has it (its 0xC-byte __as__ and assign(const
     * basic_string &) wrappers): a tail that cannot inline it calls this copy, `j assign` (the world
     * lane's round 4: zrdr_parse.cpp's 0x32FD70, the symbol copies' member assignment). Applied by
     * the AI core's round 17: +5 over every hand-written unit, nothing lost; an element's implicit
     * assignment inlines it and calls assign, so OVL2's copy 0x5410C0 is marked assign's and
     * do_assign<LOD> 0x53F730 holds unchanged */
    basic_string &operator=(const basic_string &str) { return assign(str); }
    basic_string &assign(const basic_string &str);
    basic_string &assign(const charT *s);
    basic_string &assign(const charT *s, size_type n);
    basic_string &append(const charT *s);
    basic_string &operator+=(const charT *s) { return append(s); }
    basic_string &erase()
    {
        forward_iterator_tag category;

        return replace(0, (size_type)npos, (const charT *)0, (const charT *)0, category);
    }
    /* n characters from pos erased: the same template replace over (pos, n) (the UI lane's round 21:
     * the soft keyboard's backspace 0x398C40 calls it so; additive) */
    basic_string &erase(size_type pos, size_type n)
    {
        forward_iterator_tag category;

        return replace(pos, n, (const charT *)0, (const charT *)0, category);
    }

    size_type max_size() const { return 0x7FFFFFFE; }
    void reserve(size_type res_arg = 0);
    /* the whole text replaced by a range (OVL1 0x1EF400, OVL2 0x541240): the template replace over
     * (0, size()), a tail call through a 32-byte frame. The pointer is MSL's restriction to
     * iterator types (its type unknown: Pv in the image's name), passed 0 and never read */
    template <class InputIterator>
    basic_string &assign(InputIterator first, InputIterator last, void * = 0);
    /* n1 characters at pos replaced by the range j1..j2, the range's category an empty class by
     * value (OVL1 0x1EE780, OVL2 0x540D00) -- every replace, assign, append, push_back, erase and
     * constructor of the string comes here */
    template <class ForwardIterator>
    basic_string &replace(size_type pos, size_type n1, ForwardIterator j1, ForwardIterator j2,
                          forward_iterator_tag);
    basic_string &replace(size_type pos, size_type n1, const basic_string &str);
    basic_string &replace(size_type pos, size_type n1, const charT *s);
    basic_string &replace(size_type pos1, size_type n1, const basic_string &str, size_type pos2, size_type n2);
    /* a substring (the world lane's round 9: 0x32FC40, `j` the allocator constructor with the
     * string itself as the allocator's reference -- the allocator an empty base at 0 in MSL) */
    basic_string substr(size_type pos = 0, size_type n = npos) const
    {
        return basic_string(*this, pos, n, *(const Allocator *)this);
    }
    void push_back(charT c);
    int compare(const basic_string &str) const;
    int compare(size_type pos1, size_type n1, const charT *s, size_type n2) const;
    /* the character searches (out of class, see below) */
    size_type find_first_of(const basic_string &str, size_type pos = 0) const;
    size_type find_first_of(const charT *s, size_type pos, size_type n) const;
    size_type find_first_of(const charT *s, size_type pos = 0) const;
    size_type find_last_of(const charT *s, size_type pos, size_type n) const;
    size_type find_last_of(const charT *s, size_type pos = npos) const;
    size_type find_first_not_of(const basic_string &str, size_type pos = 0) const;
    size_type find_first_not_of(const charT *s, size_type pos, size_type n) const;
    size_type find_first_not_of(const charT *s, size_type pos = 0) const;
    size_type find_last_not_of(const charT *s, size_type pos, size_type n) const;
    size_type find_last_not_of(const charT *s, size_type pos = npos) const;
    charT &at(size_type pos);

    bool is_long() const { return w_[0] & 1; }
    /* the short form's size cast back to its byte (0x2CA700, the copy closing fts_patch.cpp,
     * masks it) */
    size_type size() const { return is_long() ? w_[1] : (unsigned char)s_.size_; }
    /* a character (0x2CA6E0) */
    charT &operator[](size_type pos) { return (is_long() ? (charT *)w_[2] : s_.data_)[pos]; }
    /* short form first: the hoisted text addresses take the target's registers (CSaveManager::Load's
     * s7/s8, the rdr lane's round 4; nothing lost over every hand-written unit).
     * OPEN (the MSL headers round 9, build/p9/v_lm*.txt over fts_message.cpp): LastMessage 0x2B6D60
     * wants the short-form test as a stored, negated, narrowed bool (`sltu; xori 1; andi 0xff;
     * beqz`) and a `b` joining the two forms. Through a helper `bool short = (is_long() == false)`
     * the target's sltu appears and the function grows 0x68 -> 0x70 (of 0x78), the branch then
     * `bnez` on the un-negated bool; `!is_long()` in a bool helper, a second bool level, a bool
     * local, `? false : true`, a bool parameter of an inline picker, data() over c_str() and an
     * if/else body all stay at 0x68 -- c_str() itself unchanged */
    const charT *c_str() const { return !is_long() ? s_.data_ : (const charT *)w_[2]; }
    const charT *data() const { return c_str(); }

private:
    /* the three words as one aggregate: the short form copied whole (lwc1/swc1, as MW copies a
     * struct holding a word array) */
    struct rep_words {
        unsigned int w[3];
    };
    void copy_rep(const basic_string &str) { *(rep_words *)w_ = *(const rep_words *)str.w_; }
    /* the long form's size BY REFERENCE (the MSL headers round 18, the UI's request): the copy
     * constructor reads it through this. Its inlined reference temporary folds into the loads where
     * the string is the function's own parameter (the out-of-line copy 0x22E560, a member at offset
     * 0) and stays a variable where the string is an inlined argument at an offset -- the target's
     * `addiu s3,s1,16` kept across reserve in CDlgDesignModel's copy 0x3854C0, byte-exact so (+1,
     * nothing lost). A reference local does it at every site (0x22E560 then 0x9C), a by-reference
     * helper parameter or a reference to the word array renumbers the rest */
    const size_type &long_size() const { return w_[1]; }

    void init()
    {
        unsigned int (&a)[3] = w_;

        for (unsigned int i = 0; i < 3; ++i)
            a[i] = 0;
    }

    /* the long form: the mark in bit 0 of the capacity's word, the size, the text (reserve and the
     * template replace read and write it through these; the older members through w_) */
    struct long_rep {
        size_type is_long_ : 1;
        size_type cap_ : 31;
        size_type size_;
        charT *data_;
    };
    /* the short form: the mark and the size in the first byte, the text after it */
    struct short_rep {
        unsigned char is_long_ : 1;
        unsigned char size_ : 7;
        charT data_[11];
    };

    union {
        unsigned int w_[3];   /* the long form: capacity | 1, size, text */
        long_rep l_;
        short_rep s_;
    };
};

/* MSL 3.0's string internals, the game's build of them (exceptions off: the checks report through
 * __msl_error where the prebuilt library throws -- src/main/msl/msl.h holds the library's build of the
 * same statements, MAIN 0x18D8C0 / 0x18D3E0 / 0x18DB40). Out of class: each user's template tail
 * emits them, OVL1's copies 0x1E7C90 / 0x1EE780 / 0x1EF400 (main.cpp's and st_core.cpp's: those units
 * hold fts_state.h's string, so other units' copies score them), OVL2's 0x541290 / 0x540D00 / 0x541240
 * (char_type.cpp's tail). The replace inlines its temporary's destructor where the unit generated the
 * destructor first, as every string user does (0x1EE780's `jal __dl__FPv` on the frame's long text) */

/* room for res_arg characters (OVL1 0x1E7C90): the capacity rounded up to a multiple of 16, or the
 * short form's 11, the text moved to the new room -- shrinking, an allocation that fails leaves the
 * string as it was (the library's try: the game's build tests the result) */
template <class charT, class traits, class Allocator>
void basic_string<charT, traits, Allocator>::reserve(size_type res_arg)
{
    if (res_arg > max_size())
        __msl_error("basic_string::reserve length_error");
    size_type cap, sz;
    charT *new_data, *old_data;
    bool now_long;
    bool is_long = w_[0] & 1;
    if (!is_long) {
        cap = 11;
        sz = (unsigned char)s_.size_;
    } else {
        sz = l_.size_;
        cap = l_.cap_;
    }
    if (res_arg < sz)
        res_arg = sz;
    if (res_arg + 1 < 12)
        res_arg = 11;
    else
        res_arg = (res_arg + 16) & ~15;
    if (res_arg == cap)
        return;
    if (res_arg == 11) {
        old_data = l_.data_;
        new_data = s_.data_;
        now_long = false;
    } else {
        if (cap < res_arg)
            new_data = this->allocate(res_arg);
        else {
            new_data = this->allocate(res_arg);
            if (new_data == 0)
                return;
        }
        now_long = true;
        old_data = is_long ? l_.data_ : s_.data_;
    }
    traits::copy(new_data, old_data, sz);
    new_data[sz] = charT();
    if (is_long)
        this->deallocate(old_data, cap);
    l_.is_long_ = now_long;
    if (!now_long)
        s_.size_ = sz;
    else {
        l_.data_ = new_data;
        l_.size_ = sz;
        l_.cap_ = res_arg;
    }
}

template <class charT, class traits, class Allocator>
template <class InputIterator>
basic_string<charT, traits, Allocator> &basic_string<charT, traits, Allocator>::assign(InputIterator first,
                                                                                       InputIterator last, void *)
{
    forward_iterator_tag category;

    return replace(0, l_.is_long_ ? l_.size_ : (unsigned char)s_.size_, first, last, category);
}

/* the checks (a start past the end, a length past max_size()), then either a new buffer -- the head,
 * the range and the tail copied in, the capacity doubled from the old one's 16-rounding until the text
 * fits -- or the text moved in place, the range first copied out into a temporary when the tail's move
 * would overwrite it. Each piece measured in the library's build (msl.h's comment): the locals at the
 * top with the mark's bool last, the short size read before the capacity, n2 through distance by
 * value, the temporary's text read through a reference to it in an if/else */
template <class charT, class traits, class Allocator>
template <class ForwardIterator>
basic_string<charT, traits, Allocator> &basic_string<charT, traits, Allocator>::replace(size_type pos,
    size_type n1, ForwardIterator j1, ForwardIterator j2, forward_iterator_tag)
{
    charT *data;
    size_type sz, cap, xlen, n2, new_size, tail;
    bool is_long = l_.is_long_;
    if (!is_long) {
        data = s_.data_;
        sz = (unsigned char)s_.size_;
        cap = 11;
    } else {
        data = l_.data_;
        sz = l_.size_;
        cap = l_.cap_;
    }
    if (pos > sz)
        __msl_error("basic_string: out_of_range");
    xlen = min(n1, sz - pos);
    n2 = (size_type)distance(j1, j2);
    if (n2 > max_size() || sz - xlen > max_size() - n2)
        __msl_error("basic_string: length_error");
    new_size = n2 + (sz - xlen);
    tail = sz - (pos + xlen);
    if (new_size >= cap) {
        size_type newcap = (cap + 15) & ~15;
        while (newcap < new_size + 1)
            newcap = (2 * newcap + 15) & ~15;
        charT *new_data = this->allocate(newcap);
        if (pos != 0)
            traits::copy(new_data, data, pos);
        charT *p = new_data + pos;
        traits::copy(p, j1, (size_type)(j2 - j1));
        if (tail != 0)
            traits::copy(p + n2, data + pos + xlen, tail);
        traits::assign(new_data[new_size], charT());
        if (is_long)
            this->deallocate(data, cap);
        else
            l_.is_long_ = true;
        l_.data_ = new_data;
        l_.size_ = new_size;
        l_.cap_ = newcap;
    } else {
        basic_string temp;
        if (tail != 0 && data + pos + n2 < j2 && j2 <= data + sz) {
            temp.assign(j1, j2);
            const basic_string &t = temp;
            if (!t.l_.is_long_)
                j1 = t.s_.data_;
            else
                j1 = t.l_.data_;
        }
        if (tail != 0)
            traits::move(data + pos + n2, data + pos + xlen, tail);
        traits::move(data + pos, j1, n2);
        traits::assign(data[new_size], charT());
        if (!is_long)
            s_.size_ = new_size;
        else
            l_.size_ = new_size;
    }
    return *this;
}

/* from a C string (0x2396F0, the copy closing the HUD's info box unit): the words zeroed, the
 * length taken, the room reserved, the text replaced in through the template replace with its
 * category byte (out of class: called out of line, emitted in each user's template tail) */
template <class charT, class traits, class Allocator>
basic_string<charT, traits, Allocator>::basic_string(const charT *s)
{
    init();
    size_type n = strlen(s);
    forward_iterator_tag category;

    reserve(n);
    replace(0, 0, s, s + n, category);
}

/* from n characters (0x39B5B0, zui_skbkeys.cpp's tail: the keyboard's text wrap builds each word's
 * string so): the C-string constructor without the strlen (the UI lane's round 10) */
template <class charT, class traits, class Allocator>
basic_string<charT, traits, Allocator>::basic_string(const charT *s, size_type n)
{
    init();
    forward_iterator_tag category;

    reserve(n);
    replace(0, 0, s, s + n, category);
}

/* a copy (0x22E560): the short form's words copied whole, the long form's text reserved and
 * replaced into an emptied string */
template <class charT, class traits, class Allocator>
basic_string<charT, traits, Allocator>::basic_string(const basic_string &str)
{
    if (!str.is_long())
        copy_rep(str);
    else {
        init();
        reserve(str.long_size());
        forward_iterator_tag category;

        replace(0, 0, (const charT *)str.w_[2], (const charT *)str.w_[2] + str.long_size(), category);
    }
}

/* a substring's copy (the world lane's round 9: zrdr_parse.cpp's tail, 0x332320 without the
 * allocator, 0x332250 with it, the same code): the words zeroed, room for what is left after pos
 * reserved -- none when pos is past the end, which the replace then reports -- and the substring
 * replaced in through the five-argument replace */
template <class charT, class traits, class Allocator>
basic_string<charT, traits, Allocator>::basic_string(const basic_string &str, size_type pos, size_type n)
{
    init();
    size_type sz = str.size();

    reserve(pos <= sz ? min(n, sz - pos) : 0);
    replace(0, 0, str, pos, n);
}

template <class charT, class traits, class Allocator>
basic_string<charT, traits, Allocator>::basic_string(const basic_string &str, size_type pos, size_type n,
                                                     const Allocator &)
{
