/* <deque>: just enough of Metrowerks' MSL C++ std::deque (CodeWarrior PS2 3.0) to give the matched
 * functions their code. A reconstruction, not MSL: SOCOM II's deque is not SOCOM 1's (CW 3.0.1's,
 * whose DWARF puts the allocator and a run-time block size in front: alloc_, buf_, start_, size_ at
 * 0, 4, 0x14, 0x18). SOCOM II's, read off CGame's queue (OVL1 0x2CE9E0-0x2CF1C7):
 *   - the buffer of block pointers at 0 -- Metrowerks::cdeque, a circular buffer as SOCOM 1's:
 *     capacity, size, start, data at 0, 4, 8, 0xC (cdeque<PCv>::swap, 0x2F56B0, word for word
 *     SOCOM 1's) -- then start_ at 0x10 and size_ at 0x14 (CGame::Tick's front());
 *   - the block size a constant 128 (start_ >> 7, & 0x7F: 512-byte blocks of pointers);
 *   - an empty base after the 0x18 bytes, built at this + 0x18 by an out-of-line empty constructor
 *     (0x2CEE30) -- MW lays an empty base that follows a non-empty one at the end, sizeless (CGame's
 *     m_pad sits at 0x70), so the allocator is a base, as it is of the cdeque (+0x10, the same
 *     constructor in the cdeque copy constructors of four other units).
 * A deque of pointers runs on deque<const void *> (SOCOM 1's names: deque<PCv>::pop_front,
 * push_back; deque<T *> : deque<PCv> in its DWARF) and its buffer, cdeque<const void **>, on
 * cdeque<const void *> -- each through a partial specialization on const void *, which a T *
 * specialization deriving from it cannot itself match (MW would recurse into an incomplete base).
 *
 * The levels are load-bearing (written at -inline level=4; level 5 since), counted on the destructors: CGame's destructor
 * inlines four this-tested levels of its queue (CStateCmdQueue, deque<T *>, deque<PCv>,
 * __deque_imp) and calls __deque_buf's out-of-class destructor (0x2CEFB0) with 0, as a std::stack
 * member's destructor does (0x333A20); the buffer's destructor is three levels (cdeque<PPCv>,
 * cdeque<PCv>, __cdeque_buf: 0x2CEE90). Out-of-class template members are never inlined into a
 * unit's own functions and are inlined into its tail only once generated there (README): the
 * constructors' chain (0x2CEE00 -> the allocator's 0x2CEE30, __deque_buf's 0x2CEE40 -> __cdeque_buf's
 * 0x2CEE70) is all calls, and pop_front calls clear and cdeque::pop_front, while clear, generated
 * after cdeque::pop_front, inlines it. The names below the deque and the cdeque are ours.
 *
 * The MSL headers' round 7 (the copy constructor chain, probes in build/p7/): a deque's blocks are a
 * compressed pair (SOCOM 1's compressed_pair over compressed_pair_imp) of the allocator, empty, at 0
 * and the block buffer -- ~__deque_buf's teardown tests `this` five times after its loop (the pair,
 * its imp, cdeque<PPCv>, cdeque<PCv>, __cdeque_buf), and the copy constructors build the pair from
 * the allocator and a temporary buffer (0x333E00). The pointer deque's default and copy
 * constructors are out of class: the rdr editor's stack (`stack(const Container & = Container())`)
 * calls both (0x3340F0, 0x333B30), and CGame()'s queue member calls deque<CGameStateChangeCmd *>()
 * (0x2CEE00, which inlines deque<PCv>() and __deque_imp(), in class, and calls __deque_buf's
 * constructor and the allocator base's). The copy constructor of every deque (the rdr's, util_ssm's
 * 0x3A5E50, the lobby's 0x2E07B0) is `base(x.alloc())` -- an out-of-line accessor returning the pair
 * at 0, the base's constructor from an allocator (0x333D90: a rebound allocator temporary, an empty
 * buffer built from it, the pair copy-constructed from both, the temporary destroyed out of line, then
 * start_ and size_ cleared), the allocator base default-constructed (0x2CEE30) -- then x.begin(),
 * x.end() (each a make_iterator() result copied out) and init(first, last, forward_iterator_tag);
 * a pointer deque's init hands __convert_iterators (28 bytes: the 24-byte iterator and its empty
 * converter) to the const void * base's do_assign, a deque of anything else its own iterators. The
 * buffer's copy constructor (0x333E40) is the same shape one level down (16-byte iterators, 20-byte
 * converted ones). The allocator's copy constructor and its converting (rebind) constructor are out
 * of class, as SOCOM 1's (0x3340A0, 0x3340D0). OPEN, the tail's generation order (README "The
 * inlining mode, measured" and "Tells from completing the MSL headers, round 7"): the image's base
 * constructor calls the temporary's destructor (0x2CEE90) where this inlines it, the buffer's copy
 * constructor calls its begin() and the allocator base (0x2CEE30) while its constructor from an
 * allocator (0x3340B0) inlines both, make_iterator inlines the buffer's begin(); the default
 * constructors of the rdr editor, the vis unit and the lobby call a level (0x334120: the buffer and
 * start_/size_, no allocator base) that game_main.cpp's 0x2CEE00 inlines; init's parameters are
 * copied twice around two value-initialised empty temporaries (0x333BB0, 0x3A5ED0); begin()/end()
 * of the buffer build their iterator in memory, its fields addressed through registers.
 *
 * The MSL headers' round 13 (probes build/p13/, untracked): A CLASS ELEMENT IS DESTROYED, a scalar one
 * is not -- the chat lines' clear (0x2F5A30) calls make_iterator twice (end first) and a range destroy
 * (0x2F5B10, block by block, min over the count and buf_size's storage at 0x3F56D8) where the lobby's,
 * the state machine's and the pointer deques' clears have none: Metrowerks::has_trivial_dtor (an
 * is_class test MW 3.0 compiles) picks it at compile time; 0x2F5A30 byte-exact from the chat unit's
 * tail, nothing lost. Still open there: the destroy itself (0x20C against 0x1F8: the block iterators'
 * difference is called out of line -- a friend generated after the deque iterator's, which then calls
 * it; written inline the call goes but the by-value iterators are still copied in, 0x270), and the
 * chat's teardown level 0x2F62B0 (destroy, then ~__deque_buf 0x2F6BC0 called with 0: a destroying class
 * between __deque_imp and __deque_buf for class elements only -- the lobby's chain calls ~__deque_buf
 * after the same four this-tests -- which needs make_iterator and destroy below it, in __deque_buf).
 * make_iterator: begin() of the buffer in class makes it 0xB8 (all scalarised), its copy kept in memory
 * by `return t += n` in operator+ 0x100; the target keeps begin()'s object in memory too (0x130/0x138) --
 * neither a user copy constructor nor a member operator- does it.
 *
 * The MSL headers' round 14 (probes build/p14/, untracked; mi1.py, it1.py): MAKE_ITERATOR, MEASURED, NOT
 * APPLIED -- the buffer's begin() in class returning its temporary (`return iterator(...)`) and operator+
 * as `{ iterator t(*this); return t += n; }` give the target's SIZE for every non-const instance (0x130
 * the lobby's, 0x134 the pointer deques', 0x164 the state machine's) with both objects in memory and t's
 * data_/last_ addressed through registers as the target's -- but 69-78 instructions off: t takes the
 * lower stack slot where the target's begin() object does, and the target's += and the copy out of its
 * result go through one register holding &t (`sw v1,0(a3)`), where MW folds &t into frame offsets; the
 * const instances stay 8 bytes short and the chat unit (inline_max_size 100) scalarises. Tried with it,
 * none closer: a friend operator+ by value (the copy becomes an lq/sq block copy), by const reference
 * (scalarised), `return iterator(*this) += n`, the result bound to a reference, `i = begin(); i += k`, a
 * user copy constructor (field-wise or by assignment: scalarised again). A base class holding the four
 * fields (`class iterator : public iterator_base`) keeps every object in memory -- the buffer's own
 * begin()/end() copies come out 0x6C/0x98 against the target's unnamed 0x2E0CB0/0x2E0C10 (0x70/0xA0),
 * the const make_iterator at the target's 0x138 -- but its implicit copy is then an FPU block copy (the
 * target's is word by word through the fields' registers) and the deque's own begin()/end() (0x2E0940,
 * byte-exact) grow to 0x60; an empty std::iterator base changes nothing. So the cdeque iterator's real
 * shape keeps its objects in memory AND copies them member-wise -- not found.
 * The MSL headers' round 15 (build/p15/incD, untracked): the four fields in a base class WITH a
 * member-wise user copy constructor (the iterator's own copy left implicit), with operator+ as
 * `{ iterator t(*this); return t += n; }` and the buffer's begin() in class returning its temporary,
 * keeps every object in memory and copies it field by field through address registers, as the target
 * does -- 0x12C for both lobby instances against 0x130/0x138, but ~147 lines off in slots and
 * scheduling (the target addresses six stack objects through t2-t6/a3, here three); without `return t
 * += n` or without the base 0xF0, without the buffer's begin() in class 0xE4 (no change from the base
 * alone). Not applied: closer in shape, no instance matched.
 * The chat's range destroy (0x2F5B10, round 14, build/p14/ds1.py): the target inlines the block
 * iterators' difference and reads both by-value iterators in place through a1/a2 (a 16-byte frame:
 * only the count, for min); here the chat unit's inline_max_size(100) keeps that difference a call
 * (0x20C), without the pragma it inlines but both iterators are copied into the frame at entry (0x270)
 * -- by value, by member, by const reference and const by-value parameters alike (the last 0x1F8, the
 * target's size, by coincidence: the copies stay). The class deque's init (0x2E0830, 0x3A5ED0) through
 * __convert_iterator (with or without its converter member) is 0x118 against 0xB0.
 * The online lane's round 13 (probes in build/scratch/onl/p/, untracked): THE BUFFER'S begin()/end()
 * BUILD A NAMED TEMPORARY AND COPY IT OUT THROUGH CONST REFERENCE ACCESSORS -- cdeque<T *>::end() is
 * `return make_iterator(index)`, an in-class make_iterator constructing `iterator t(...)` and returning
 * it (a value returned through an inline function keeps its temporary in the frame; `return iterator(..)`
 * or a named local in end() itself is built in place in the return slot), the iterator's constructor
 * taking start and capacity by const reference (they are read where the body uses them: capacity late,
 * start shared with the element pointer), and a user copy constructor reading the source through
 * `T **const &p() const` accessors: their inlined reference temporaries hold the field addresses that
 * the constructor's stores share, which is the target's `addiu t0,sp,4` ... `lw v1,0(t0)` copy-out (by
 * value, `x.p_` or through a pointer the copy folds to sp offsets). The lobby's end() 0x2E0C10 and
 * util_ssm.cpp's 0x3A62B0 are byte-exact so, nothing lost over every hand-written unit. Still open: every
 * begin() (0x2E0CB0, 0x3A6350, the rdr's 0x334030) has start*4 coloured before the three field-address
 * temporaries where the target colours it after them (the inliner's temporaries are numbered before
 * CSE's; nine forms of begin(), make_iterator and the constructor tried), the pointer deques' pair
 * (0x333F90/0x334030, cdeque<const void **>) does not CSE the copy's addresses at all (0x98/0x68 against
 * 0xA0/0x70), and init (0x2E0B40) copies its by-address iterators as FPU blocks, as an implicit copy
 * would (0xC0 against 0xC8).
 * The MSL headers' round 18 (probes build/p18/d/, untracked), MEASURED, NOT APPLIED: EVERY do_assign
 * CALLS ITS ITERATORS' OPERATORS OUT OF LINE -- the lobby's 0x2E1090, the rdr editor's 0x334440 and the
 * vid stack's 0x3B8000 alike: the source's operator!= (0x2E1460 / 0x334860 / 0x3B83B0), its operator*
 * (0x2E1540 / 0x334940 / 0x3B8430) and ++ (0x2E14E0 / 0x3348E0 / 0x3B83D0), the destination's * and ++
 * (0x2E1550, 0x2E1480; the pointer deques' shared 0x3349B0, 0x334880) and, last, the destination
 * iterator's copy constructor (0x2E1420 / 0x334820: six words member-wise, for std::copy's returned
 * iterator) -- the operators of out-of-class members generated after do_assign, not in-class inlines;
 * the two ++ (and the two *) are copies of identical code, so the source's class is not the
 * destination's (a const_iterator class of its own; the pointer deques' sources are per element type,
 * the destinations shared). The head is std::distance BY VALUE through a tag-dispatched helper: both
 * iterators copied in through $f0 (24 bytes each, sp+304/272), then again with lq/sq (sp+176/144), the
 * difference inlined over those copies in memory; the tail std::copy by value (the source's copies
 * again, the destination straight from make_iterator(0)) with a `!=` loop. Measured on the lobby unit:
 * a separate const_iterator alone changes no code (do_assign 0x36C against 0x384, the operators
 * inlined); with *, ++ and != out of class the five operator copies are byte-exact as probes (aliased:
 * 18 against 14 in zNetMedius.cpp's deque pieces) and do_assign calls them, 0x2CC; adding the by-value
 * distance/copy pair and an out-of-class copy constructor for the destination makes 0x2E1420 byte-exact
 * too (19), do_assign 0x31C -- the source's copies there go through the buffer iterator's user copy
 * constructor (cdeque<T *>::iterator's, lw/sw and calls) where the target copies the source bitwise
 * (lwc1/swc1, lq/sq): the const iterator's buffer iterator has an implicit copy (a const buffer
 * iterator of its own), the destination's the user one. Every init/do_assign row name would move to
 * `14const_iterator`; not applied until the whole chain closes. */

#ifndef _MSL_DEQUE
#define _MSL_DEQUE

#include <memory>
#include <msl_utility>
#include <new>
#include <iterator>
#include <stdio.h>
#include <stdlib.h>

#ifndef __msl_error
#define __msl_error(str) \
    {                    \
        fprintf(stderr, str); \
        abort();         \
    }
#endif

namespace Metrowerks {

template <class T, class Allocator = std::allocator<T> >
class cdeque;

/* a pair whose first is empty (SOCOM 1's compressed_pair over compressed_pair_imp<T1, T2, 1>) */
template <class T1, class T2>
class __compressed_pair_imp : public T1 {
public:
    __compressed_pair_imp() {}
    __compressed_pair_imp(const T1 &x, const T2 &y);

    T2 second_;
};

template <class T1, class T2>
__compressed_pair_imp<T1, T2>::__compressed_pair_imp(const T1 &x, const T2 &y) : T1(x), second_(y)
{
}

template <class T1, class T2>
class compressed_pair : public __compressed_pair_imp<T1, T2> {
public:
    compressed_pair() {}
    compressed_pair(const T1 &x, const T2 &y) : __compressed_pair_imp<T1, T2>(x, y) {}
};

/* an iterator read through a conversion (MSL's __convert_iterator: the pointer containers hand
 * their own iterators to the const void * base this way) */
template <class Iterator, class T>
class __convert_iterator {
public:
    struct convert {
        T operator()(Iterator i) const { return (T)*i; }
    };
    __convert_iterator(Iterator i, convert = convert()) : i_(i) {}
    T operator*() const { return convert()(i_); }
    __convert_iterator &operator++()
    {
        ++i_;
        return *this;
    }
    friend bool operator==(const __convert_iterator &x, const __convert_iterator &y) { return x.i_ == y.i_; }
    friend bool operator!=(const __convert_iterator &x, const __convert_iterator &y) { return !(x == y); }
    friend int operator-(const __convert_iterator &x, const __convert_iterator &y) { return x.i_ - y.i_; }

    Iterator i_;
    convert c_;
};

template <class T, class Allocator>
class __cdeque_buf {
public:
    __cdeque_buf();
    explicit __cdeque_buf(const Allocator &a);
    ~__cdeque_buf()
    {
        if (data_)
            operator delete(data_);
    }

    unsigned int capacity_;
    unsigned int size_;
    unsigned int start_;
    T *data_;
};

template <class T, class Allocator>
__cdeque_buf<T, Allocator>::__cdeque_buf()
{
    capacity_ = 0;
    size_ = 0;
    start_ = 0;
    data_ = 0;
}

template <class T, class Allocator>
__cdeque_buf<T, Allocator>::__cdeque_buf(const Allocator &)
{
    capacity_ = 0;
    size_ = 0;
    start_ = 0;
    data_ = 0;
}

template <class Allocator>
class cdeque<const void *, Allocator> : public __cdeque_buf<const void *, Allocator>, public Allocator {
public:
    typedef const void *value_type;

    class iterator {
    public:
        iterator(value_type *p, value_type *first, value_type *last) : p_(p), first_(first), last_(last) {}
        value_type &operator*() const { return *p_; }
        iterator &operator++()
        {
            if (++p_ == last_)
                p_ = first_;
            return *this;
        }
        bool operator==(const iterator &x) const { return p_ == x.p_; }
        bool operator!=(const iterator &x) const { return p_ != x.p_; }

        value_type *p_;
        value_type *first_;
        value_type *last_;
    };
    iterator begin() { return iterator(this->data_ + this->start_, this->data_, this->data_ + this->capacity_); }
    /* the end's index taken first, then the data pointer (the MSL headers round 14: ~__deque_buf's walk
     * computes the modulo before it loads data_ -- 0x2CEFB0, 0x2E19E0, 0x3A6E60 byte-exact so; the index
     * written inside the constructor's first argument loads data_ first, 0x140 against 0x138) */
    iterator end()
    {
        unsigned int e = this->capacity_ ? (this->start_ + this->size_) % this->capacity_ : 0;

        return iterator(this->data_ + e, this->data_, this->data_ + this->capacity_);
    }

    cdeque() {}
    explicit cdeque(const Allocator &a) : __cdeque_buf<const void *, Allocator>(a) {}
    const Allocator &alloc() const;

    unsigned int size() const { return this->size_; }
    unsigned int capacity() const { return this->capacity_; }
    value_type &front() { return this->data_[this->start_]; }
    value_type &back() { return this->data_[(this->start_ + this->size_ - 1) % this->capacity_]; }
    value_type &operator[](unsigned int n) { return this->data_[(this->start_ + n) % this->capacity_]; }
    void pop_front();
    /* the back dropped: only the count (the deque's pop_back inlines it, 0x3349C0) */
    void pop_back() { --this->size_; }
    /* out of line in an earlier unit (0x2858B0, 0x285A50, 0x285660) */
    void push_back(const value_type &x);
    void reserve(unsigned int n);
    void resize(unsigned int n);
    unsigned int max_size() const;
    template <class InputIterator>
    void do_assign(InputIterator first, InputIterator last);
};

template <class Allocator>
void cdeque<const void *, Allocator>::pop_front()
{
    --this->size_;
    if (++this->start_ == this->capacity_)
        this->start_ = 0;
}

template <class Allocator>
const Allocator &cdeque<const void *, Allocator>::alloc() const
{
    return *(const Allocator *)(const __cdeque_buf<const void *, Allocator> *)this;
}

template <class Allocator>
template <class InputIterator>
void cdeque<const void *, Allocator>::do_assign(InputIterator first, InputIterator last)
{
    this->size_ = last - first;
    if (this->size_) {
        if (this->size_ > max_size())
            __msl_error("cdeque::construction length error");
        this->capacity_ = this->size_ + 1;
        this->data_ = (value_type *)operator new(this->capacity_ * sizeof(value_type));
        if (!this->data_)
            __msl_error("Memory allocation failure");
        value_type *p = this->data_;
        for (; first != last; ++first, ++p)
            *p = *first;
    }
}

/* the circular buffer of T * over the const void * one */
template <class T, class Allocator>
class cdeque<T *, Allocator> : public cdeque<const void *, std::allocator<const void *> > {
    typedef cdeque<const void *, std::allocator<const void *> > base;

public:
    class iterator {
    public:
        iterator(T **p, T **data, const unsigned int &start, const unsigned int &cap)
        {
            p_ = p;
            data_ = data;
            first_ = data_ + start;
            last_ = data_ + cap;
        }
        iterator(const iterator &x) { p_ = x.p(); data_ = x.data(); first_ = x.first(); last_ = x.last(); }
        T **const &p() const { return p_; }
        T **const &data() const { return data_; }
        T **const &first() const { return first_; }
        T **const &last() const { return last_; }
        T *&operator*() const { return *p_; }
        iterator &operator++()
        {
            if (++p_ == last_)
                p_ = data_;
            return *this;
        }
        iterator &operator+=(int n)
        {
            int cap = last_ - data_;
            int i = (p_ - data_) + n;

            if (i < 0)
                i += cap;
            else if (i >= cap)
                i -= cap;
            p_ = data_ + i;
            return *this;
        }
        iterator operator+(int n) const
        {
            iterator t(*this);

            t += n;
            return t;
        }
        friend bool operator==(const iterator &x, const iterator &y) { return x.p_ == y.p_; }
        friend bool operator!=(const iterator &x, const iterator &y) { return !(x == y); }
        friend int operator-(const iterator &x, const iterator &y)
        {
            int n = x.p_ - y.p_;

            if (x.p_ >= x.first_) {
                if (y.p_ < x.first_)
                    n -= x.last_ - x.data_;
            } else if (y.p_ >= x.first_)
                n += x.last_ - x.data_;
            return n;
        }

        T **p_;
        T **data_;
        T **first_;
        T **last_;
    };

    cdeque() {}
    explicit cdeque(const Allocator &a);
    cdeque(const cdeque &x);
    iterator make_iterator(unsigned int n) const
    {
        iterator t((T **)this->data_ + n, (T **)this->data_, this->start_, this->capacity_);

        return t;
    }
    iterator begin() const;
    iterator end() const;
    template <class InputIterator>
    void init(InputIterator first, InputIterator last, std::forward_iterator_tag);

    T *&front() { return (T *&)base::front(); }
    T *&back() { return (T *&)base::back(); }
    T *&operator[](unsigned int n) { return (T *&)base::operator[](n); }
    void pop_back() { base::pop_back(); }
};

template <class T, class Allocator>
cdeque<T *, Allocator>::cdeque(const Allocator &) : base(std::allocator<const void *>())
{
}

template <class T, class Allocator>
cdeque<T *, Allocator>::cdeque(const cdeque &x) : base(x.alloc())
{
    init(x.begin(), x.end(), std::forward_iterator_tag());
}

template <class T, class Allocator>
typename cdeque<T *, Allocator>::iterator cdeque<T *, Allocator>::begin() const
{
    return make_iterator(this->start_);
}

template <class T, class Allocator>
typename cdeque<T *, Allocator>::iterator cdeque<T *, Allocator>::end() const
{
    return make_iterator(this->capacity_ ? (this->start_ + this->size_) % this->capacity_ : 0);
}

template <class T, class Allocator>
template <class InputIterator>
void cdeque<T *, Allocator>::init(InputIterator first, InputIterator last, std::forward_iterator_tag)
{
    base::do_assign(__convert_iterator<InputIterator, const void *>(first),
                    __convert_iterator<InputIterator, const void *>(last));
}

}

namespace std {

template <class T, class Allocator>
class __deque_buf {
public:
    typedef Metrowerks::cdeque<T *, allocator<T *> > buf_type;

    __deque_buf();
    explicit __deque_buf(const Allocator &a);
    ~__deque_buf();
    const Allocator &alloc() const;

    Metrowerks::compressed_pair<Allocator, buf_type> buf_;   // 0x0
    unsigned int start_;   // 0x10
    unsigned int size_;   // 0x14
};

template <class T, class Allocator>
__deque_buf<T, Allocator>::__deque_buf()
{
    this->start_ = 0;
    this->size_ = 0;
}

template <class T, class Allocator>
__deque_buf<T, Allocator>::__deque_buf(const Allocator &a) : buf_(a, buf_type(allocator<T *>(a))), start_(0), size_(0)
{
}

template <class T, class Allocator>
const Allocator &__deque_buf<T, Allocator>::alloc() const
{
    return buf_;
}

/* the blocks freed walking the buffer, then the buffer (0x2CEFB0, out of class): the teardown's tail
 * tests `this` five times as the target's (the pair's two levels and the buffer's three); byte-exact
 * since the MSL headers round 14 (0x2CEFB0, the lobby's 0x2E19E0, the state machine's 0x3A6E60), the
 * buffer's end() taking its index before its data pointer */
template <class T, class Allocator>
__deque_buf<T, Allocator>::~__deque_buf()
{
    if (this->buf_.second_.size() != 0) {
        typedef Metrowerks::cdeque<const void *, allocator<const void *> > B;
        typename B::iterator e = this->buf_.second_.B::end();

        for (typename B::iterator i = this->buf_.second_.B::begin(); i != e; ++i)
            if (*i)
                operator delete((void *)*i);
    }
}

template <class T, class Allocator>
class __deque_imp;

/* a class element's teardown level, between __deque_imp and the block buffer: the elements destroyed
 * over the whole range, then the buffer's destructor (the chat lines' 0x2F62B0: begin's and end's
 * make_iterator, the range destroy 0x2F5B10, ~__deque_buf 0x2F6BC0 called with 0). A scalar element's
 * deque has none (the lobby's and the pointer deques' chains call ~__deque_buf after their own
 * this-tests): the base is picked by has_trivial_dtor. The name ours */
template <class T, class Allocator>
class __deque_destroy : public __deque_buf<T, Allocator> {
public:
    __deque_destroy() {}
    explicit __deque_destroy(const Allocator &a) : __deque_buf<T, Allocator>(a) {}
    ~__deque_destroy();
};

template <class T, class Allocator, bool trivial>
struct __deque_base {
    typedef __deque_destroy<T, Allocator> type;
};

template <class T, class Allocator>
struct __deque_base<T, Allocator, true> {
    typedef __deque_buf<T, Allocator> type;
};

template <class T, class Allocator>
class __deque_imp : public __deque_base<T, Allocator, Metrowerks::has_trivial_dtor<T>::value>::type,
                    public allocator<const void *> {
public:
    /* 512-byte blocks: 128 pointers, 42 of CSimpleStateMachine's 12-byte member pointers (its
     * pop_front 0x3A6C40 and clear 0x3A6FA0 keep 84 and 21) -- but never fewer than 8 elements: the
     * chat's 112-byte lines go 8 to a block (its pop_front 0x2F51E0 keeps 16, and the private-line
     * callbacks' inlined front() 0x2F4A20/0x2F4BA0 divide the start by 8; 512 / 112 would give 4).
     * The only element in the tree past 64 bytes, so the minimum moves nothing else (the online
     * lane, round 11). A static constant with storage (the MSL headers round 13): the range destroy
     * takes its address for min (the chat's 0x2F5B10 reads it at 0x3F56D8, the 8 in the chat unit's
     * rodata), every other reader folds it */
    typedef unsigned int size_type;
    static const size_type buf_size = sizeof(T) * 8 <= 512 ? 512 / sizeof(T) : 8;

    /* the iterator: the block buffer's position, the element, the block's end */
    class iterator {
    public:
        typedef typename __deque_buf<T, Allocator>::buf_type::iterator buf_iterator;

        iterator(const buf_iterator &i, T *cur, T *last) : i_(i), cur_(cur), last_(last) {}
        T &operator*() const { return *cur_; }
        iterator &operator++()
        {
            if (++cur_ == last_) {
                ++i_;
                cur_ = *i_;
                last_ = cur_ + buf_size;
            }
            return *this;
        }
        friend bool operator==(const iterator &x, const iterator &y) { return x.cur_ == y.cur_; }
        friend bool operator!=(const iterator &x, const iterator &y) { return !(x == y); }
        friend int operator-(const iterator &x, const iterator &y)
        {
            return (x.i_ - y.i_) * buf_size - (x.last_ - x.cur_) + (y.last_ - y.cur_);
        }

        buf_iterator i_;
        T *cur_;
        T *last_;
    };
    typedef iterator const_iterator;

    __deque_imp() {}
    explicit __deque_imp(const Allocator &a)
        : __deque_base<T, Allocator, Metrowerks::has_trivial_dtor<T>::value>::type(a) {}
    unsigned int size() const { return this->size_; }
    bool empty() const { return this->size_ == 0; }
    T &front() { return this->buf_.second_[this->start_ / buf_size][this->start_ % buf_size]; }
    /* the last element (the rdr lane's 0x3335C0, out of line: start + size - 1 split by the block
     * size, the block found through the buffer's modulo) */
    T &back()
    {
        unsigned int n = this->start_ + this->size_ - 1;

        return this->buf_.second_[n / buf_size][n % buf_size];
    }
    void pop_front();
    void pop_back();
    void clear();
    void push_back(const T &x);
    static unsigned int max_size() { return ((unsigned int)-1 / sizeof(T *) - 1) * buf_size; }
    const_iterator make_iterator(unsigned int n) const;
    iterator make_iterator(unsigned int n);
    /* the ends as make_iterator gives them (in class: through these the range destroy's arguments are
     * built end first, the target's order -- a call one inline level deeper is expanded later; called
     * straight, begin's make_iterator came first) */
    iterator begin() { return make_iterator(0); }
    iterator end() { return make_iterator(this->size_); }
    template <class InputIterator>
    void do_assign(InputIterator first, InputIterator last);
    /* the elements [first, last) destroyed block by block (out of class; a class element's only:
     * see clear()) */
    void destroy(iterator first, iterator last);
};

template <class T, class Allocator>
const typename __deque_imp<T, Allocator>::size_type __deque_imp<T, Allocator>::buf_size;

template <class T, class Allocator>
__deque_destroy<T, Allocator>::~__deque_destroy()
{
    __deque_imp<T, Allocator> *d = static_cast<__deque_imp<T, Allocator> *>(this);

    d->destroy(d->begin(), d->end());
}

/* the elements of [first, last) destroyed a block at a time (the chat lines' 0x2F5B10): the count
 * taken first, the first block's run as far as the count or the block's end allows (min over the
 * signed difference: the count copied), then whole blocks of at most buf_size (min over the count
 * itself and the constant's storage), each run's length taken off the count. A trivial destructor
 * leaves only the walk */
template <class T, class Allocator>
void __deque_imp<T, Allocator>::destroy(iterator first, iterator last)
{
    if (first == last)
        return;
    size_type n = last - first;
    typename iterator::buf_iterator i = first.i_;
    T *p = first.cur_;
    T *e = p + min(int(n), int(first.last_ - first.cur_));

    for (;;) {
        for (T *q = p; q < e; ++q)
            q->~T();
        n -= e - p;
        if (n == 0)
            break;
        ++i;
        p = *i;
        e = p + min(n, buf_size);
    }
}

template <class T, class Allocator>
typename __deque_imp<T, Allocator>::const_iterator __deque_imp<T, Allocator>::make_iterator(unsigned int n) const
{
    n += this->start_;
    typename iterator::buf_iterator i = this->buf_.second_.begin() + n / buf_size;
    T *b = this->buf_.second_.size() ? *i : 0;

    return const_iterator(i, b + n % buf_size, b + buf_size);
}

template <class T, class Allocator>
typename __deque_imp<T, Allocator>::iterator __deque_imp<T, Allocator>::make_iterator(unsigned int n)
{
    n += this->start_;
    typename iterator::buf_iterator i = this->buf_.second_.begin() + n / buf_size;
    T *b = this->buf_.second_.size() ? *i : 0;

    return iterator(i, b + n % buf_size, b + buf_size);
}

template <class T, class Allocator>
template <class InputIterator>
void __deque_imp<T, Allocator>::do_assign(InputIterator first, InputIterator last)
{
    unsigned int n = last - first;

    if (n == 0)
        return;
    static const unsigned int max = max_size();

    if (n > max)
        __msl_error("deque::construction length error");
    this->buf_.second_.reserve(2);
    this->buf_.second_.resize(1);
    do {
        if (this->buf_.second_.size() == (this->buf_.second_.capacity() ? this->buf_.second_.capacity() - 1 : 0))
            this->buf_.second_.reserve(this->buf_.second_.size() * 2);
        T *&last_block = this->buf_.second_.back();
        T *b = (T *)operator new(buf_size * sizeof(T));

        if (!b)
            __msl_error("Memory allocation failure");
        last_block = b;
        this->buf_.second_.push_back(0);
    } while ((this->buf_.second_.size() ? (this->buf_.second_.size() - 1) * buf_size : 0) < n);
    this->start_ = ((this->buf_.second_.size() ? (this->buf_.second_.size() - 1) * buf_size : 0) - n) / 2;
    this->size_ = n;
    iterator i = make_iterator(0);

    for (; first != last; ++first, ++i)
        *i = *first;
}

/* the elements forgotten: two blocks kept, the start mid-block (0x2CF120) */
template <class T, class Allocator>
void __deque_imp<T, Allocator>::clear()
{
    if (!Metrowerks::has_trivial_dtor<T>::value)
        destroy(begin(), end());
    this->size_ = 0;
    if (this->buf_.second_.size() > 1) {
        while (this->buf_.second_.size() > 2) {
            operator delete(this->buf_.second_.front());
            this->buf_.second_.pop_front();
        }
        this->start_ = buf_size / 2;
    } else
        this->start_ = 0;
}

/* the front dropped; blocks wholly in front of the start freed (0x2CEF00) */
template <class T, class Allocator>
void __deque_imp<T, Allocator>::pop_front()
{
    if (this->size_ == 1) {
        clear();
        return;
    }
    --this->size_;
    ++this->start_;
    while (this->start_ >= 2 * buf_size) {
        operator delete(this->buf_.second_.front());
        this->buf_.second_.pop_front();
        this->start_ -= buf_size;
    }
}

/* the back dropped; whole blocks behind the end freed, the slot after the last block kept null
 * (the rdr lane's 0x3349C0: the buffer popped, its new back deleted and cleared).
 * OPEN, 8 bytes short (0xCC against 0xD4): the target lays the capacity ternary's zero arm out
 * first and jumps from it to the join (start_'s load in both arms); this form, an inline
 * accessor, an if/return and `n == 0 ? 0 : ...` all if-convert the zero into beqz's delay slot.
 * The MSL headers' round 4 (probe build/m4/p/dq.cpp): the multiply after the ternary, `(size() ?
 * size() - 1 : 0) * buf_size`, keeps the zero arm a block of its own -- the right size, five
 * instructions off: the arms come in the other order (the nonzero one falls through) and the
 * zero is built in v1 before the multiply where the target puts it straight into the product's
 * a1; `== 0`, `!`, empty(), an unsigned zero, a for/break test and the multiply written first
 * change nothing. A LEAD from the MSL headers round 14: push_back's same two block counts lay their
 * zero arm out first only written `size() == 0 ? 0 : (size() - 1) * buf_size` (no hand-written unit
 * emits pop_back to test it on: 0x3349C0 is a draft's) */
template <class T, class Allocator>
void __deque_imp<T, Allocator>::pop_back()
{
    if (this->size_ == 1) {
        clear();
        return;
    }
    --this->size_;
    while ((this->buf_.second_.size() ? (this->buf_.second_.size() - 1) * buf_size : 0) - (this->start_ + this->size_) >=
           2 * buf_size) {
        this->buf_.second_.pop_back();
        T *&b = this->buf_.second_.back();

        operator delete(b);
        b = 0;
    }
}

/* the element appended, a block added at the back first when the last is full (0x2CF970). The MSL
 * headers round 14: the growth path holds the new block in MSL's alloc_ptr with its count kept
 * ({allocator, 128, block} at sp+104: Metrowerks::alloc_ptr<T, Allocator &, size_type>, released
 * after the buffer's push_back and the count, its destructor's `if (p) deallocate` on the way out),
 * the block is stored as the buffer's back and the element through the same pointer (`*(back() =
 * ap.get()) = x`: x and the block loaded before either store), the other path's block comes from
 * the allocator straight into back() (named locals there swap the block's and back()'s saved
 * registers), and both block counts are `== 0 ? 0 : ...` (the zero arm falls through, as the
 * target lays it out). The function-local max static is guarded (0x44D6C8, the value at 0x3F3490 --
 * data.txt names each instance's). Byte-exact: 0x2CF970, the lobby's 0x2E1610 */
template <class T, class Allocator>
void __deque_imp<T, Allocator>::push_back(const T &x)
{
    unsigned int n = this->start_ + this->size_;

    if (n == (this->buf_.second_.size() == 0 ? 0 : (this->buf_.second_.size() - 1) * buf_size)) {
        static const unsigned int max = max_size();

        if (this->size_ == max)
            __msl_error("deque::push_back length error");
        if (this->buf_.second_.size() == (this->buf_.second_.capacity() == 0 ? 0 : this->buf_.second_.capacity() - 1)) {
            if (this->buf_.second_.size() == 0) {
                this->buf_.second_.reserve(2);
                this->buf_.second_.resize(1);
            }
            Allocator &a = this->buf_;
            Metrowerks::alloc_ptr<T, Allocator &, size_type> ap(a.allocate(buf_size), a, buf_size);

            this->buf_.second_.reserve(this->buf_.second_.size() * 2);
            *(this->buf_.second_.back() = ap.get()) = x;
            this->buf_.second_.push_back(0);
            ++this->size_;
            ap.release();
            return;
        }
        this->buf_.second_.back() = ((Allocator &)this->buf_).allocate(buf_size);
        this->buf_.second_.push_back(0);
    }
    this->buf_.second_[n / buf_size][n % buf_size] = x;
    ++this->size_;
}

template <class T, class Allocator = allocator<T> >
class deque;

template <class T, class Allocator>
class deque : public __deque_imp<T, Allocator> {
    typedef __deque_imp<T, Allocator> base;

public:
    typedef typename base::const_iterator const_iterator;

    deque();
    deque(const deque &x);
    const_iterator begin() const;
    const_iterator end() const;
    template <class InputIterator>
    void init(InputIterator first, InputIterator last, forward_iterator_tag);
};

/* OPEN (the MSL headers round 11): a class element's default constructor -- the lobby's 0x2E0D90
 * (CZOnlineLobby() calls it), the chat's 0x2F6230 (__sinit_zNetMediusChat.cpp), the state machine's
 * 0x3A6410 -- calls only the block buffer's (0x28 bytes), where its copy constructor (0x2E07B0,
 * 0x3A5E50, byte-exact) calls allocator<const void *>() 0x2CEE30 at +0x18 after the buffer's: one base,
 * constructed out of line in one path and not at all in the other. `public Allocator` for __deque_imp's
 * second base gives the default constructors (0x2E0D90 byte-exact, 0x2F6230 and 0x3A6410 down to their
 * callee's row) and loses both copy constructors; deque() in class lets CZOnlineLobby() inline it and
 * loses them too (build/p11/d1.var, d2.var). The buffer's own default constructor calls a per-element
 * 0x18-byte copy of __cdeque_buf<PCv>()'s zeroing (0x2E0DF0, 0x2F6290, 0x3A6470, 0x334150: one level of
 * the buffer chain out of line per element type, round 7's open middle level) where ours calls the
 * shared 0x2CEE70 */
template <class T, class Allocator>
deque<T, Allocator>::deque()
{
}

template <class T, class Allocator>
deque<T, Allocator>::deque(const deque &x) : base(x.alloc())
{
    init(x.begin(), x.end(), forward_iterator_tag());
}

template <class T, class Allocator>
typename deque<T, Allocator>::const_iterator deque<T, Allocator>::begin() const
{
    const_iterator i = this->make_iterator(0);

    return i;
}

template <class T, class Allocator>
typename deque<T, Allocator>::const_iterator deque<T, Allocator>::end() const
{
    const_iterator i = this->make_iterator(this->size_);

    return i;
}

template <class T, class Allocator>
template <class InputIterator>
void deque<T, Allocator>::init(InputIterator first, InputIterator last, forward_iterator_tag)
{
    this->do_assign(first, last);
}

template <class Allocator>
class deque<const void *, Allocator> : public __deque_imp<const void *, Allocator> {
    typedef __deque_imp<const void *, Allocator> base;

public:
    deque() {}
    explicit deque(const Allocator &a) : base(a) {}
};

template <class T, class Allocator>
class deque<T *, Allocator> : public deque<const void *, allocator<const void *> > {
    typedef deque<const void *, allocator<const void *> > base;

public:
    typedef typename base::const_iterator const_iterator;

    deque();
    deque(const deque &x);
    const_iterator begin() const;
    const_iterator end() const;
    template <class InputIterator>
    void init(InputIterator first, InputIterator last, forward_iterator_tag);

    T *&front() { return (T *&)base::front(); }
    T *&back() { return (T *&)base::back(); }
    void push_back(T *const &x) { base::push_back((const void *const &)x); }
    void pop_front() { base::pop_front(); }
    void pop_back() { base::pop_back(); }
};

template <class T, class Allocator>
deque<T *, Allocator>::deque()
{
}

template <class T, class Allocator>
deque<T *, Allocator>::deque(const deque &x) : base(x.alloc())
{
    init(x.begin(), x.end(), forward_iterator_tag());
}

template <class T, class Allocator>
typename deque<T *, Allocator>::const_iterator deque<T *, Allocator>::begin() const
{
