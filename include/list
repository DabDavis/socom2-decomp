/* <list>: just enough of Metrowerks' MSL C++ std::list (CodeWarrior PS2 3.0) to give the
 * matched functions their code and their mangled names. A reconstruction, not MSL: the class
 * shapes are SOCOM 1's DWARF (list : __list_imp : __list_deleter, size_ at 0, the end node at
 * 4 with prev_/next_, a node's value after its links), the member bodies are whatever compiles
 * to the shipped bytes. A pointer list shares one implementation over const void * -- hence
 * __list_deleter<PCv,...> in the names of every list<T *>'s calls -- and wraps its iterators
 * (SOCOM 1's list<T *>::generic_iterator<0> is built from the base's).
 *
 * The constructor and erase are defined outside the class, so neither is ever auto-inlined:
 * CSaveManager's and CZAnimArgList's constructors call the deleter's (0x1EABB0), and clear() is
 * a call to the range erase (0x1EAAF0 for the pointer lists). The destructor chain is three
 * this-tested levels above clear() (CZAnimArgList's destructor shows all three). */

#ifndef _MSL_LIST
#define _MSL_LIST

#include <functional>
#include <memory>

namespace std {

template <class T, class Allocator>
class __list_deleter {
public:
    struct node_base {
        node_base *prev_;
        node_base *next_;
    };
    struct node : public node_base {
        T data_;
    };

    template <bool IsConst>
    class generic_iterator {
    public:
        generic_iterator() {}
        generic_iterator(node_base *n) : node_(n) {}
        /* iterator's copy constructor, so iterators are passed by address (erase's are); the
         * copy assignment stays implicit, a bitwise copy (lwc1/swc1) */
        generic_iterator(const generic_iterator<false> &x) : node_(x.node_) {}
        T &operator*() const { return ((node *)node_)->data_; }
        generic_iterator &operator++()
        {
            node_ = node_->next_;
            return *this;
        }
        bool operator==(const generic_iterator &x) const { return node_ == x.node_; }
        bool operator!=(const generic_iterator &x) const { return node_ != x.node_; }

        node_base *node_;
    };
    typedef generic_iterator<false> iterator;
    typedef generic_iterator<true> const_iterator;

    __list_deleter();
    ~__list_deleter() { erase(iterator(end_.next_), iterator(&end_)); }
    iterator begin() { return iterator(end_.next_); }
    iterator end() { return iterator(&end_); }
    void clear() { erase(begin(), end()); }
    iterator erase(iterator first, iterator last);
    iterator erase(iterator position);
    iterator insert(iterator position, const T &x);
    void push_back(const T &x) { insert(end(), x); }

    unsigned int size() const { return size_; }
    /* the sentinel by reference (CZHudMissionCams::Init keeps the end node in a register outside
     * its loop only so; the name is ours) */
    node_base &end_node() { return end_; }
    /* the sentinel's address (SOCOM 1's tail(), this + 4: 0x173510 in the demo) */
    node_base *tail() { return &end_; }

protected:
    unsigned int size_;
    node_base end_;
};

template <class T, class Allocator>
__list_deleter<T, Allocator>::__list_deleter()
    : size_(0)
{
    end_.prev_ = end_.next_ = &end_;
}

/* the nodes [first, last) unlinked around the last one's links, then freed one by one.
 * OPEN (0x1EAAF0, and every type's 0xBC copy): 7 instructions -- first's node and the last
 * node take each other's registers (a2/a1), whatever the declaration order or loop shape */
template <class T, class Allocator>
typename __list_deleter<T, Allocator>::iterator
__list_deleter<T, Allocator>::erase(iterator first, iterator last)
{
    if (first == last)
        return last;
    node_base *f = first.node_;
    node_base *l = last.node_->prev_;

    f->prev_->next_ = l->next_;
    l->next_->prev_ = f->prev_;
    while (first != last) {
        node_base *n = first.node_;

        first.node_ = n->next_;
        operator delete(n);
        --size_;
    }
    return last;
}

/* one node unlinked and freed, the iterator after it given back (SOCOM II's for the pointer lists
 * is 0x20CC50) */
template <class T, class Allocator>
typename __list_deleter<T, Allocator>::iterator
__list_deleter<T, Allocator>::erase(iterator position)
{
    node_base *n = position.node_;

    ++position;
    n->prev_->next_ = n->next_;
    n->next_->prev_ = n->prev_;
    operator delete(n);
    --size_;
    return position;
}

template <class T, class Allocator>
class __list_imp : public __list_deleter<T, Allocator> {
public:
    /* defined outside the class, so called (SOCOM II's for the pointer lists is 0x20CB50) */
    template <class Predicate>
    void remove_if(Predicate pred);
    /* the binder made here, not through bind2nd: a level shorter, which CModel::RemoveInstance's
     * inlining in CNode::Delete needs */
    void remove(const T &value) { remove_if(binder2nd<equal_to<T>, T>(equal_to<T>(), value)); }
};

/* the runs that satisfy the predicate erased, one after another (SOCOM 1's shape; SOCOM II's
 * inlines the erase, not reproduced yet) */
template <class T, class Allocator>
template <class Predicate>
void __list_imp<T, Allocator>::remove_if(Predicate pred)
{
    typename __list_deleter<T, Allocator>::iterator e = this->end();
    typename __list_deleter<T, Allocator>::iterator i = this->begin();

    while (i != e) {
        if (pred(*i)) {
            typename __list_deleter<T, Allocator>::iterator j = i;

            for (++j; j != e && pred(*j); ++j)
                ;
            i = this->erase(i, j);
            if (i == e)
                break;
        }
        ++i;
    }
}

template <class T, class Allocator = allocator<T> >
class list : public __list_imp<T, Allocator> {
};

template <class T, class Allocator>
class list<T *, Allocator> : public __list_imp<const void *, allocator<const void *> > {
    typedef __list_imp<const void *, allocator<const void *> > base;

public:
    /* the reference passed on as the base's, no temporary (the pointer stays where it is), to
     * the base's insert, the end iterator made here from the sentinel: shorter than through the
     * base's push_back and end(), which CNode::CreateInstance's auto-inlining needs (an
     * auto-inline callee more than four high is not inlined at all -- no one-level fallback) */
    void push_back(T *const &x)
    {
        base::insert(typename base::iterator(&this->end_node()), (const void *const &)x);
    }
    void remove(T *const &x) { base::remove((const void *const &)x); }
    /* the last element, and taking it off (CNode::DeleteDeferredVisuals empties its list so; on
     * the pointer list only, where the node is always complete -- ai_events.cpp instantiates a
     * deleter over an incomplete type) */
    T *&back() { return (T *&)((typename base::node *)this->end_.prev_)->data_; }
    void pop_back() { this->erase(typename base::iterator(this->end_.prev_)); }

    /* the pointer list's own iterator: SOCOM 1's DWARF gives list<T *>::generic_iterator the
     * base's as its one member (i_), built from it by value (0x210C90 in the demo) and turned
     * back into it (0x200B90). Its assignment stays implicit -- a bitwise copy (lwc1/swc1),
     * after which MW keeps the iterator in memory: an iterator assigned from begin() is
     * re-read and re-stored at every step, as CZNewHudMap's finders do (one initialised from it
     * lives in a register). The const one is not here yet (CEntityItr::Advance compares with the
     * const end(), SOCOM 1's list<T *>::generic_iterator<1>) */
    template <bool IsConst>
    class generic_iterator {
    public:
        generic_iterator() {}
        generic_iterator(typename base::iterator i) : i_(i) {}
        operator typename base::iterator() const { return i_; }
        T *&operator*() const { return (T *&)*i_; }
        generic_iterator &operator++()
        {
            ++i_;
            return *this;
        }
        bool operator==(const generic_iterator &x) const { return i_ == x.i_; }
        bool operator!=(const generic_iterator &x) const { return i_ != x.i_; }

        typename base::iterator i_;
    };
    typedef generic_iterator<false> iterator;

    /* the first node read through tail() held in a local: the sentinel's address is then
     * computed first and shared with end()'s (CZNewHudMap::FindMPBombItem loads the first node
     * into the register `this` leaves -- straight from end_.next_ it took another), and a walk
     * that assigns begin() to its iterator, a level deeper, still inlines all of it (through the
     * base's begin(), or with tail() as an argument, the innermost constructor is a call) */
    iterator begin()
    {
        typename base::node_base *t = this->tail();

        return iterator(typename base::iterator(t->next_));
    }
    iterator end() { return iterator(typename base::iterator(&this->end_)); }
};

}

#endif
