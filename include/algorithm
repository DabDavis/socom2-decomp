/* <algorithm>: the part of MSL the matched functions inline. A reconstruction: for_each takes
 * its iterators and function object by value, so with class iterators they live in stack
 * slots, copied with lwc1/swc1 as MW copies 4-byte objects (CZAnimExVector::Reset). */

#ifndef _MSL_ALGORITHM
#define _MSL_ALGORITHM

#include <iterator>

namespace std {

template <class InputIterator, class Function>
inline Function for_each(InputIterator first, InputIterator last, Function f)
{
    for (; first != last; ++first)
        f(*first);
    return f;
}

template <class InputIterator, class T>
inline InputIterator find(InputIterator first, InputIterator last, const T &value)
{
    while (!(first == last) && !(*first == value))
        ++first;
    return first;
}

/* out of line wherever it is used (CNodeVector::Remove calls 0x312480): the iterators by value,
 * homed on the stack */
template <class InputIterator, class OutputIterator, class T>
OutputIterator remove_copy(InputIterator first, InputIterator last, OutputIterator result, const T &value)
{
    for (; first != last; ++first)
        if (!(*first == value)) {
            *result = *first;
            ++result;
        }
    return result;
}

/* remove_if's shape (the MSL headers round 8): the walker copied before the test and the two
 * results joined through one copy into the caller's iterator, as a ternary of class objects does
 * it -- the target's first parameter is copied from begin()'s temporary even though find's result
 * overwrites it, `i = first` is scheduled ahead of the test, and the join selects an address
 * (CWorld::DeleteLightMap 0x31FB50, CTurretList::Remove 0x3A71F0, CTargetList::RemoveTarget
 * 0x2A0310, CNodeVector::Remove 0x311CC0 and the AI core's out-of-line remove<CAiMapLoc> 0x529D70
 * byte-exact so; the early `if (first == last) return first;` was 0x18 off in each) */
template <class ForwardIterator, class T>
inline ForwardIterator remove(ForwardIterator first, ForwardIterator last, const T &value)
{
    first = find(first, last, value);
    ForwardIterator i = first;
    return first == last ? first : remove_copy(++i, last, first, value);
}

/* the iterators and the operation by value, as for_each's (CWorld::ClearShadowList and
 * ClearLightMapList copy all three through the stack). A pointer-vector walk whose three iterators
 * live in the frame through the whole loop -- each built in a begin()/end() temporary, copied in
 * through $f0 and re-read and re-stored at every step -- is this, `transform(v.begin(), v.end(),
 * v.begin(), op)`: the parameters (first 48, last 44, result 40 above their arguments' temporaries
 * 52-60) are what stays in memory, which no declared iterator of include/vector's does (the MSL
 * headers round 17: the kit's CZKit::UnInit 0x5C7CE0 byte-exact so, the operation deleting each
 * parentless node and returning 0; build/p17/uninit.cpp, untracked, has the iterator shapes that
 * came closest without it) */
template <class InputIterator, class OutputIterator, class UnaryOperation>
inline OutputIterator transform(InputIterator first, InputIterator last, OutputIterator result,
                                UnaryOperation op)
{
    for (; first != last; ++first, ++result)
        *result = op(*first);
    return result;
}

template <class InputIterator, class Predicate>
inline InputIterator find_if(InputIterator first, InputIterator last, Predicate pred)
{
    while (first != last && !pred(*first))
        ++first;
    return first;
}

/* out of line, as remove_copy (CEntity::PurgeEntities calls 0x29FE70, which calls 0x29FFD0) */
template <class InputIterator, class OutputIterator, class Predicate>
OutputIterator remove_copy_if(InputIterator first, InputIterator last, OutputIterator result, Predicate pred)
{
    for (; first != last; ++first)
        if (!pred(*first)) {
            *result = *first;
            ++result;
        }
    return result;
}

/* the two returns through one copy into the result, as a ternary does it (with an early return
 * MW builds remove_copy_if's straight into it). find_if is instantiated with the predicate BY
 * REFERENCE, `find_if<ForwardIterator, Predicate &>` (as libc++'s remove_if, MSL C++'s sibling, still
 * writes it): the inlined search reads remove_if's own predicate parameter in place where a by-value
 * find_if copied it -- delshadow's remove_if 0x320800 byte-exact so, the callback list's 0x3C6560
 * from 0x10 long to 6 instructions (the MSL headers round 8; nothing lost over every hand-written
 * unit). remove_copy_if still takes it by value (the target loads the functor's word into t0).
 * OPEN, the list instances (0x29FE70, 0x3C6560, 0x352500, 0x50F670, 0x5F8AF0: 6 instructions each):
 * the target makes find_if's two iterator copies in PARAMETER order for the list's iterator (user
 * copy constructor, passed by address) but right to left for the vector's (bitwise) -- MW numbers
 * the inlined copies in creation order, and a by-value find_if creates last's first. A search taking
 * the iterators by const reference and copying them into locals in order (build/p8/rif1.cpp's C)
 * matches both list instances on the board but loses the three vector ones (0x2E49A0, 0x53F1A0,
 * 0x320800), which want the right-to-left copies; no single shape tried serves both.
 * Earlier (0x29FE70, 6 instructions): the inlined find_if's two iterators take s5/s4 the other way
 * round -- `!(last == first)` in find_if gets five, a for/break ten; find_if is node_vector.cpp's
 * and zanim_anim.cpp's too, so it stays. Measured again (the MSL lane, round 2): SOCOM 1's own
 * remove_if over list<CSched_Task *> (0x2F41F0 in the demo) gives first s4 and last s5 as ours
 * does, SOCOM II's the other way -- find_if's two copies are made in parameter order there and in
 * argument order (right to left) here. Tried: an early return, a new local for the result, `last ==
 * first`, the result declared first, explicit template arguments, the loop written in remove_if
 * (no copies: 0xCC), copies of first and last made in either order before the call, find_if as a
 * for/break, a body return, a local walker; the base iterator copied trivially (its conversion to
 * const_iterator a template: +9, PurgeEntities far off) and the wrapper's copy left implicit
 * (no change). Every form keeps the swap or adds to it.
 * WHERE THE ORDER COMES FROM (the MSL headers round 11, build/p11/tmpdump.py, MW's unique-name counter
 * hooked): the two copies are made by an IRO pass between the loop optimiser and CSE (at 0x52C0B6 in
 * mwccps2 3.0b52 -- the class scalariser by its products), one temp per iterator object in the order the
 * objects first appear in the IR; the inliner initialises find_if's by-value parameters in a comma
 * built right to left, so last's object appears first. In the callback list's 0x3C6560 last's copy is
 * @900 and first's @902 (lower numbers are coloured later: first takes a3, last t0) -- the target has
 * first t0, last a3, i.e. first's object first. Where the unit calls the iterator's operators out of
 * line (valve_list.cpp 0x352500, ai_events.cpp 0x50F670: 4 off) the slots agree and only the order of
 * the two copies differs, first then last in the target: the order in which MW BUILDS argument
 * temporaries (left to right), where ours are EVALUATED (right to left). So the list instances' copies
 * are built temporaries and the vector instances' evaluated values, from one remove_if -- one header
 * would have to dispatch on the iterator. Tried (build/p11/r1.var, r2.var): explicit temporaries
 * `ForwardIterator(first)` (no change for the lists, the vectors lose their size), local copies in
 * remove_if, a walker local in find_if, an empty user destructor on the list iterators (every list
 * instance changes size).
 * SO remove_if's SEARCH DISPATCHES ON THE ITERATOR'S CATEGORY (the MSL headers round 20, after the
 * world's round 14 closed list<CSched_Task *>'s 0x34E8C0 with a stand-in specialisation in round 8's
 * shape C, now retired): a random-access iterator (the vectors', a pointer) is searched by value, as
 * find_if, its walker and bound remove_if's own parameters (references: no code); a bidirectional
 * one (both list iterators) is copied into remove_if's own locals in order, first then last -- the
 * target's parameter order -- and searched by reference. +3 over every hand-written unit: the
 * entity list's 0x29FE70, the callback list's 0x3C6560, the AI groups' 0x60E9A0 (with 0x34E8C0
 * through the header), the vectors' seven unchanged. The copies belong to remove_if, not to the
 * search: where the predicate is too tall for the search to inline whole (valve_list.cpp's 0x352500,
 * ai_events.cpp's 0x50F670 call ++, !=, * and the return's copy out of line) the target still makes
 * them inline -- copies inside the search (shape C) are calls there, 8 bytes long. OPEN in those
 * two (9 instructions: the slots alone): the target allocates the search's return temporary (92)
 * above the copies (first 88, last 84) -- by-value parameters' slots, which come after the return
 * temporary's -- where named locals take the top; by value, MW evaluates last's copy first (4 off);
 * an inline helper returning either copy, in either argument, changes nothing (build/p20/d/, vF*).
 * MEASURED (the MSL headers round 21, build/p21/vrif*.py, untracked, against ai_events.cpp's 0x50F670):
 * the search taking its iterators BY VALUE gets every slot the target's -- the search's return
 * temporary on top (108), the by-value parameters below it in parameter order (first 104, last 100)
 * -- with explicit temporaries in the call (`find(ForwardIterator(first), ForwardIterator(last),
 * pred)`), plain arguments, first alone a temporary, last by const reference to a temporary, or the
 * result taken into a named local: 4 off in every one, MW initialising an inlined function's
 * by-value parameters right to left (last's copy first, its store out of the branch's delay slot).
 * So the target's copies are by-value parameters made in parameter order -- which no argument form
 * tried gives -- or remove_if's own in an order that leaves the search's return temporary above
 * them: the copies in a nested block (9 off) and a search object built from the two (0x10C) do
 * neither.
 * The kit's 0x5F8AF0 is a different miss: the target re-reads the functor's byte at every step
 * (`lbu a1,104(sp)`), ours hoists it into s0 under every shape (0x114 against 0x110) -- closed by the
 * kit's round 31 in its own source (the functor reads its kind into a local) */
template <class Category, class InputIterator, class Predicate>
struct __remove_if_search {
    typedef InputIterator &walker;
    static InputIterator find(InputIterator first, InputIterator last, Predicate pred)
    {
        while (first != last && !pred(*first))
            ++first;
        return first;
    }
};

template <class InputIterator, class Predicate>
struct __remove_if_search<bidirectional_iterator_tag, InputIterator, Predicate> {
    typedef InputIterator walker;
    static InputIterator find(InputIterator &first, const InputIterator &last, Predicate pred)
    {
        while (first != last && !pred(*first))
            ++first;
        return first;
    }
};

template <class ForwardIterator, class Predicate>
ForwardIterator remove_if(ForwardIterator first, ForwardIterator last, Predicate pred)
{
    typedef __remove_if_search<typename iterator_traits<ForwardIterator>::iterator_category,
                               ForwardIterator, Predicate &> search;
    typename search::walker f = first;
    typename search::walker l = last;

    first = search::find(f, l, pred);
    ForwardIterator i = first;
    return first == last ? first : remove_copy_if(++i, last, first, pred);
}

/* the two elements traded through their iterators, taken by value (SOCOM II's sorts copy both into
 * stack slots first, the right one into the lower); min_element as MSL writes it (the short-range
 * sort's inner walk) */
template <class ForwardIterator1, class ForwardIterator2>
inline void iter_swap(ForwardIterator1 a, ForwardIterator2 b)
{
    swap(*a, *b);
}

template <class ForwardIterator, class Compare>
inline ForwardIterator min_element(ForwardIterator first, ForwardIterator last, Compare comp)
{
    ForwardIterator i = first;
    if (first != last)
        for (++first; first != last; ++first)
            if (comp(*first, *i))
                i = first;
    return i;
}

/* MSL's sort: SOCOM 1's (CW 3.0.1's <algorithm>; the demo's DWARF gives __sort132 lines 2370-2386,
 * __selection_sort 2409-2420 with its local `stop`, sort 2529-2620 with j, i1, m, len and the static
 * shuffle). Each instance is three functions in its unit's template tail: sort (the partition loop,
 * recursing into the shorter side), __sort132 (the median of three, out of line) and
 * __selection_sort (20 or fewer, out of line); a comparator object passed by value is inlined into
 * all three, a function pointer called. Byte-exact (the MSL headers round 6) for every SOCOM II
 * instance tried -- the room unit's games and rooms (0x2E4A90, 0x2E5150), the ladder unit's two
 * (0x2EC260, 0x2EC7E0), ai_maptable.cpp's names (0x5312D0) as their units emit them, st_mpexit.cpp's
 * seals (0x226060), st_core.cpp's film cues (0x1EE000) and the chat unit's room players (0x2F1980)
 * as probes -- each with its own static shuffle in data (-4; data.txt names them). The shapes the
 * sweeps settled (build/p6/v_sort*.py): `len <= 1` (not `len < 2`: 2 instructions), `len *= 3` before
 * the second pick (not `3 * len /4`: 16 bytes more), the second pick into m, the scans walking i1 up
 * and m down against the pivot *j, and the iterator's arithmetic MSL's own (include/vector: `last -
 * 1` a copy stepped by -=, which the short-range sort's `stop` needs). SOCOM II's sorts take the
 * vector's class iterators where SOCOM 1's took raw pointers: st_mpexit.cpp's over CZSealBody ** is
 * 0x3B4 bytes, the target's 0x598 is the iterator's */
template <class RandomAccessIterator, class Compare>
void __sort132(RandomAccessIterator a1, RandomAccessIterator a2, RandomAccessIterator a3, Compare comp)
{
    bool b1 = !comp(*a3, *a1);
    bool b2 = !comp(*a2, *a3);
    if (b1 && b2)
        return;
    if (!b1 && !b2) {
        iter_swap(a1, a2);
        return;
    }
    if (comp(*a2, *a1))
        iter_swap(a1, a2);
    if (b1)
        iter_swap(a2, a3);
    else
        iter_swap(a1, a3);
}

template <class RandomAccessIterator, class Compare>
void __selection_sort(RandomAccessIterator first, RandomAccessIterator last, Compare comp)
{
    if (first != last) {
        RandomAccessIterator stop = last - 1;
        for (; first < stop; ++first) {
            RandomAccessIterator i = min_element(first, last, comp);
            if (i != first)
                iter_swap(i, first);
        }
    }
}

template <class RandomAccessIterator, class Compare>
void sort(RandomAccessIterator first, RandomAccessIterator last, Compare comp)
{
    while (true) {
        int len = last - first;
        if (len <= 1)
            return;
        if (len <= 20) {
            __selection_sort(first, last, comp);
            return;
        }
        static int shuffle = -4;
        RandomAccessIterator i1 = first + (len / 4 + shuffle % 5);
        if (++shuffle >= 5)
            shuffle = -4;
        len *= 3;
        RandomAccessIterator m = first + (len / 4 + shuffle % 5);
        if (++shuffle >= 5)
            shuffle = -4;
        RandomAccessIterator j = last - 1;
        __sort132(i1, m, j, comp);
        i1 = first;
        m = j;
        while (comp(*i1, *j))
            ++i1;
        while (i1 != --m && !comp(*m, *j))
            ;
        if (i1 < m) {
            iter_swap(i1, m);
            ++i1;
            while (true) {
                while (comp(*i1, *j))
                    ++i1;
                while (!comp(*--m, *j))
                    ;
                if (i1 >= m)
                    break;
                iter_swap(i1, m);
                ++i1;
            }
        }
        if (i1 == first) {
            iter_swap(i1, j);
            ++i1;
            m = last;
            if (!comp(*first, *--m)) {
                while (i1 != last && !comp(*first, *i1))
                    ++i1;
                if (i1 < m)
                    iter_swap(i1, m);
            }
            if (i1 < m) {
                while (true) {
                    while (!comp(*first, *i1))
                        ++i1;
                    while (comp(*first, *--m))
                        ;
                    if (i1 >= m)
                        break;
                    iter_swap(i1, m);
                    ++i1;
                }
            }
            first = i1;
            continue;
        }
        if (i1 - first < last - i1) {
            sort(first, i1, comp);
            first = i1;
        } else {
            sort(i1, last, comp);
            last = i1;
        }
    }
}

/* MSL's heap (SOCOM 1's push_heap, pop_heap and __insert_heap_down over the A* node, 0x183960,
 * 0x183AF0, 0x184FE0 in the demo; SOCOM II's over the open list's class iterators, ai_astar.cpp's
 * tail: 0x5132B0, 0x513460, 0x515270 -- all three byte-exact, the AI core's round 17). The new
 * element's place is first + (len - 1), not --last (both builds compute it from the length), the
 * climb stops when it reaches first; the hole is sunk from the top, the smaller child chosen
 * (comp's way round). The shapes that settled them: `len >= 2` (`len > 1` branches on at, the
 * image materialises the test in v1), the index updates in place (`--parent; parent /= 2;` and
 * `++child; child *= 2;` -- the expression forms compute into a temporary first), and the node's
 * `>` written `b.f() < a.f()` (ai.h: its right operand is evaluated first, so each compare loads
 * its left node before its right as the image does) */
template <class RandomAccessIterator, class Compare>
void push_heap(RandomAccessIterator first, RandomAccessIterator last, Compare comp)
{
    typedef typename iterator_traits<RandomAccessIterator>::difference_type difference_type;
    typedef typename iterator_traits<RandomAccessIterator>::value_type value_type;

    difference_type len = last - first;

    if (len >= 2) {
        difference_type parent = (len - 2) / 2;
        RandomAccessIterator ip = first + parent;
        RandomAccessIterator i = first + (len - 1);

        if (comp(*ip, *i)) {
            value_type tmp(*i);

            do {
                *i = *ip;
                i = ip;
                if (i == first)
                    break;
                --parent;
                parent /= 2;
                ip = first + parent;
            } while (comp(*ip, tmp));
            *i = tmp;
        }
    }
}

template <class RandomAccessIterator, class Distance, class T, class Compare>
void __insert_heap_down(RandomAccessIterator first, Distance len, Distance hole, const T &value, Compare comp)
{
    RandomAccessIterator ip = first + hole;
    Distance child = 2 * (hole + 1);

    while (child <= len) {
        RandomAccessIterator cp = first + child;

        if (child == len || comp(*cp, *(cp - 1))) {
            --child;
            --cp;
        }
        if (!comp(value, *cp))
            break;
        *ip = *cp;
        ip = cp;
        ++child;
        child *= 2;
    }
    *ip = value;
}

template <class RandomAccessIterator, class Compare>
void pop_heap(RandomAccessIterator first, RandomAccessIterator last, Compare comp)
{
    typedef typename iterator_traits<RandomAccessIterator>::difference_type difference_type;
    typedef typename iterator_traits<RandomAccessIterator>::value_type value_type;

    difference_type len = last - first;

    if (len >= 2) {
        --last;
        if (len == 2) {
            iter_swap(first, last);
        } else {
            value_type tmp(*last);

            *last = *first;
            __insert_heap_down(first, len - 1, difference_type(0), tmp, comp);
        }
    }
}

/* The element moves a class vector makes (include/vector: the erase's copy down, the insert's
 * copy up and fill), MSL 3.0's as SOCOM II's instances show them: each algorithm an inline wrapper
 * over an inline helper doing the loop. An element whose assignment expands past inline_max_size
 * makes the helper too big to inline whole, so the wrapper is inlined one level and the helper is
 * called out of line, its copy emitted in the unit's tail -- the turret's 412-byte definitions
 * (copy 0x3ABAE0 from the erase, fill_n 0x3AC200 and copy_backward 0x3AC460 from the insert, each
 * calling the definition's member assignment it cannot inline), CDesignDlgObj's (0x3845B0,
 * 0x384AA0, 0x384B00); a smaller element inlines all of it, the loops the class inserts and
 * erases always had (measured over every hand-written unit: no class-vector match moves). The
 * helpers' names are ours. The loops: copy walks forward while first < last, copy_backward steps
 * both ends down first, fill_n counts n down to zero behind a test of n (the target's top-tested
 * loop at the insert's join; a for loop would be entered at its bottom test there) */
template <class InputIterator, class OutputIterator>
inline OutputIterator __copy(InputIterator first, InputIterator last, OutputIterator result)
{
    for (; first < last; ++first, ++result)
        *result = *first;
    return result;
}

template <class InputIterator, class OutputIterator>
inline OutputIterator copy(InputIterator first, InputIterator last, OutputIterator result)
{
    return __copy(first, last, result);
}

template <class BidirectionalIterator1, class BidirectionalIterator2>
inline BidirectionalIterator2 __copy_backward(BidirectionalIterator1 first, BidirectionalIterator1 last,
                                              BidirectionalIterator2 result)
{
    while (first < last)
        *--result = *--last;
    return result;
}

template <class BidirectionalIterator1, class BidirectionalIterator2>
inline BidirectionalIterator2 copy_backward(BidirectionalIterator1 first, BidirectionalIterator1 last,
                                            BidirectionalIterator2 result)
{
    return __copy_backward(first, last, result);
}

/* (C++98's fill_n returns nothing: the turret's 0x3AC200 sets no v0) */
template <class OutputIterator, class Size, class T>
inline void __fill_n(OutputIterator first, Size n, const T &value)
{
    if (n)
        do {
            *first = value;
            ++first;
        } while (--n);
}

template <class OutputIterator, class Size, class T>
inline void fill_n(OutputIterator first, Size n, const T &value)
{
    __fill_n(first, n, value);
}

